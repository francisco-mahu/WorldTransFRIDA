					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Electricity 4" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy FUEL 6" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Electricity 5" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="All Energy Output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity+Energy_output_liquid+Energy_output_gas+Energy_output_solid</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Population" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp</units>
			</aux>
			<aux name="per person energy output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>All_Energy_Output/Population</eqn>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="Electricity\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Solid fuel\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_solid/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Liquid fuel\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_liquid/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gas fuel\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_gas/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Solar Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Wind Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Hydropower Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Nuclear Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="bio fuel secondary\nenergy output for fuel" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="bio fuel secondary\nenergy output for electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Bio fuel secondary energy output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>bio_fuel_secondary_energy_output_for_electricity+bio_fuel_secondary_energy_output_for_fuel</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output electricity" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Renewable_energy_output+Nuclear_Energy_Output+Secondary_Fossil_Energy_Output_1+Secondary_Fossil_Energy_Output_9+Secondary_Fossil_Energy_Output_12</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output solid" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_13</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output liquid" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_10+bio_fuel_secondary_energy_output_for_fuel</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output gas" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_11</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Renewable energy output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Energy_Output+Wind_Energy_Output+bio_fuel_secondary_energy_output_for_electricity+Hydropower_Energy_Output</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Coal fuel Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Secondary_Energy_output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Oil fuel Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Secondary_Energy_output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gas fuel Output Share 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Secondary_Energy_output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Solar Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Energy_Output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Wind Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_Energy_Output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Bio fuel Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Bio_fuel_secondary_energy_output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Hydropower Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Hydropower_Energy_Output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Nuclear Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Nuclear_Energy_Output/All_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Solar and Wind Output Share" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Output_Share+Wind_Output_Share</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Primary Fossil Energy FUEL" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Solar\nEnergy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>gW</units>
			</aux>
			<aux name="Wind\nEnergy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>gW</units>
			</aux>
			<stock name="Hydropower Energy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>GW</units>
			</stock>
			<aux name="Total Renewable Energy Capacity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Energy_Capacity+Wind_Energy_Capacity+Hydropower_Energy_Capacity</eqn>
				<units>GW</units>
			</aux>
			<aux name="Coal conversion efficiency of\nfossil fuels to\nsecondary fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Secondary_Energy_output/(Coal_Primary_Fossil_Fuel_Energy*UNIT_zJ_to_TWh_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Liquid conversion efficiency of\nfossil fuels to\nsecondary fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Secondary_Energy_output/(Oil_Primary_Fossil_Fuel_Energy*UNIT_zJ_to_TWh_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gas conversion efficiency of\nfossil fuels to\nsecondary fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Secondary_Energy_output/(Gas_Primary_Fossil_Fuel_Energy*UNIT_zJ_to_TWh_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil Energy Output Share, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_1/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil Energy Output\nShare, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_9/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil Energy Output\nShare, gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_12/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Solar energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Wind energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Bio Energy share in electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>bio_fuel_secondary_energy_output_for_electricity/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Nuclear Energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Nuclear_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Hydropower Energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Hydropower_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="bio fuel primary energy for electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="bio fuel primary energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>bio_fuel_primary_energy_for_electricity_1+bio_fuel_primary_energy_for_electricity</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="bio fuel primary energy for electricity 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="bio fuel production 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mt of fuel/year</units>
			</aux>
			<aux name="bio fuel production 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mt of fuel/year</units>
			</aux>
			<aux name="bio fuel production">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>bio_fuel_production_1+bio_fuel_production_2</eqn>
				<units>Mt of fuel/year</units>
			</aux>
