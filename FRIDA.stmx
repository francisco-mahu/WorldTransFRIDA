	<model name="Liquid_fuel_investments">
		<variables>
			<aux name="cost of extra energy output through fuel extraction per unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="Oil Gross\nInvestments in Fossil\nFuel Extraction Capital for Direct Use" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source_for_Liquid_fuels[Run,Oil_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nBiofuel Capacity for Direct Use" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source_for_Liquid_fuels[Run,Bio]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 7" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\noil extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nbio fuel energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\noil extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\nbio fuel energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid\nand Subsidies Received in Fossil\nFuel Extraction Capital for Direct Use" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use[Run] +
tax_revenue_on_investments_in_oil_extraction[Run] -
expenditure_on_subsidies_for_investments_in_oil_extraction[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Biofuel Investments Including\nTaxes Paid and\nSubsidies Received for Direct Use" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity_for_Direct_Use[Run] +
tax_revenue_on_investments_in_bio_fuel_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_bio_fuel_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive energy\ninvestments proportional factor 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-50</eqn>
				<range min="-5000" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Energy Investment Allocated\nto Capacity Construction\nfor Liquid fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(Baseline_of_investments_for_Liquid_fuel*adaptive_change_in_investments_1, 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-10</eqn>
				<range min="-70" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch 1" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME &gt; STARTTIME+ time_to_perceive_energy_supply_missmatch_1 THEN
(Relative_Energy_Supply_Mismatch_with_Buffer_1 - HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer_1, TIME-time_to_perceive_energy_supply_missmatch_1))/time_to_perceive_energy_supply_missmatch_1
ELSE
0</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adaptive change\nin investments 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor_1*
Relative_Energy_Supply_Mismatch_with_Buffer_1 +

adaptive_energy_investments_integrating_factor_1 * Cumulative_Relative_Energy_Supply_Missmatch_1 +

adaptive_energy_investments_differntiating_factor_1 * Differentiating_Relative_Energy_Supply_Missmatch_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment by source for Liquid fuels" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>ALLOCATE(Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel[Run], EnergySourceLiquid, desired_investment_by_source_1[Run,*],  priority_by_source_1[Run, *], priority_spread_1[Run], shape_1)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="desired investment\nby source 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel[Run]
-
(IF ((EnergySourceLiquid = EnergySourceLiquid.Oil_fuel_extraction) AND TIME &gt; Moratorium_on_fossil_energy_year ) 
THEN
Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<stock name="cumulative squared relative\nenergy supply missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch_1</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch 1" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch_1</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch_1</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="Acc Cum Rel En Sup Missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer_1/time_to_perceive_energy_supply_missmatch_1</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer_1^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="initial relative supply missmatch 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<range min="-15" max="15"/>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer 1" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 0 THEN
Relative_Energy_Supply_Missmatch_1-Relative_Energy_Supply_Mismatch_Buffer_1
ELSE
Converter_1-Relative_Energy_Supply_Mismatch_Buffer_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer 1">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="average marginal\nnet cost of energy without historical cost adjustment 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
cost_of_extra_energy_output_through_fuel_extraction_per_unit_2* Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7 * Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity_for_Direct_Use
)
/Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="time to perceive energy supply missmatch 1">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="perceived energy supply\nmargins 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins_LIQUID, cost_perception_time_1, initial_perceived_marginal_energy_supply_cost_1)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost perception time 1">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="effect of margins on\ninvestment 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1+(EXP(relative_margins_1-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0897030727641846</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="relative margins 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(perceived_energy_supply_margins_1/initial_perceived_marginal_energy_supply_cost_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0104350216586014</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="LIQUID average marginal\nnet cost of energy with\nhistorical cost adjustment" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>( adjusted_cost_1[Run,Oil_fuel_extraction]* Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use
+ 
adjusted_cost_1[Run,Bio]*Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity_for_Direct_Use
)
/Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="priority spread 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.59523153782901</eqn>
				<range min="0" max="50"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape 1">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="adjusted cost 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>MAX(1e-12, cost_to_build_per_unit_1[Run,EnergySourceLiquid]*Insuitability_factors_for_Liquid_fuel_for_direct_use[Run,EnergySourceLiquid])</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost to build\nper unit 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy_2 = 0 THEN
(IF EnergySourceLiquid = EnergySourceLiquid.Oil_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_2[Run]
ELSE IF EnergySourceLiquid = EnergySourceLiquid.Bio THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7[Run]
ELSE 
1e12)
ELSE
cost_to_build_per_unit_2</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority by source 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost_1)</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="Insuitability factors\nfor Liquid fuel for direct use" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<element subscript="1, Oil_fuel_extraction">
					<eqn>1</eqn>
				</element>
				<element subscript="1, Bio">
					<eqn>1</eqn>
				</element>
				<range min="0.05" max="4"/>
				<units>dmnl</units>
			</aux>
			<aux name="pct of history 1">
				<eqn>(TIME-STARTTIME)/(2020-STARTTIME)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment smoothing time 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.428528840218145</eqn>
				<range min="0.25" max="0.75"/>
				<units>years</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="input">
				<eqn>2150</eqn>
				<units>Year</units>
			</aux>
			<aux name="average energy margins LIQUID">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Baseline of investments\nfor Liquid fuel" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>25722800000{ + RAMP(2.5e10)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>dmnl</units>
			</aux>
			<aux name="Switch to couple investments supply and demand in new energy" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="cost of extra energy output through fuel extraction per unit 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 8" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost to build\nper unit 2">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>IF EnergySourceLiquid = EnergySourceLiquid.Oil_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_3[Run]
ELSE IF EnergySourceLiquid = EnergySourceLiquid.Bio THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8[Run]
ELSE 
1e12</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Switch to couple investments supply and demand in new energy 2" access="input">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Liquid fuel Gross\nInvestments in Fossil\nFuel Extraction Capital for Direct Use" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity_for_Direct_Use + Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use</eqn>
				<units>c$/Year</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<isee:loop_indicator color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<numeric_display color="white" background="white" font_size="12pt" border_width="thin" border_style="solid" isee:transparent="false" isee:show_divider="true" isee:show_bounding_box="true" label_side="left"/>
				<graph color="black" background="white" font_size="12pt" axis_color="#666666" grid_color="#C8C8C8" isee:graph_area_color="white" legend_position="bottom" isee:transparent="false" isee:hide_border="false" axis_title_font_style="normal" axis_title_font_weight="normal" axis_title_text_decoration="none" axis_title_text_align="center" axis_title_vertical_text_align="center" axis_title_font_color="black" axis_title_font_family="Arial" axis_title_font_size="12pt" axis_title_text_padding="2" axis_title_text_border_color="black" axis_title_text_border_width="thin" axis_title_text_border_style="none" axis_label_font_style="normal" axis_label_font_weight="normal" axis_label_text_decoration="none" axis_label_text_align="center" axis_label_vertical_text_align="center" axis_label_font_color="black" axis_label_font_family="Arial" axis_label_font_size="9pt" axis_label_text_padding="2" axis_label_text_border_color="black" axis_label_text_border_width="thin" axis_label_text_border_style="none">
					<isee:series_styles>
						<isee:series_style color="blue" thickness="1"/>
						<isee:series_style color="red" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="fuchsia" thickness="1" pen_style="dotted"/>
						<isee:series_style color="#008F44" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF7F00" thickness="1"/>
						<isee:series_style color="#7F00FF" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="#0CA0FF" thickness="1" pen_style="dotted"/>
						<isee:series_style color="lime" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF007F" thickness="1"/>
						<isee:series_style color="aqua" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="#F586FF" thickness="1" pen_style="dotted"/>
						<isee:series_style color="black" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#C8C8C8" thickness="1"/>
					</isee:series_styles>
				</graph>
				<table color="black" background="#E0E0E0" text_align="right" font_size="12pt" orientation="vertical" wrap_text="false" isee:auto_fit="true" isee:use_alternate_row_colors="false" isee:unlimited_table_length="false" blank_column_width="80" column_width="160" interval="1" report_balances="beginning" report_flows="instantaneous" header_font_style="normal" header_font_weight="normal" header_text_decoration="none" header_text_align="center" header_vertical_text_align="center" header_font_color="black" header_font_family="Arial" header_font_size="12pt" header_text_padding="2" header_text_border_color="black" header_text_border_width="thin" header_text_border_style="none"/>
				<button color="black" background="#E0E0E0" font_size="12pt" border_width="thin" border_style="solid" transparent="false" corner_radius="0" isee:flat="false" icon_side="top" isee:highlight_on_hover="false" isee:highlight_color="#959595"/>
				<isee:annotation color="black" background="#E0E0E0" font_size="12pt" border_width="thin" border_style="solid" transparent="false" corner_radius="0" isee:flat="false" icon_side="top" isee:highlight_on_hover="false" isee:highlight_color="#959595" popup_corner_radius="0" popup_background_color="#FFFECF"/>
				<slider color="#0075FF" background="#E0E0E0" font_size="12pt" num_ticks="3" label_side="top" wrap_title="true" vertical="false" isee:fancy_appearance="false" isee:show_hover_tip="when_deciding" input_expands="true" input_width="100"/>
				<isee:stacked_container color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt" padding="6 8" border_color="#999999" border_width="thin" border_style="solid" item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				<isee:dual_slider color="#66CC66" background="silver" font_size="12pt" num_ticks="3" label_side="top" wrap_title="true" isee:show_hover_tip="when_deciding" input_expands="true" input_width="100"/>
				<isee:sim_speed_slider color="black" background="white"/>
				<isee:time_slider color="#E95F74" background="silver"/>
				<isee:pie_input color="black" background="white" font_size="12pt" legend_position="bottom" isee:transparent="false"/>
