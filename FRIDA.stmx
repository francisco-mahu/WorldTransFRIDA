				</style>
				<aux label_side="right" x="881.71" y="590.823" name="Solar Energy\nFull Load Hours"/>
				<stock x="555.71" y="431.253" width="51.4286" height="83.5714" name="Solar Energy\nInstalled Capacity"/>
				<flow x="458.14" y="479.553" name="Renewable Energy\nCapacity Construction">
					<pts>
