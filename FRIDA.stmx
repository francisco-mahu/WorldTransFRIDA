					<to>non_electricity_demand_allocator_per_energy_carrier</to>
				</connector>
				<aux x="1178.35" y="413.069" name="shape"/>
				<connector uid="35" angle="134.088">
					<from>shape</from>
					<to>non_electricity_demand_allocator_per_energy_carrier</to>
				</connector>
				<aux x="1103.92" y="447.03" name="priority by source"/>
				<connector uid="36" angle="90.4186">
					<from>priority_by_source</from>
					<to>non_electricity_demand_allocator_per_energy_carrier</to>
				</connector>
				<aux background="#00AA00" x="995.058" y="516.37" name="suitability cost adjustment"/>
				<aux x="1103.92" y="516.37" name="adjusted cost"/>
				<connector uid="37" angle="90">
					<from>adjusted_cost</from>
