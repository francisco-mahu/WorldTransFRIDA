				</connector>
				<aux background="#FFAAFF" x="1303.8" y="435.009" name="Share to fuel"/>
				<connector uid="203" angle="126.225">
					<from>Backstop_allocation</from>
					<to>Primary_Fossil_Energy_FUEL_for_Fuel</to>
				</connector>
