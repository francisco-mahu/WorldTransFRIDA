				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Other 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Other 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Switch to couple investments supply and demand in new energy" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Oil Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Direct_use_Oil_demand/Total_demand_for_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Direct use Oil\ndemand in zJ" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 1 THEN 
Direct_use_Oil_demand*UNIT_TWh_to_zJ_1
ELSE
0.03</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Direct use Oil demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Fossil_oil+Fossil_oil_1+Fossil_oil_2)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Direct use Biofuel demand in zJ" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 1 THEN 
Direct_use_Biofuel_demand*UNIT_TWh_to_zJ_1
ELSE 
0.0287</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Biofuel Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Direct_use_Biofuel_demand/Total_demand_for_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Direct use Biofuel demand" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Biofuel_1 + Biofuel + Biofuel_2</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Biofuel" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for biofuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Biofuel/total_energy_demand_for_Industry_and_Other_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Oil demand for\nIndustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_oil_1/Direct_use_Oil_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Oil demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_oil/Direct_use_Oil_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Oil demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_oil_2/Direct_use_Oil_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Direct use Other demand in zJ 1" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 1 THEN 
Direct_use_Other_demand*UNIT_TWh_to_zJ_1
ELSE
0.03</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Other Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Direct_use_Other_demand/Total_demand_for_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Direct use Other demand" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Other+Other_1+Other_2</eqn>
				<units>TWh/year</units>
			</aux>
		</variables>
