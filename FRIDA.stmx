	<model name="Stranded_Capital">
		<variables>
			<aux name="relative stranded capital">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>SMTH1((IF EnergySource = EnergySource.Coal_energy_conversion  THEN
stranded_capital[Run]/Fossil_Energy_Capital[Run]
ELSE IF EnergySource = EnergySource.Oil_energy_conversion  THEN
stranded_capital_2[Run]/Fossil_Energy_Capital_2[Run]
ELSE IF EnergySource = EnergySource.Gas_energy_conversion  THEN
stranded_capital_1[Run]/Fossil_Energy_Capital_1[Run]
ELSE
0)*time_to_consider_stranded_capital[Run], time_to_consider_stranded_capital[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="stranded capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="stranded capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="stranded capital 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<stock name="Fossil Energy Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<stock name="Fossil Energy Capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<stock name="Fossil Energy Capital 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<aux name="investment priority adjustment\nfrom stranded capital" access="output">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MAX(0, 1-relative_stranded_capital*sensitivity_of_cost_adjustment_to_relative_stranded_capital[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of cost\nadjustment to relative stranded capital">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>99.307746077223</eqn>
				<range min="50" max="150"/>
				<units>dmnl</units>
			</aux>
			<aux name="time to consider\nstranded capital">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>3</eqn>
				<range min="2" max="5"/>
				<units>year</units>
			</aux>
			<stock name="Fossil Energy Capital 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<aux name="sensitivity of cost\nadjustment to relative stranded capital 1">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>99.307746077223</eqn>
				<range min="50" max="150"/>
				<units>dmnl</units>
			</aux>
			<aux name="investment priority adjustment\nfrom stranded capital for solid fuel" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MAX(0, 1-relative_stranded_capital_1*sensitivity_of_cost_adjustment_to_relative_stranded_capital_1[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="stranded capital 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="time to consider\nstranded capital 1">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>3</eqn>
				<range min="2" max="5"/>
				<units>year</units>
			</aux>
			<aux name="relative stranded capital 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>SMTH1((IF EnergySource = EnergySource.Coal_energy_conversion  THEN
stranded_capital_3[Run]/Fossil_Energy_Capital_3[Run]
ELSE
0)*time_to_consider_stranded_capital_1[Run], time_to_consider_stranded_capital_1[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="relative stranded capital 2">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>SMTH1((IF EnergySource = EnergySource.Oil_energy_conversion  THEN
stranded_capital_4[Run]/Fossil_Energy_Capital_4[Run]
ELSE
0)*time_to_consider_stranded_capital_2[Run], time_to_consider_stranded_capital_2[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="stranded capital 4" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<stock name="Fossil Energy Capital 4" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<aux name="investment priority adjustment\nfrom stranded capital for liquid fuel" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MAX(0, 1-relative_stranded_capital_2*sensitivity_of_cost_adjustment_to_relative_stranded_capital_2[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of cost\nadjustment to relative\nstranded capital 2">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>99.307746077223</eqn>
				<range min="50" max="150"/>
				<units>dmnl</units>
			</aux>
			<aux name="time to consider\nstranded capital 2">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>3</eqn>
				<range min="2" max="5"/>
				<units>year</units>
			</aux>
			<aux name="relative stranded capital 3">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>SMTH1((IF EnergySource = EnergySource.Gas_energy_conversion  THEN
stranded_capital_5[Run]/Fossil_Energy_Capital_5[Run]
ELSE
0)*time_to_consider_stranded_capital_3[Run], time_to_consider_stranded_capital_3[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="stranded capital 5" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<stock name="Fossil Energy Capital 5" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<aux name="investment priority adjustment\nfrom stranded capital for gas fuel" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MAX(0, 1-relative_stranded_capital_3*sensitivity_of_cost_adjustment_to_relative_stranded_capital_3[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of cost\nadjustment to relative stranded capital 3">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>99.307746077223</eqn>
				<range min="50" max="150"/>
				<units>dmnl</units>
			</aux>
			<aux name="time to consider\nstranded capital 3">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>3</eqn>
				<range min="2" max="5"/>
				<units>year</units>
			</aux>
