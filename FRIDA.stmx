		</views>
	</model>
	<model name="Electricity_generation_fuel_demand">
		<variables>
			<aux name="Electricity from fuels">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Electricity_demand_1-Clean_electricity</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="cost to extract">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Coal THEN cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit[Run]
ELSE IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Liquid_fuel THEN cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit_1[Run]
ELSE IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Gas THEN cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit_2[Run]
ELSE NAN</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.18856855776034</eqn>
				<range min="0" max="100"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="electricity generation demand per fuel">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>ALLOCATE(Electricity_from_fuels[Run], ElectricityGenerationbyFuel, desired_electricity_generation_by_source[Run,*],  priority_by_source[Run, *], priority_spread[Run], shape)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="desired electricity generation by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>Electricity_from_fuels[Run]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="cost net of taxes of extra energy output\nthrough fuel\nextraction per unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost net of taxes of extra energy output\nthrough fuel\nextraction per unit 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="cost net of taxes of extra energy output\nthrough fuel\nextraction per unit 2" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="conversion efficiency\nof fossil fuels to\nsecondary fossil energy" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="conversion efficiency\nof fossil fuels to\nsecondary fossil energy 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="conversion efficiency\nof fossil fuels to\nsecondary fossil energy 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="conversion efficiency">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Coal THEN conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy[Run]
ELSE IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Liquid_fuel THEN conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_1[Run]
ELSE IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Gas THEN conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_2[Run]
ELSE NAN</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity generation\ndemand from coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>electricity_generation_demand_per_fuel[Run,Coal]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Electricity generation\ndemand from liquid fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>electricity_generation_demand_per_fuel[Run,Liquid_fuel]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Electricity generation\ndemand from gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>electricity_generation_demand_per_fuel[Run,Gas]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Coal demand for electricity generation" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Electricity_generation_demand_from_coal/conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy)/Converter_1</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Liquid fuel demand for\nelectricity generation" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Electricity_generation_demand_from_liquid_fuel/conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_1)/Converter_1</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Gas demand for electricity generation" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Electricity_generation_demand_from_gas/conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_2)/Converter_1</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Converter 1" access="input">
				<units>TWh/zJ</units>
			</aux>
			<aux name="priority by source Cost to extract">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>MIN(1e6,1/(cost_to_extract*conversion_efficiency))</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Cost net of taxes of Extra Energy Output\nthrough Capital per\nUnit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost net of taxes of Extra Energy Output\nthrough Capital per Unit 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost net of taxes of Extra Energy Output\nthrough Capital per Unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost to convert">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Coal THEN Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit[Run]
ELSE IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Liquid_fuel THEN Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit_1[Run]
ELSE IF ElectricityGenerationbyFuel = ElectricityGenerationbyFuel.Gas THEN Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit_2[Run]
ELSE NAN</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>MIN(1e6,(1/((cost_to_extract*Weight_of_cost_to_extract[Run]+cost_to_convert*Weight_of_cost_to_convert[Run]))*(conversion_efficiency*Weight_of_conversion_efficiency[Run])))</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="priority by source Cost to convert">
				<dimensions>
					<dim name="Run"/>
					<dim name="ElectricityGenerationbyFuel"/>
				</dimensions>
				<eqn>MIN(1e6,1/(cost_to_convert*conversion_efficiency))</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="Weight of conversion efficiency">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.742350609839594</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="Weight of cost to extract">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.02205840202416</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="Weight of cost to convert">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.21327634359684</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity demand 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="investment priority adjustment\nfrom stranded capital" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Secondary Fossil Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Clean electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
		</variables>
