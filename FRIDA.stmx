	<macro name="SIGN">
		<eqn>output</eqn>
		<parm>input</parm>
		<variables>
			<aux name="input" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="output" access="output">
				<eqn>IF input &lt; 0 THEN -1
ELSE 1</eqn>
				<units>dmnl</units>
