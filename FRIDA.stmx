				<connector uid="130" angle="167.297">
					<from>secondary_energy_output_from_liquid_fuels</from>
					<to>conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="612.86" y="410.625" name="effect of STA on river cooled thermal power\nenergy capacity efficiency"/>
				<connector uid="131" angle="256.787">
					<from>effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency</from>
