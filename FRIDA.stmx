			</aux>
			<aux name="Direct use coal Energy output" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_for_Fuel/UNIT_TWh_to_zJ</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Coal\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Direct_use_coal_Energy_output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Direct use gas Energy output" access="output" isee:autocreated="true">
				<dimensions>
