	<model>
		<variables>
			<module name="Energy" isee:label="" url="r../FRIDA_Modules/Energy.itmx">
				<format scale_by="auto"/>
				<connect to="Inflation.average_marginal_net_cost_of_energy_with_historical_cost_adjustment" from="Energy_demand.average_marginal_net_cost_of_energy_with_historical_cost_adjustment"/>
				<connect2 to="Inflation.average_marginal_net_cost_of_energy_with_historical_cost_adjustment" from="Energy_demand.average_marginal_net_cost_of_energy_with_historical_cost_adjustment"/>
				<connect to="Emissions.CDD" from="Energy_demand.CDD"/>
				<connect2 to="Emissions.CDD" from="Energy_demand.CDD"/>
				<connect to="Emissions.CDD_preindustrial" from="Energy_demand.CDD_preindustrial"/>
				<connect2 to="Emissions.CDD_preindustrial" from="Energy_demand.CDD_preindustrial"/>
				<connect to="Inflation.demand_for_energy" from="Energy_demand.demand_for_energy"/>
				<connect2 to="Inflation.demand_for_energy" from="Energy_demand.demand_for_energy"/>
				<connect to="Energy_demand.average_yearly_demand_per_capita" from="Transportation_Energy_Demand.average_yearly_demand_per_capita"/>
				<connect2 to="Energy_demand.average_yearly_demand_per_capita" from="Transportation_Energy_Demand.average_yearly_demand_per_capita"/>
				<connect to="Energy_demand.Converter_1" from='GDP."Real_GDP_in_2021c$"'/>
				<connect2 to="Energy_demand.Converter_1" from='GDP."Real_GDP_in_2021c$"'/>
				<connect to="Energy_demand.Converter_2" from="Demographics.UNIT_p_per_mp"/>
				<connect2 to="Energy_demand.Converter_2" from="Demographics.UNIT_p_per_mp"/>
				<connect to="Energy_demand.per_person_use_of_energy_policy" from="Behavioral_Choices.per_person_use_of_energy_policy"/>
				<connect2 to="Energy_demand.per_person_use_of_energy_policy" from="Behavioral_Choices.per_person_use_of_energy_policy"/>
				<connect to="Energy_demand.Policy_Start_Year" from="Behavioral_Choices.start_year"/>
				<connect2 to="Energy_demand.Policy_Start_Year" from="Behavioral_Choices.start_year"/>
