				</connector>
				<aux background="#FFAAFF" x="1186.33" y="490.566" name="Primary Fossil Energy\nFUEL for Fuel"/>
				<aux x="1439.62" y="816.13" name="energy carrier missmatch"/>
				<aux background="#55AA00" x="1450.45" y="645.112" name="priority spread"/>
				<connector uid="189" angle="180.666">
