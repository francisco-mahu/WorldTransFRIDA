			<aux name="Electricity demand for\nindustry and other 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Electricity demand for\nindustry and other" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="cost net of taxes of extra energy output\nthrough fuel\nextraction per unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost net of taxes of extra energy output\nthrough fuel\nextraction per unit 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost net of taxes of extra energy output\nthrough fuel\nextraction per unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="Primary Fossil Energy FUEL" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="bio fuel primary energy" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough bio fuel production\ncapacity per Unit net of subsidies, taxes and storage costs" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Share of electricity demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Electricity_demand_for_industry_and_other_3)/Total_Electricity_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of electricity demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Electricity_demand_for_industry_and_other)/Total_Electricity_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of electricity demand for\nIndustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Electricity_demand_for_industry_and_other_1/Total_Electricity_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="total energy demand for\nIndustry and Other" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for Coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_coal_in_transportation_1/total_energy_demand_for_Industry_and_Other</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for liquid fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Liquid_fuel_in_transportation_1/total_energy_demand_for_Industry_and_Other</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for Gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Gas_in_transportation_1/total_energy_demand_for_Industry_and_Other</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Electricity_demand_for_industry_and_other_1/total_energy_demand_for_Industry_and_Other</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="total energy demand for\nIndustry and Other 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for Coal" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_coal_in_transportation/total_energy_demand_for_Industry_and_Other_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for liquid fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Liquid_fuel_in_transportation/total_energy_demand_for_Industry_and_Other_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for Gas" access="output">
