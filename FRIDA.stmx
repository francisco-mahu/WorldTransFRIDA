				<connect2 to="Effect_of_energy_prices_on_Transportation_demand.relative_change_in_energy_prices_for_Fossil_Coal" from="Energy_margins.relative_change_in_energy_prices_for_Coal"/>
				<connect to="Transportation_Energy_Demand.relative_change_in_energy_prices_for_Fossil_Coal" from="Energy_margins.relative_change_in_energy_prices_for_Coal"/>
