	</model>
	<model name="Solid_fuel_investments" run="true">
		<variables>
			<aux name="adaptive energy\ninvestments proportional factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-8.97401845418313</eqn>
				<range min="-50" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="All Gross Energy Investments" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(Baseline_of_investments[Run]*Share_of_baseline_investments[Run]*adaptive_change_in_investments*effect_of_margins_on_investment, 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-0.0956296798297967</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-4.75826922729209</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{TREND(Relative_Energy_Supply_Mismatch_with_Buffer, 1, initial_differentiated_relative_energy_supply_missmatch)}
{IF TIME &lt; STARTTIME+1 THEN
initial_differentiated_relative_energy_supply_missmatch 
ELSE
(Relative_Energy_Supply_Mismatch_with_Buffer-HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-1))/1}
DERIVN(Relative_Energy_Supply_Mismatch_with_Buffer, 1)</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Share of Gross Energy Expenditure\ninvested in fuel\nextraction, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Gross Energy Expenditure\ninvested in fossil energy, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gross Investments in Solid Fossil\nEnergy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive change\nin investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor*
Relative_Energy_Supply_Mismatch_with_Buffer +

adaptive_energy_investments_integrating_factor * Cumulative_Relative_Energy_Supply_Missmatch +

adaptive_energy_investments_differntiating_factor * Differentiating_Relative_Energy_Supply_Missmatch</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment by\nsource">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceSolid"/>
				</dimensions>
				<eqn>ALLOCATE(All_Gross_Energy_Investments[Run], EnergySourceSolid, desired_investment_by_source[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>23.3819776272804</eqn>
				<range min="10" max="50"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="desired investment\nby source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceSolid"/>
				</dimensions>
				<eqn>All_Gross_Energy_Investments[Run]
-
(IF ((EnergySourceSolid = EnergySourceSolid.Coal_fuel_extraction
OR EnergySourceSolid = EnergySourceSolid.Coal_energy_conversion) AND TIME &gt; Moratorium_on_fossil_energy_year ) 
THEN
All_Gross_Energy_Investments[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceSolid"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost*investment_priority_adjustment_from_stranded_capital_1[Run,EnergySourceSolid])</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="cost of extra energy output through fuel extraction per unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Share of baseline investments" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.35250167363133</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<stock name="cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="Acc Cum Rel En Sup Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer/time_to_perceive_energy_supply_missmatch</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="initial relative supply missmatch" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-0.0396203812052465</eqn>
				<range min="-0.5" max="0.5"/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceSolid"/>
					<dim name="Historical_5yr_time_steps"/>
				</dimensions>
				<element subscript="1, Coal_fuel_extraction, 1">
					<eqn>0.694908985927571</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 2">
					<eqn>0.690414970847007</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 3">
					<eqn>0.694030382634051</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 4">
					<eqn>0.71119964824834</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 5">
					<eqn>0.668312285322118</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 6">
					<eqn>0.450450338062618</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 7">
					<eqn>0.588026528894504</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 8">
					<eqn>0.692715302983225</eqn>
				</element>
				<element subscript="1, Coal_fuel_extraction, 9">
					<eqn>0.722520859273339</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 1">
					<eqn>0.675834311266373</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 2">
					<eqn>0.707268642998297</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 3">
					<eqn>0.697117027130756</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 4">
					<eqn>0.721043488528306</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 5">
					<eqn>0.644286576705441</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 6">
					<eqn>0.443072877979886</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 7">
					<eqn>0.607874792676388</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 8">
					<eqn>0.503561849545431</eqn>
				</element>
				<element subscript="1, Coal_energy_conversion, 9">
					<eqn>0.478302581646121</eqn>
				</element>
				<range min="0.05" max="4"/>
				<units>dmnl</units>
			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceSolid"/>
				</dimensions>
				<eqn>MAX(1e-12, cost_to_build_per_unit[Run,EnergySourceSolid]*interpolated_historical_cost_adjustment[Run,EnergySourceSolid])</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="pct of history">
				<eqn>(TIME-STARTTIME)/(2020-STARTTIME)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="interpolated historical\ncost adjustment">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceSolid"/>
				</dimensions>
				<eqn>SMTH1(INTERPOLATE(historical_cost_adjustment[Run,EnergySourceSolid,*], pct_of_history), historical_cost_adjustment_smoothing_time[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment smoothing time" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.504435982916626</eqn>
				<range min="0.25" max="0.75"/>
				<units>years</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Missmatch-Relative_Energy_Supply_Mismatch_Buffer</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="Total Gross Investments in Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Solid_Fossil_Energy_Capital + Gross_Investments_in_Solid_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="input">
				<eqn>2050</eqn>
				<units>Year</units>
			</aux>
			<aux name="average marginal\nnet cost of energy without historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
cost_of_extra_energy_output_through_fuel_extraction_per_unit * Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital 
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit * Coal_Gross_Investments_in_Fossil_Energy_Capital
)
/Total_Gross_Investments_in_Energy</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="average marginal\nnet cost of energy with historical cost adjustment" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
adjusted_cost[Run,Coal_fuel_extraction] * Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital 
+ adjusted_cost[Run,Coal_energy_conversion] *Coal_Gross_Investments_in_Fossil_Energy_Capital
)
/Total_Gross_Investments_in_Energy</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\ncoal extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\ncoal extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Net Investments in Fossil\nFuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital + expenditure_on_subsidies_for_investments_in_coal_extraction + tax_revenue_on_investments_in_coal_extraction</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\ncoal energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\ngas energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Net Investments in Energy Conversion Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Energy_Capital + expenditure_on_subsidies_for_investments_in_coal_energy_conversion + tax_revenue_on_investments_in_gas_energy_conversion</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="time to perceive energy supply missmatch">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="perceived energy supply\nmargins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins, cost_perception_time, initial_perceived_marginal_energy_supply_cost)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost perception time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="effect of margins on\ninvestment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_margins-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.15741036996649</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="average energy margins" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="relative margins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_energy_supply_margins/initial_perceived_marginal_energy_supply_cost</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.00553277041262771</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost to build\nper unit">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>IF EnergySource = EnergySource.Coal_fuel_extraction THEN 
cost_of_extra_energy_output_through_fuel_extraction_per_unit[Run]
ELSE IF EnergySource = EnergySource.Coal_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit[Run]
ELSE 
1e12</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Baseline of investments" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>857228000000{ + RAMP(2.5e10)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Solid Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fuel extraction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Solid_Fossil_Fuel_Extraction_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Solid_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment priority adjustment\nfrom stranded capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Coal Gross Investments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Coal_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Gross Investments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Coal_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
		</variables>
