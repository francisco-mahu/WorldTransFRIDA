				<text_box uid="1" x="431.874" y="1855.18" width="260" height="58">This is a PID controler
https://en.wikipedia.org/wiki/Proportional%E2%80%93integral%E2%80%93derivative_controller</text_box>
				<text_box uid="2" x="431.874" y="1812.98" width="260" height="29.6667">PID factors. Negative values dampen deviations, positive values amplify</text_box>
				<text_box uid="3" x="268.981" y="1743.43" width="131.667" height="15">Proportional control</text_box>
				<text_box uid="4" x="460.952" y="1750.36" width="145.928" height="16.875">differentiating control, smoothes </text_box>
				<text_box uid="5" x="731.161" y="1750.3" width="145.928" height="58.6666">integrating control, responds to continuing deviations</text_box>
				<aux x="1246.73" y="700.843" name="Share of Energy Gross Expenditure\ninvested in fuel extraction, oil"/>
