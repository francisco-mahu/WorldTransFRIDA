							<isee:series_style color="aqua" thickness="1"/>
							<isee:series_style color="#F586FF" thickness="1"/>
							<isee:series_style color="black" thickness="1"/>
							<isee:series_style color="#C8C8C8" thickness="1"/>
						</isee:series_styles>
					</graph>
					<table color="black" background="#E0E0E0" text_align="right" font_size="12pt" orientation="vertical" wrap_text="false" isee:auto_fit="true" isee:use_alternate_row_colors="false" isee:unlimited_table_length="false" blank_column_width="80" column_width="160" interval="1" report_balances="beginning" report_flows="instantaneous" header_font_style="normal" header_font_weight="normal" header_text_decoration="none" header_text_align="center" header_vertical_text_align="center" header_font_color="black" header_font_family="Arial" header_font_size="12pt" header_text_padding="2" header_text_border_color="black" header_text_border_width="thin" header_text_border_style="none"/>
				</style>
				<module x="178.333" y="135" name="Coal extraction investments"/>
				<module x="364.25" y="135" name="Liquid fuel investments"/>
				<module x="540.625" y="135" name="Gas extraction investments"/>
			</view>
		</views>
	</model>
	<model name="Coal_extraction_investments">
		<variables>
			<flow name="Acc Cum Rel En Sup Missmatch 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer/time_to_perceive_energy_supply_missmatch</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<stock name="Cumulative Relative Energy Supply Missmatch 2" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch_2</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch_2</inflow>
				<units>dmnl</units>
			</stock>
			<stock name="cumulative squared relative\nenergy supply missmatch 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch_2</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<aux name="adaptive energy\ninvestments\nintegrating factor 2" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-2</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply\nMismatch with Buffer" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 0 THEN
Relative_Energy_Supply_Missmatch_2-Relative_Energy_Supply_Mismatch_Buffer
ELSE
Relative_Energy_Supply_Missmatch-Relative_Energy_Supply_Mismatch_Buffer</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="cost perception time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="Relative Energy Supply\nMismatch Buffer">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="time to perceive energy\nsupply missmatch">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in Fossil\nFuel Extraction\nCapital for Direct use" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_Investment_Allocated_to_Capacity_Construction_for_Coal</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\ncoal extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Energy Investment Allocated\nto Capacity Construction\nfor Coal" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME &gt; Moratorium_on_fossil_energy_year THEN
0
ELSE
Baseline_of_investments_for_Coal*adaptive_change_in_investments_2</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost 2" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0438021972913052</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="effect of margins on\ninvestment 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_margins_2-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment_2</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial relative supply missmatch 2" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<range min="-10" max="10"/>
				<units>dmnl</units>
			</aux>
			<aux name="Coal Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction\nCapital for Direct Use" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital_for_Direct_use[Run] +  tax_revenue_on_investments_in_coal_extraction[Run] - expenditure_on_subsidies_for_investments_in_coal_extraction[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive change\nin investments 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments_2)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments\ndifferntiating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Differentiating Relative\nEnergy Supply Missmatch 2" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME &gt; STARTTIME+time_to_perceive_energy_supply_missmatch THEN
(Relative_Energy_Supply_Mismatch_with_Buffer - HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-time_to_perceive_energy_supply_missmatch))/time_to_perceive_energy_supply_missmatch
ELSE
0</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="perceived energy supply\nmargins 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins_for_Fossil_Coal, cost_perception_time, initial_perceived_marginal_energy_supply_cost_2)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="adaptive energy\ninvestments\nproportional factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-5</eqn>
				<range min="-5000" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment 2" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.89957565066551</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor*
Relative_Energy_Supply_Mismatch_with_Buffer +

adaptive_energy_investments_integrating_factor_2 * Cumulative_Relative_Energy_Supply_Missmatch_2 +

adaptive_energy_investments_differntiating_factor * Differentiating_Relative_Energy_Supply_Missmatch_2</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\ncoal extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="relative margins 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(perceived_energy_supply_margins_2/initial_perceived_marginal_energy_supply_cost_2)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="output" throughput="true">
				<eqn>2150</eqn>
				<units>Year</units>
			</aux>
			<aux name="average energy margins for Fossil Coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Baseline of\ninvestments for Coal" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>25722800000{ + RAMP(2.5e10)</eqn>
				<range min="100000000" max="1000000000000"/>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy\nSupply Missmatch" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Switch to couple investments supply and demand in new energy" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
