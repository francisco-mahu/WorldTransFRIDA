			<aux name="Nuclear Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Total Energy Output" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
This is total energy production of both fossil and renewable</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity+Direct_use_gas_Energy_output+Direct_use_liquid_fuel_Energy_output+Direct_use_coal_Energy_output</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Renewable Energy\nOutput" access="input">
