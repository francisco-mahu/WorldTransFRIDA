	</model>
	<model name="Gas_extraction_investments">
		<variables>
			<aux name="cost of extra energy output through fuel extraction per unit 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Gas Gross\nInvestments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source_3</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\ngas extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\ngas extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital[Run] +
tax_revenue_on_investments_in_gas_extraction[Run] -
expenditure_on_subsidies_for_investments_in_gas_extraction[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive energy\ninvestments proportional factor 3" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-5.33974738324053</eqn>
				<range min="-50" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Energy Investment Allocated\nto Capacity Construction\nfor Gas" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(Baseline_of_investments_2*adaptive_change_in_investments_3, 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor 3" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-0.458071127461957</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor 3" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-13.2615434905938</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{TREND(Relative_Energy_Supply_Mismatch_with_Buffer, 1, initial_differentiated_relative_energy_supply_missmatch)}
{IF TIME &lt; STARTTIME+1 THEN
initial_differentiated_relative_energy_supply_missmatch 
ELSE
(Relative_Energy_Supply_Mismatch_with_Buffer-HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-1))/1}
DERIVN(Relative_Energy_Supply_Mismatch_with_Buffer_3, 1)</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adaptive change\nin investments 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments_3)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor_3*
Relative_Energy_Supply_Mismatch_with_Buffer_3 +

adaptive_energy_investments_integrating_factor_3 * Cumulative_Relative_Energy_Supply_Missmatch_3 +

adaptive_energy_investments_differntiating_factor_3 * Differentiating_Relative_Energy_Supply_Missmatch_3</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment by\nsource 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>desired_investment_by_source_3</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="desired investment\nby source 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_Investment_Allocated_to_Capacity_Construction_for_Gas[Run]
-
(IF TIME &gt; Moratorium_on_fossil_energy_year 
THEN
Energy_Investment_Allocated_to_Capacity_Construction_for_Gas[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<stock name="cumulative squared relative\nenergy supply missmatch 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch_3</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch_3</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch_3</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="Acc Cum Rel En Sup Missmatch 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer_3/time_to_perceive_energy_supply_missmatch_3</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer_3^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="initial relative supply missmatch 3" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.100407930371524</eqn>
				<range min="-0.5" max="0.5"/>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Missmatch_3-Relative_Energy_Supply_Mismatch_Buffer_3</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer 3">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="GAS average marginal\nnet cost of energy without\nhistorical cost adjustment" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>( Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital*cost_of_extra_energy_output_through_fuel_extraction_per_unit_1
)
/Energy_Investment_Allocated_to_Capacity_Construction_for_Gas</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="time to perceive energy supply missmatch 3">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="perceived energy supply\nmargins 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins_3, cost_perception_time_3, initial_perceived_marginal_energy_supply_cost_3)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost perception time 3">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="effect of margins on\ninvestment 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_margins_3-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment_3</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment 3" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.253977191128292</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="average energy margins 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="relative margins 3">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(perceived_energy_supply_margins_3/initial_perceived_marginal_energy_supply_cost_3)*Switch_for_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost 3" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0402233437915967</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Baseline of investments 2">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>110794083664.15</eqn>
				<range min="10000000000" max="200000000000"/>
				<units>c$/Year</units>
			</aux>
			<aux name="Switch for energy prices" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="input">
				<eqn>2150</eqn>
				<units>Year</units>
			</aux>
		</variables>
