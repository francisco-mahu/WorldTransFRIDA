	<model name="Energy_demand_1" run="true">
		<variables>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>bc$/year</units>
			</aux>
			<aux name="per person energy demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF(switch_energy_demand_policy= 0 OR TIME &lt; Policy_Start_Year) THEN
Total_demand_for_energy/Population
ELSE
per_person_use_of_energy_policy</eqn>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="Total demand for energy" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
For Calibration&gt;
This is energy demand, so consumption data would be closest. However, real consumption data can never show a demand greater than supply.
https://ourworldindata.org/grapher/fossil-fuel-primary-energy?tab=chart&amp;country=~OWID_WRL</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Direct_use_Gas_demand+Direct_use_Liquid_fuel_demand+Direct_use_Coal_demand)+Total_Electricity_demand+Direct_use_Other_demand</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="per person use of energy policy" access="input">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2100"/>
					<yscale min="5.5" max="8.5"/>
					<ypts>7.4,7.4,7.4,7.4,7.4,7.4,7.4,7.4,7.4</ypts>
				</gf>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="Policy Start Year" access="input">
				<eqn>2024</eqn>
				<units>Year</units>
			</aux>
			<aux name="switch energy demand policy" access="input">
				<eqn>0</eqn>
				<format precision="1" scale_by="auto"/>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Direct use Coal demand in zJ" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 1 THEN 
Direct_use_Coal_demand*UNIT_TWh_to_zJ_1
ELSE 
0.0287</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Direct use Gas demand in zJ" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 1 THEN 
Direct_use_Gas_demand*UNIT_TWh_to_zJ_1
ELSE
0.03</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Coal Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Direct_use_Coal_demand/Total_demand_for_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Liquid fuel Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Direct_use_Liquid_fuel_demand/Total_demand_for_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gas Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Direct_use_Gas_demand/Total_demand_for_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Total_Electricity_demand/Total_demand_for_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Direct use Liquid\nfuel demand in zJ" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 1 THEN 
Direct_use_Liquid_fuel_demand*UNIT_TWh_to_zJ_1
ELSE
0.03</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Population" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp</units>
			</aux>
			<aux name="UNIT TWh to zJ 1" access="input">
				<eqn>0.00000359999999971</eqn>
				<units>zJ/TWh</units>
			</aux>
			<aux name="cost to build\nper unit" access="output">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>IF NonEleEnergyCarriers = NonEleEnergyCarriers.Coal THEN 
cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit[Run]
ELSE IF NonEleEnergyCarriers = NonEleEnergyCarriers.Oil THEN Liquid_fuel_Cost_of_Extra_Energy_Output_through_Capital_per_Unit[Run]
ELSE IF NonEleEnergyCarriers = NonEleEnergyCarriers.Gas THEN 
cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit_1[Run]
ELSE 1</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Liquid fuel Cost of Extra Energy Output\nthrough Capital per Unit">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit_2*Primary_Fossil_Energy_FUEL+bio_fuel_primary_energy*&quot;Cost_of_Extra_Energy_Output_through_bio_fuel_production_capacity_per_Unit_net_of_subsidies,_taxes_and_storage_costs&quot;)/(bio_fuel_primary_energy+Primary_Fossil_Energy_FUEL)</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Fossil coal in transportation" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Liquid fuel in transportation" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Fossil Gas in transportation" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Direct use Coal demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Fossil_coal_in_transportation+Fossil_coal_in_transportation_1+Fossil_coal_in_transportation_2)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Direct use Liquid fuel demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Liquid_fuel_in_transportation+Liquid_fuel_in_transportation_1+Liquid_fuel_in_transportation_2)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Direct use Gas demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Gas_in_transportation+Fossil_Gas_in_transportation_1+Fossil_Gas_in_transportation_2</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Share of Coal demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_coal_in_transportation/Direct_use_Coal_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Gas demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Gas_in_transportation/Direct_use_Gas_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Liquid fuel demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Liquid_fuel_in_transportation/Direct_use_Liquid_fuel_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil coal in transportation 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Liquid fuel in transportation 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Fossil Gas in transportation 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Share of Coal demand for\nIndustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_coal_in_transportation_1/Direct_use_Coal_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Gas demand for\nIndustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Gas_in_transportation_1/Direct_use_Gas_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Liquid fuel demand for\nIndustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Liquid_fuel_in_transportation_1/Direct_use_Liquid_fuel_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil coal in transportation 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Liquid fuel in transportation 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Fossil Gas in transportation 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>TWh/year</units>
			</aux>
			<aux name="Share of Coal demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_coal_in_transportation_2/Direct_use_Coal_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Gas demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Gas_in_transportation_2/Direct_use_Gas_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Liquid fuel demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Liquid_fuel_in_transportation_2/Direct_use_Liquid_fuel_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative global\nreal GDP in 2021" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Converter_1/INIT(Converter_1)</eqn>
				<units>dmnl</units>
			</aux>
			<module name="Industry and Other\nenergy demand 1" isee:label="">
				<format scale_by="auto"/>
