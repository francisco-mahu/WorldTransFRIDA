				<aux x="340.455" y="462.216" name="share of thermal powerplants\nthat are cooled by rivers"/>
				<aux x="494" y="462.216" name="share of thermal power cooled by rivers in secondary fossil energy"/>
				<connector uid="116" angle="0">
