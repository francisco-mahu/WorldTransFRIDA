				<connect to="Global_energy_investments.Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_2" from="Electricity_investments.Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital"/>
				<connect2 to="Global_energy_investments.Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_2" from="Electricity_investments.Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital"/>
				<connect to='Global_energy_investments."UNIT_Bc$_to_c$"' from='Energy_Units_1."UNIT_Bc$_to_c$"'/>
				<connect2 to='Global_energy_investments."UNIT_Bc$_to_c$"' from='Energy_Units_1."UNIT_Bc$_to_c$"'/>
			</module>
