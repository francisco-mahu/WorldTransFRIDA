	<model name="Electricity_supply_vs_demand" run="true">
		<variables>
			<aux name="Energy Balance" access="output">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity_1/Electricity_demand</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Cumulative Deviations of Energy Balance from 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Deviations_from_one_in_Energy_Balance</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="Deviations from one in Energy Balance">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((1-Energy_Balance)^2)/DT</eqn>
				<non_negative/>
				<units>dmnl/year</units>
			</flow>
			<stock name="Cumulative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Energy_Supply_Missmatch</inflow>
				<units>TWh</units>
			</stock>
			<flow name="Energy Supply\nMissmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity_1-Electricity_demand</eqn>
				<units>TWh/Year</units>
			</flow>
			<aux name="Relative Energy\nSupply Missmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_Supply_Missmatch/Energy_output_electricity_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity demand" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output electricity 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
