	<model name="Industry_and_Other_energy_demand_1">
		<variables>
			<aux name="Desired Electrification SHARE for\nIndustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_electrification_share_for_fordustry_and_Other*normal_electrification_share_for_fordustry_and_Other*effect_of_energy_prices_on_electrification_share_for_Industry_and_Other</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal electrification\nshare for fordustry\nand Other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.116658456947306</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of energy prices on electrification\nshare for Industry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_change_in_energy_prices_in_electricity_1-1)-1)*sensitivity_of_effect_of_energy_prices_on_electrification_share_for_Industry_and_Other*Switch_to_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect\nof energy prices on electrification\nshare for Industry and Other" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.150615808840725</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity demand for\nindustry and other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Electrification_SHARE_for_Industry_and_Other[Run]*total_energy_demand_for_Industry_and_Other[Run]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Non Electricity demand for\nindustry and other" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-Desired_Electrification_SHARE_for_Industry_and_Other)*total_energy_demand_for_Industry_and_Other</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="effect of GDP on\nenergy demand for\nIndustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_energy_demand_for_Industry_and_Other_alpha*(relative_global_real_GDP_in_2022)^(effect_of_GDP_on_energy_demand_for_Industry_and_Other_beta)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal per sector\nenergy demand\nfor Industry and Other" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>27060.7715754942</eqn>
				<range min="5000" max="50000"/>
				<units>TWh/year</units>
			</aux>
			<aux name="effect of GDP on energy\ndemand for Industry and Other alpha" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.06049066089623</eqn>
				<range min="0" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="total energy demand for\nIndustry and Other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>normal_per_sector_energy_demand_for_Industry_and_Other*effect_of_GDP_on_energy_demand_for_Industry_and_Other*effect_of_energy_prices_on_Industry_and_Other_demand</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="effect of GDP on energy\ndemand for Industry and Other beta" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.65491307934634</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification share for\nfordustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_electrification_share_for_fordustry_and_Other_alpha*(relative_global_real_GDP_in_2022)^(effect_of_GDP_on_electrification_share_for_fordustry_and_Other_beta)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification\nshare for fordustry and Other alpha" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.15879750638763</eqn>
				<range min="0" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification\nshare for fordustry and Other beta" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.324355949719614</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="relative global real GDP in 2022" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>dmnl</units>
			</aux>
			<aux name="relative change\nin energy prices\nin electricity 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Switch to energy prices" access="output" throughput="true" isee:autocreated="true">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="non electricity demand allocator per energy carrier">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>ALLOCATE(Non_Electricity_demand_for_industry_and_other[Run], NonEleEnergyCarriers, desired_energy_demand_by_carrier[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>157.551162823728</eqn>
				<range min="5" max="1000"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost[Run,NonEleEnergyCarriers])</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="suitability cost adjustment" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<element subscript="1, Coal">
					<eqn>6.39862390920166</eqn>
				</element>
				<element subscript="1, Oil">
					<eqn>18.3717645831309</eqn>
				</element>
				<element subscript="1, Gas">
					<eqn>5.08882673251841</eqn>
				</element>
				<element subscript="1, Other">
					<eqn>2.69424929044762</eqn>
				</element>
				<range min="1e-12" max="400"/>
				<units>dmnl</units>
			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>cost_to_build_per_unit*(1/suitability_cost_adjustment)</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Coal" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Coal]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Gas" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Gas]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="cost to build per unit" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="desired energy demand\nby carrier">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>Non_Electricity_demand_for_industry_and_other[Run]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Oil" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Oil]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Biofuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Other*share_of_biofuel_in_other</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="effect\nof energy prices on\nIndustry and Other demand" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Other]</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Liquid fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil+Biofuel</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="share of biofuel\nin other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.6</eqn>
				<units>dmnl</units>
			</aux>
		</variables>
