				</connector>
				<connector uid="30" angle="26.2463">
					<from>Investments_in_Fossil_Fuel_Extraction_Capital</from>
					<to>Investment_in_Fossil_Fuel_Extraction_Capital</to>
				</connector>
				<connector uid="31" angle="214.454">
					<from>Depreciation_rate_of_Fuel_Extraction_Capital</from>
					<to>Desired_Depreciation_of_Fuel_Extraction_Capital</to>
				</connector>
				<connector uid="32" angle="315.194">
					<from>Fossil_Fuel_Extraction_Capital</from>
					<to>Fossil_Fuel_Extraction_Carbon</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="790.493" y="68.3333" name="damage rate of energy\ncapital from STA 1"/>
				<connector uid="33" angle="208.753">
					<from>damage_rate_of_energy_capital_from_STA_1</from>
					<to>desired_Fossil_Fuel_Extraction_Capital_Damaged_due_to_STA</to>
				</connector>
				<aux x="762.16" y="136.143" name="drain time 1"/>
				<connector uid="34" angle="181.35">
					<from>drain_time_1</from>
					<to>Fossil_Fuel_Extraction_Capital_Damaged_due_to_STA</to>
				</connector>
				<connector uid="35" angle="169.116">
					<from>drain_time_1</from>
					<to>Decomisioning_of_fossil_fuel_extraction_capital</to>
				</connector>
				<connector uid="36" angle="205.042">
					<from>drain_time_1</from>
					<to>Depreciation_of_Fuel_Extraction_Capital</to>
				</connector>
				<aux x="140" y="332.5" name="Oil Gross\nInvestments in Fossil\nFuel Extraction Capital"/>
				<connector uid="37" angle="346.293">
					<from>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</from>
					<to>Investment_in_Fossil_Fuel_Extraction_Capital</to>
				</connector>
				<aux background="#FFAA00" x="1280.88" y="386.233" name="Primary Fossil Energy\nFUEL for Electricity"/>
				<aux font_style="italic" font_weight="bold" x="770.08" y="488.857" name="Carbon Intensity"/>
				<connector uid="38" angle="198.59">
					<from>Carbon_Intensity</from>
					<to>Primary_Fossil_Energy_FUEL</to>
				</connector>
				<aux background="#FFAA00" x="1073" y="386.233" name="Primary Fossil Energy\nFUEL for Fuel"/>
				<aux x="1326.05" y="738.554" name="energy carrier missmatch"/>
				<aux background="#55AA00" x="1331.88" y="525.541" name="priority spread"/>
				<connector uid="39" angle="180.666">
					<from>priority_spread</from>
					<to>Primary_Fossil_Energy_FUEL_by_type</to>
				</connector>
				<aux x="1323.8" y="569.337" name="shape"/>
				<connector uid="40" angle="152.657">
					<from>shape</from>
					<to>Primary_Fossil_Energy_FUEL_by_type</to>
				</connector>
				<aux x="1320.8" y="613.929" name="priority by source"/>
				<connector uid="41" angle="134.913">
					<from>priority_by_source</from>
					<to>Primary_Fossil_Energy_FUEL_by_type</to>
				</connector>
				<connector uid="42" angle="92.4122">
					<from>energy_carrier_missmatch</from>
					<to>priority_by_source</to>
				</connector>
				<aux x="1370.13" y="929.667" name="time to perceive\nchanges in investment"/>
				<aux x="1175.66" y="527.357" name="Primary Fossil\nEnergy FUEL by type"/>
				<aux x="1255.38" y="810.227" name="Perceived Energy missmatch in fuel"/>
				<aux x="1404.67" y="816.714" name="Perceived Energy missmatch in electricity"/>
				<connector uid="43" angle="72.9968">
					<from>time_to_perceive_changes_in_investment</from>
					<to>Perceived_Energy_missmatch_in_electricity</to>
				</connector>
				<aux x="1061.43" y="647.358" name="desired investment\nby source 1"/>
				<connector uid="44" angle="5.67479">
					<from>desired_investment_by_source_1</from>
					<to>Primary_Fossil_Energy_FUEL_by_type</to>
				</connector>
				<connector uid="45" angle="133.853">
					<from>time_to_perceive_changes_in_investment</from>
					<to>Perceived_Energy_missmatch_in_fuel</to>
				</connector>
				<connector uid="46" angle="78.4465">
					<from>Perceived_Energy_missmatch_in_fuel</from>
					<to>energy_carrier_missmatch</to>
				</connector>
				<connector uid="47" angle="88.3153">
					<from>Perceived_Energy_missmatch_in_electricity</from>
					<to>energy_carrier_missmatch</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="1179.17" y="860.833" name="Energy Supply\nMissmatch 2"/>
				<connector uid="48" angle="12.3582">
					<from>Energy_Supply_Missmatch_2</from>
					<to>Perceived_Energy_missmatch_in_fuel</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="1479.17" y="864.965" name="Energy Supply\nMissmatch"/>
				<connector uid="49" angle="134.898">
					<from>Energy_Supply_Missmatch</from>
					<to>Perceived_Energy_missmatch_in_electricity</to>
				</connector>
				<aux background="#55AA00" x="1192.49" y="966.5" name="initial energy supply missmatch in fuel"/>
				<aux background="#55AA00" x="1501.5" y="984.5" name="initial energy supply\nmissmatch for electricity"/>
				<connector uid="50" angle="86.1374">
					<from>initial_energy_supply_missmatch_in_fuel</from>
					<to>Perceived_Energy_missmatch_in_fuel</to>
				</connector>
				<connector uid="51" angle="143.547">
					<from>initial_energy_supply_missmatch_for_electricity</from>
					<to>Perceived_Energy_missmatch_in_electricity</to>
				</connector>
				<connector uid="52" angle="151.034">
					<from>Primary_Fossil_Energy_FUEL_by_type</from>
					<to>Primary_Fossil_Energy_FUEL_for_Fuel</to>
				</connector>
				<connector uid="53" angle="36.8561">
					<from>Primary_Fossil_Energy_FUEL_by_type</from>
					<to>Primary_Fossil_Energy_FUEL_for_Electricity</to>
				</connector>
				<aux x="1174.49" y="446.286" name="Backstop allocation"/>
				<aux x="933.429" y="613.929" name="Primary Fossil Energy FUEL 90%"/>
				<connector uid="54" angle="214.816">
					<from>Backstop_allocation</from>
					<to>&quot;Primary_Fossil_Energy_FUEL_90%&quot;</to>
				</connector>
				<connector uid="55" angle="138.302">
					<from>Backstop_allocation</from>
					<to>Primary_Fossil_Energy_FUEL_for_Fuel</to>
				</connector>
				<connector uid="56" angle="53.037">
					<from>Backstop_allocation</from>
					<to>Primary_Fossil_Energy_FUEL_for_Electricity</to>
				</connector>
				<connector uid="57" angle="5.56326">
					<from>Primary_Fossil_Energy_FUEL</from>
					<to>Backstop_allocation</to>
				</connector>
				<connector uid="58" angle="19.6666">
					<from>&quot;Primary_Fossil_Energy_FUEL_90%&quot;</from>
					<to>Primary_Fossil_Energy_FUEL_by_type</to>
				</connector>
				<connector uid="59" angle="327.282">
					<from>Primary_Fossil_Energy_FUEL</from>
					<to>&quot;Primary_Fossil_Energy_FUEL_90%&quot;</to>
				</connector>
				<connector uid="60" angle="347.766">
					<from>&quot;Primary_Fossil_Energy_FUEL_90%&quot;</from>
					<to>desired_investment_by_source_1</to>
				</connector>
			</view>
		</views>
	</model>
	<model name="Extraction_of_solid_fuels">
		<variables>
			<stock name="Extracted Carbon in Fossil\nEnergy Resources">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>cumulative_extracted_fossil_fuels_in_1980</eqn>
				<inflow>Fossil_Fuel_Extraction_Carbon</inflow>
				<non_negative/>
				<units>GtC</units>
			</stock>
			<flow name="Fossil Fuel Extraction Carbon" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Fuel_Extraction_Capital*Fossil_Fuel_Extraction_Productivity</eqn>
				<non_negative/>
				<units>gtC/Year</units>
			</flow>
			<aux name="Primary Fossil Energy FUEL" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
This is extracted usable fuels in the current period.
Data for calibration would be total fossil energy production:
https://ourworldindata.org/grapher/fossil-fuel-production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(1e-10, Fossil_Fuel_Extraction_Carbon/Carbon_Intensity)</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Resource base">
				<doc>${External Parameter}
Proven reserves by 2020 (2024 Energy Institute Statistical Review of World Energy Data) plus Cumulative extracted fuel from 1850-2020 (Global Carbon Budget)

Carbon Intensity from EPA (https://www.epa.gov/energy/greenhouse-gas-equivalencies-calculator-calculations-and-references)
</doc>
				<eqn>796.0739956</eqn>
				<units>GtC</units>
			</aux>
			<aux name="Fossil Fuel Extraction\nProductivity" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>productivity_per_extractionknowledge*Fossil_Extraction_Accumulated_Knowledge
/
Marginal_Extraction_Costs</eqn>
				<units>GtC/c$/Years</units>
			</aux>
			<aux name="Initial extraction\ncosts">
				<doc>${Internal Calibration Parameter}
Initial extraction costs [c$ per GtC]
value from MIND Gams code, adjusted from tC to GtC

Adjusted value after resource base change</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>112986924437.916</eqn>
				<range min="10000000000" max="1000000000000"/>
				<units>c$/GtC</units>
			</aux>
			<aux name="Marginal Extraction Costs">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Initial_extraction_costs+
Slope_of_cost_curve*
(Extracted_Carbon_in_Fossil_Energy_Resources/Resource_base)^Exponent_of_cost_curve</eqn>
				<units>c$/GtC</units>
			</aux>
			<aux name="Slope of cost curve">
				<doc>${Internal Calibration Parameter}
Slope of cost curve [c$ per GtC],
value from MIND Gams code, adjusted from Gc$ to c$

Calibrated after resource base changes</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1120004233275.19</eqn>
				<range min="70000000000" max="7000000000000"/>
				<units>c$/GtC</units>
			</aux>
			<aux name="maximum increase of capital\ncoefficient in fossil\nresource sector">
				<doc>${Assumption}
value from MIND</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>256.08</eqn>
				<range min="200" max="300"/>
				<units>extractionknowledge</units>
			</aux>
			<flow name="Change in Fossil\nLearning by Doing Effect">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Fossil_Extraction_Accumulated_Knowledge
/
(
learning_time_in_resource_sector*
maximum_increase_of_capital_coefficient_in_fossil_resource_sector
) 
*
(
maximum_increase_of_capital_coefficient_in_fossil_resource_sector-Fossil_Extraction_Accumulated_Knowledge
)
*
(
(Fossil_Energy_Extraction/initialFossilEnergyExtraction)^learning_elasticity_of_the_resource_sector -1
)
}
Fossil_Extraction_Accumulated_Knowledge * 
(
(1/learning_time_in_resource_sector)/
maximum_increase_of_capital_coefficient_in_fossil_resource_sector
) 
*
(maximum_increase_of_capital_coefficient_in_fossil_resource_sector - Fossil_Extraction_Accumulated_Knowledge) 
*
(
(Fossil_Fuel_Extraction_Carbon/INIT(Fossil_Fuel_Extraction_Carbon))^learning_elasticity_of_the_resource_sector - 1
)</eqn>
				<units>extractionknowledge/Year</units>
			</flow>
			<aux name="learning time\nin resource sector">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>30.49493995</eqn>
				<range min="20" max="40"/>
				<units>Year</units>
			</aux>
			<aux name="cumulative extracted fossil fuels in 1980">
				<doc>${External Parameter}
Cumulative CO2 emissions in 1980 divided by 3.67
</doc>
				<eqn>97.22</eqn>
				<units>GtC</units>
			</aux>
			<aux name="learning elasticity of\nthe resource sector">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.4</eqn>
				<range min="0.2" max="0.6"/>
				<units>Dimensionless</units>
			</aux>
			<aux name="Depreciation rate of\nFuel Extraction Capital">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.05</eqn>
				<range min="0" max="0.1"/>
				<units>1/year</units>
			</aux>
			<aux name="Exponent of cost curve">
				<doc>${Assumption}
</doc>
				<eqn>4</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="initial fossil fuel\nextraction capital" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
value 0.05 * 100tc$ taken from gams code

MIND 2005 Paper lists 5 trillion USD for 1995
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1605647005806.59</eqn>
				<range min="1000000000" max="50000000000000"/>
				<units>c$</units>
			</aux>
			<aux name="initial fossil\nextraction knowledge">
				<doc>${Internal Calibration Parameter}
value from MIND</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>98.1885756675626</eqn>
				<range min="90" max="160"/>
				<units>extractionknowledge</units>
			</aux>
			<stock name="Fossil Extraction\nAccumulated Knowledge">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_fossil_extraction_knowledge</eqn>
				<inflow>Change_in_Fossil_Learning_by_Doing_Effect</inflow>
				<non_negative/>
				<units>extractionknowledge</units>
			</stock>
			<aux name="productivity per extractionknowledge">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.00154687602919208</eqn>
				<range min="0.0001" max="0.003"/>
				<units>1/extractionknowledge/Year</units>
			</aux>
			<aux name="Investments in Fossil\nFuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="rate of decommissioning fossil fuel extraction capital" access="input">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2100"/>
					<yscale min="0" max="100"/>
					<ypts>0,0,0,0,0,0,0,0,0</ypts>
				</gf>
				<units>1/year</units>
			</aux>
			<aux name="Policy Start Year" access="output" throughput="true">
				<eqn>2024</eqn>
				<units>Year</units>
			</aux>
			<flow name="Investment in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Fossil_Fuel_Extraction_Capital+Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</eqn>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<stock name="Fossil Fuel Extraction Capital" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_fossil_fuel_extraction_capital</eqn>
				<inflow>Investment_in_Fossil_Fuel_Extraction_Capital</inflow>
				<outflow>Depreciation_of_Fuel_Extraction_Capital</outflow>
				<outflow>Decomisioning_of_fossil_fuel_extraction_capital</outflow>
				<outflow>Fossil_Fuel_Extraction_Capital_Damaged_due_to_STA</outflow>
				<non_negative/>
				<units>c$</units>
			</stock>
			<flow name="Decomisioning of fossil\nfuel extraction capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Fossil_Fuel_Extraction_Capital/drain_time, desired_Decomisioning_of_fossil_fuel_extraction_capital)</eqn>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<flow name="Fossil Fuel Extraction\nCapital Damaged due to STA">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Fossil_Fuel_Extraction_Capital/drain_time, desired_Fossil_Fuel_Extraction_Capital_Damaged_due_to_STA)</eqn>
				<format precision="full"/>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<aux name="drain time" access="output">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="desired Decomisioning of fossil\nfuel extraction capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME&gt;Policy_Start_Year THEN
rate_of_decommissioning_fossil_fuel_extraction_capital*Fossil_Fuel_Extraction_Capital 
ELSE
0</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="desired Fossil Fuel Extraction\nCapital Damaged due to STA">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Fuel_Extraction_Capital*damage_rate_of_energy_capital_from_STA_1</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Desired Depreciation of Fuel\nExtraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Depreciation_rate_of_Fuel_Extraction_Capital*Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<flow name="Depreciation of Fuel\nExtraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Fossil_Fuel_Extraction_Capital/drain_time, Desired_Depreciation_of_Fuel_Extraction_Capital)</eqn>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<aux name="damage rate of energy\ncapital from STA 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Coal Gross Investments in Fossil\nFuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Electricity" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_by_type[Run,Electricity]+Backstop_allocation</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_by_type[Run,Fuel]+Backstop_allocation</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Carbon Intensity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>GtC/ZJ</units>
			</aux>
			<aux name="energy carrier missmatch">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>IF PrimaryFuelUse = PrimaryFuelUse.Fuel THEN Perceived_Energy_missmatch_in_fuel[1]
ELSE IF PrimaryFuelUse = PrimaryFuelUse.Electricity THEN Perceived_Energy_missmatch_in_electricity[1]
ELSE NAN</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>97467.9810900984</eqn>
				<range min="95000" max="110000"/>
				<units>TWh/year</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>MIN(1e6,energy_carrier_missmatch)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy Supply\nMissmatch" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Energy Supply\nMissmatch 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="initial energy supply missmatch in fuel" access="output" isee:autocreated="true">
				<eqn>0.151737696928457</eqn>
				<range min="0" max="1"/>
				<units>TWh/year</units>
			</aux>
			<aux name="time to perceive\nchanges in investment">
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="Primary Fossil\nEnergy FUEL by type">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>ALLOCATE(&quot;Primary_Fossil_Energy_FUEL_90%&quot;[Run], PrimaryFuelUse, desired_investment_by_source_1[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Perceived Energy missmatch in fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Energy_Supply_Missmatch, time_to_perceive_changes_in_investment, initial_energy_supply_missmatch_in_fuel)</eqn>
				<isee:delay_aux/>
				<units>TWh/year</units>
			</aux>
			<aux name="Perceived Energy missmatch in electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Energy_Supply_Missmatch_1, time_to_perceive_changes_in_investment, initial_energy_supply_missmatch_for_electricity)</eqn>
				<isee:delay_aux/>
				<units>TWh/year</units>
			</aux>
			<aux name="desired investment\nby source 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>&quot;Primary_Fossil_Energy_FUEL_90%&quot;[Run]</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="initial energy supply\nmissmatch for electricity" access="output" isee:autocreated="true">
				<eqn>0.890858484126793</eqn>
				<range min="0" max="1"/>
				<units>TWh/year</units>
			</aux>
			<aux name="Backstop allocation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL*0.05</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy FUEL 90%">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL-Backstop_allocation*2</eqn>
				<units>zJ/Year</units>
			</aux>
		</variables>
