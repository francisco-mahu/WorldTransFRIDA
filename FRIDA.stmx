				<connect to="Effect_of_energy_prices_on_Industry_and_Other_demand.relative_change_in_energy_prices_for_Fossil_Gas" from="Energy_margins.relative_change_in_energy_prices_for_Gas"/>
				<connect2 to="Effect_of_energy_prices_on_Industry_and_Other_demand.relative_change_in_energy_prices_for_Fossil_Gas" from="Energy_margins.relative_change_in_energy_prices_for_Gas"/>
				<connect to="Effect_of_energy_prices_on_Transportation_demand.relative_change_in_energy_prices_for_Fossil_Gas" from="Energy_margins.relative_change_in_energy_prices_for_Gas"/>
				<connect2 to="Effect_of_energy_prices_on_Transportation_demand.relative_change_in_energy_prices_for_Fossil_Gas" from="Energy_margins.relative_change_in_energy_prices_for_Gas"/>
				<connect to="Transportation_Energy_Demand.relative_change_in_energy_prices_for_Fossil_Gas" from="Energy_margins.relative_change_in_energy_prices_for_Gas"/>
				<connect2 to="Transportation_Energy_Demand.relative_change_in_energy_prices_for_Fossil_Gas" from="Energy_margins.relative_change_in_energy_prices_for_Gas"/>
