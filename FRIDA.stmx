	<model name="Renewable_energy_1" run="true">
		<variables>
			<aux name="Renewable Energy\nOutput" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
0.0000000036 is gwh2zj

Calibrate to energy provision from renewable sources</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_Energy_Output_1+
