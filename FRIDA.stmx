				<connect to="Coal_fossil_energy_conversion.UNIT_ktN2O_to_tCO2e" from="Climate_Units.UNIT_ktN2O_to_tCO2e"/>
				<connect2 to="Coal_fossil_energy_conversion.UNIT_ktN2O_to_tCO2e" from="Climate_Units.UNIT_ktN2O_to_tCO2e"/>
				<connect to="Coal_fossil_energy_conversion.UNIT_MtCH4_to_tCO2e" from="Climate_Units.UNIT_MtCH4_to_tCO2e"/>
				<connect2 to="Coal_fossil_energy_conversion.UNIT_MtCH4_to_tCO2e" from="Climate_Units.UNIT_MtCH4_to_tCO2e"/>
				<connect to="Coal_fossil_energy_conversion.UNIT_MtCO2_to_tCO2e" from="Climate_Units.UNIT_MtCO2_to_tCO2e"/>
				<connect2 to="Coal_fossil_energy_conversion.UNIT_MtCO2_to_tCO2e" from="Climate_Units.UNIT_MtCO2_to_tCO2e"/>
				<connect to="Coal_fossil_energy_conversion.zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
				<connect2 to="Coal_fossil_energy_conversion.zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
			</module>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
