					<stock color="blue" background="white" font_color="blue" font_size="11pt" label_side="top">
						<shape type="rectangle" width="45" height="35"/>
					</stock>
					<flow color="blue" background="white" font_color="blue" font_size="11pt" label_side="bottom">
						<shape type="circle" radius="18"/>
					</flow>
					<isee:placeholder color="#228B22" background="white" font_color="#228B22" font_size="11pt" label_side="bottom"/>
					<module color="blue" background="white" font_color="blue" font_size="11pt" label_side="top">
						<shape type="rectangle" width="67" height="55"/>
					</module>
					<aux color="blue" background="white" font_color="blue" font_size="11pt" label_side="bottom">
						<shape type="circle" radius="18"/>
					</aux>
					<group color="red" background="white" font_color="red" font_size="11pt"/>
					<connector color="#FF007F" background="white" font_color="#FF007F" font_size="9pt" isee:thickness="1"/>
					<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
					<isee:loop_indicator color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
					<numeric_display color="white" background="white" font_size="12pt" border_width="thin" border_style="solid" isee:transparent="false" isee:show_divider="true" isee:show_bounding_box="true" label_side="left"/>
					<graph color="black" background="white" font_size="12pt" axis_color="#666666" grid_color="#C8C8C8" isee:graph_area_color="white" legend_position="bottom" isee:transparent="false" isee:hide_border="false" axis_title_font_style="normal" axis_title_font_weight="normal" axis_title_text_decoration="none" axis_title_text_align="center" axis_title_vertical_text_align="center" axis_title_font_color="black" axis_title_font_family="Arial" axis_title_font_size="12pt" axis_title_text_padding="2" axis_title_text_border_color="black" axis_title_text_border_width="thin" axis_title_text_border_style="none" axis_label_font_style="normal" axis_label_font_weight="normal" axis_label_text_decoration="none" axis_label_text_align="center" axis_label_vertical_text_align="center" axis_label_font_color="black" axis_label_font_family="Arial" axis_label_font_size="9pt" axis_label_text_padding="2" axis_label_text_border_color="black" axis_label_text_border_width="thin" axis_label_text_border_style="none">
						<isee:series_styles>
							<isee:series_style color="blue" thickness="1"/>
							<isee:series_style color="red" thickness="1"/>
							<isee:series_style color="#008F44" thickness="1"/>
							<isee:series_style color="#FF7F00" thickness="1"/>
							<isee:series_style color="#7F00FF" thickness="1"/>
							<isee:series_style color="#0CA0FF" thickness="1"/>
							<isee:series_style color="lime" thickness="1"/>
							<isee:series_style color="#FF007F" thickness="1"/>
							<isee:series_style color="aqua" thickness="1"/>
							<isee:series_style color="#F586FF" thickness="1"/>
							<isee:series_style color="black" thickness="1"/>
							<isee:series_style color="#C8C8C8" thickness="1"/>
						</isee:series_styles>
					</graph>
					<table color="black" background="#E0E0E0" text_align="right" font_size="12pt" orientation="vertical" wrap_text="false" isee:auto_fit="true" isee:use_alternate_row_colors="false" isee:unlimited_table_length="false" blank_column_width="80" column_width="160" interval="1" report_balances="beginning" report_flows="instantaneous" header_font_style="normal" header_font_weight="normal" header_text_decoration="none" header_text_align="center" header_vertical_text_align="center" header_font_color="black" header_font_family="Arial" header_font_size="12pt" header_text_padding="2" header_text_border_color="black" header_text_border_width="thin" header_text_border_style="none"/>
				</style>
				<module x="331.167" y="160.216" name="Extraction of liquid fuels"/>
				<module x="523.5" y="160.216" name="Extraction of gas fuels"/>
				<module x="126" y="160.216" name="Extraction of solid fuels"/>
				<aux background="#FFAAFF" x="329.5" y="317.5" name="Total Primary Fossil Energy FUEL"/>
				<aux font_style="italic" font_weight="bold" x="129" y="226" name="Primary Fossil energy Fuel 3"/>
				<connector uid="1" angle="233.549" isee:autocreated="true">
					<from>Extraction_of_solid_fuels</from>
					<to>Primary_Fossil_energy_Fuel_3</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="329.5" y="226" name="Primary Fossil Energy FUEL 1"/>
				<connector uid="2" angle="281.857" isee:autocreated="true">
					<from>Extraction_of_liquid_fuels</from>
					<to>Primary_Fossil_Energy_FUEL_1</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="523.5" y="226" name="Primary Fossil Energy FUEL 2"/>
				<connector uid="3" angle="297.463" isee:autocreated="true">
					<from>Extraction_of_gas_fuels</from>
					<to>Primary_Fossil_Energy_FUEL_2</to>
				</connector>
				<connector uid="4" angle="310.914">
					<from>Primary_Fossil_energy_Fuel_3</from>
					<to>Total_Primary_Fossil_Energy_FUEL</to>
				</connector>
				<connector uid="5" angle="235.674">
					<from>Primary_Fossil_Energy_FUEL_1</from>
					<to>Total_Primary_Fossil_Energy_FUEL</to>
				</connector>
				<connector uid="6" angle="233.746">
					<from>Primary_Fossil_Energy_FUEL_2</from>
					<to>Total_Primary_Fossil_Energy_FUEL</to>
				</connector>
			</view>
		</views>
	</model>
	<model name="Extraction_of_gas_fuels">
		<variables>
			<stock name="Extracted Carbon in Fossil\nEnergy Resources">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>cumulative_extracted_fossil_fuels_in_1980</eqn>
				<inflow>Fossil_Fuel_Extraction_Carbon</inflow>
				<non_negative/>
				<units>GtC</units>
			</stock>
			<flow name="Fossil Fuel Extraction Carbon" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Fuel_Extraction_Capital*Fossil_Fuel_Extraction_Productivity</eqn>
				<non_negative/>
				<units>gtC/Year</units>
			</flow>
			<aux name="Primary Fossil Energy FUEL" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
This is extracted usable fuels in the current period.
Data for calibration would be total fossil energy production:
https://ourworldindata.org/grapher/fossil-fuel-production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(1e-10, Fossil_Fuel_Extraction_Carbon/Carbon_Intensity)</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Resource base">
				<doc>${Internal Calibration Parameter}
Proven reserves by 2020 (2024 Energy Institute Statistical Review of World Energy Data) plus Cumulative extracted fuel from 1850-2020 (Global Carbon Budget)

Carbon Intensity from EIA (https://www.eia.gov/environment/emissions/co2_vol_mass.php)
</doc>
				<eqn>166.4593679</eqn>
				<units>GtC</units>
			</aux>
			<aux name="Fossil Fuel Extraction\nProductivity" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>productivity_per_extractionknowledge*Fossil_Extraction_Accumulated_Knowledge
/
Marginal_Extraction_Costs</eqn>
				<units>GtC/c$/Years</units>
			</aux>
			<aux name="Initial extraction\ncosts">
				<doc>${Internal Calibration Parameter}
Initial extraction costs [c$ per GtC]
value from MIND Gams code, adjusted from tC to GtC

Adjusted after resource base</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>133346221583.493</eqn>
				<range min="10000000000" max="1000000000000"/>
				<units>c$/GtC</units>
			</aux>
			<aux name="Marginal Extraction Costs">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Initial_extraction_costs+
Slope_of_cost_curve*
(Extracted_Carbon_in_Fossil_Energy_Resources/Resource_base)^Exponent_of_cost_curve</eqn>
				<units>c$/GtC</units>
			</aux>
			<aux name="Slope of cost curve">
				<doc>${Assumption}
Slope of cost curve [c$ per GtC],
value from MIND Gams code, adjusted from Gc$ to c$</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>129688377071.244</eqn>
				<range min="70000000000" max="7000000000000"/>
				<units>c$/GtC</units>
			</aux>
			<aux name="maximum increase of capital\ncoefficient in fossil\nresource sector">
				<doc>${Assumption}
value from MIND</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>256.08</eqn>
				<range min="200" max="300"/>
				<units>extractionknowledge</units>
			</aux>
			<flow name="Change in Fossil\nLearning by Doing Effect">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Fossil_Extraction_Accumulated_Knowledge
/
(
learning_time_in_resource_sector*
maximum_increase_of_capital_coefficient_in_fossil_resource_sector
) 
*
(
maximum_increase_of_capital_coefficient_in_fossil_resource_sector-Fossil_Extraction_Accumulated_Knowledge
)
*
(
(Fossil_Energy_Extraction/initialFossilEnergyExtraction)^learning_elasticity_of_the_resource_sector -1
)
}
Fossil_Extraction_Accumulated_Knowledge * 
(
(1/learning_time_in_resource_sector)/
maximum_increase_of_capital_coefficient_in_fossil_resource_sector
) 
*
(maximum_increase_of_capital_coefficient_in_fossil_resource_sector - Fossil_Extraction_Accumulated_Knowledge) 
*
(
(Fossil_Fuel_Extraction_Carbon/INIT(Fossil_Fuel_Extraction_Carbon))^learning_elasticity_of_the_resource_sector - 1
)</eqn>
				<units>extractionknowledge/Year</units>
			</flow>
			<aux name="learning time\nin resource sector">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>30.49493995</eqn>
				<range min="20" max="40"/>
				<units>Year</units>
			</aux>
			<aux name="cumulative extracted fossil fuels in 1980">
				<doc>${External Parameter}
Cumulative CO2 emissions in 1980 divided by 3.67
</doc>
				<eqn>12.92</eqn>
				<units>GtC</units>
			</aux>
			<aux name="learning elasticity of\nthe resource sector">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.4</eqn>
				<range min="0.2" max="0.6"/>
				<units>Dimensionless</units>
			</aux>
			<aux name="Depreciation rate of\nFuel Extraction Capital">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.05</eqn>
				<range min="0" max="0.1"/>
				<units>1/year</units>
			</aux>
			<aux name="Exponent of cost curve">
				<doc>${Assumption}
</doc>
				<eqn>4</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="initial fossil fuel\nextraction capital">
				<doc>${Internal Calibration Parameter}
value 0.05 * 100tc$ taken from gams code

MIND 2005 Paper lists 5 trillion USD for 1995
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1787846671447.9</eqn>
				<range min="1000000000" max="50000000000000"/>
				<units>c$</units>
			</aux>
			<aux name="initial fossil\nextraction knowledge">
				<doc>${Internal Calibration Parameter}
value from MIND</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>125.085622176257</eqn>
				<range min="90" max="160"/>
				<units>extractionknowledge</units>
			</aux>
			<stock name="Fossil Extraction\nAccumulated Knowledge">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_fossil_extraction_knowledge</eqn>
				<inflow>Change_in_Fossil_Learning_by_Doing_Effect</inflow>
				<non_negative/>
				<units>extractionknowledge</units>
			</stock>
			<aux name="productivity per extractionknowledge">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.000462329288946041</eqn>
				<range min="0.0001" max="0.003"/>
				<units>1/extractionknowledge/Year</units>
			</aux>
			<aux name="Investments in Fossil\nFuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="rate of decommissioning fossil fuel extraction capital" access="input">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2100"/>
					<yscale min="0" max="100"/>
					<ypts>0,0,0,0,0,0,0,0,0</ypts>
				</gf>
				<units>1/year</units>
			</aux>
			<aux name="Policy Start Year" access="output" throughput="true">
				<eqn>2024</eqn>
				<units>Year</units>
			</aux>
			<flow name="Investment in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Fossil_Fuel_Extraction_Capital+Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</eqn>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<stock name="Fossil Fuel Extraction Capital" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_fossil_fuel_extraction_capital</eqn>
				<inflow>Investment_in_Fossil_Fuel_Extraction_Capital</inflow>
				<outflow>Decomisioning_of_fossil_fuel_extraction_capital</outflow>
				<outflow>Fossil_Fuel_Extraction_Capital_Damaged_due_to_STA</outflow>
				<outflow>Depreciation_of_Fuel_Extraction_Capital</outflow>
				<non_negative/>
				<units>c$</units>
			</stock>
			<flow name="Decomisioning of fossil\nfuel extraction capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Fossil_Fuel_Extraction_Capital/drain_time, desired_Decomisioning_of_fossil_fuel_extraction_capital)</eqn>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<flow name="Fossil Fuel Extraction\nCapital Damaged due to STA" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Fossil_Fuel_Extraction_Capital/drain_time, desired_Fossil_Fuel_Extraction_Capital_Damaged_due_to_STA)</eqn>
				<format precision="full"/>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<aux name="desired Decomisioning of fossil\nfuel extraction capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME&gt;Policy_Start_Year THEN
rate_of_decommissioning_fossil_fuel_extraction_capital*Fossil_Fuel_Extraction_Capital 
ELSE
0</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="desired Fossil Fuel Extraction\nCapital Damaged due to STA">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Fossil_Fuel_Extraction_Capital*damage_rate_of_energy_capital_from_STA_1</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Desired Depreciation of Fuel\nExtraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Depreciation_rate_of_Fuel_Extraction_Capital*Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<flow name="Depreciation of Fuel\nExtraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Fossil_Fuel_Extraction_Capital/drain_time, Desired_Depreciation_of_Fuel_Extraction_Capital)</eqn>
				<non_negative/>
				<units>c$/Year</units>
			</flow>
			<aux name="drain time" access="output">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="damage rate of energy\ncapital from STA 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Gas Gross\nInvestments in Fossil\nFuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Electricity" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_by_type[Run,Fuel]+Backstop_allocation</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_by_type[Run,Electricity]+Backstop_allocation</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Carbon Intensity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>GtC/ZJ</units>
			</aux>
			<aux name="energy carrier missmatch">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>IF PrimaryFuelUse = PrimaryFuelUse.Fuel THEN Perceived_Energy_missmatch_in_fuel[1]
ELSE IF PrimaryFuelUse = PrimaryFuelUse.Electricity THEN Perceived_Energy_missmatch_in_electricity[1]
ELSE NAN</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>97994.3515435588</eqn>
				<range min="95000" max="110000"/>
				<units>TWh/year</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>3 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>MIN(1e6,energy_carrier_missmatch)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="time to perceive\nchanges in investment 1">
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="Primary Fossil\nEnergy FUEL by type">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>ALLOCATE(&quot;Primary_Fossil_Energy_FUEL_90%&quot;[Run], PrimaryFuelUse, desired_investment_by_source_1[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Perceived Energy missmatch in fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Energy_Supply_Missmatch_1, time_to_perceive_changes_in_investment_1, initial_energy_supply_missmatch_in_fuel)</eqn>
				<isee:delay_aux/>
				<units>TWh/year</units>
			</aux>
			<aux name="Perceived Energy missmatch in electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Energy_Supply_Missmatch, time_to_perceive_changes_in_investment_1, initial_energy_supply_missmatch_for_electricity)</eqn>
				<isee:delay_aux/>
				<units>TWh/year</units>
			</aux>
			<aux name="desired investment\nby source 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="PrimaryFuelUse"/>
				</dimensions>
				<eqn>&quot;Primary_Fossil_Energy_FUEL_90%&quot;[Run]</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Ratio of fuel for electricity 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Electricity 1" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_investment_ratio_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="perceived investment ratio 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Ratio_of_fuel_for_electricity_1, time_to_perceive_changes_in_investment_2, initial_investment_ratio_2)</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="initial investment ratio 2" access="output" isee:autocreated="true">
				<eqn>0.35</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="time to perceive changes in investment 2">
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="Energy Supply\nMissmatch 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Energy Supply\nMissmatch" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="initial energy supply missmatch in fuel" access="output" isee:autocreated="true">
				<eqn>0.112429320252983</eqn>
				<range min="0" max="1"/>
				<units>TWh/year</units>
			</aux>
			<aux name="initial energy supply\nmissmatch for electricity" access="output" isee:autocreated="true">
				<eqn>0.16451379159917</eqn>
				<range min="0" max="1"/>
				<units>TWh/year</units>
			</aux>
			<aux name="Backstop allocation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL*0.05</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy FUEL 90%">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL-Backstop_allocation*2</eqn>
				<units>zJ/Year</units>
			</aux>
