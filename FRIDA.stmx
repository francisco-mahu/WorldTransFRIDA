				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run] +  tax_revenue_on_investments_in_coal_extraction[Run] - expenditure_on_subsidies_for_investments_in_coal_extraction[Run]</eqn>
				<units>c$/Year</units>
			</aux>
