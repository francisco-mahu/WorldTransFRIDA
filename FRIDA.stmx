	<model name="Electricity_investments">
		<variables>
			<flow name="Acc Cum Rel En Sup Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer[Run]/time_to_perceive_energy_supply_missmatch[Run]</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer[Run]^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<stock name="cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch[Run]</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch</inflow>
				<units>dmnl</units>
			</stock>
