	</model>
	<model name="Solar_energy_1" run="true">
		<variables>
			<aux name="Solar Energy\nFull Load Hours">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1694.90464022504</eqn>
				<range min="1200" max="1850"/>
				<units>hours/year</units>
			</aux>
			<stock name="Solar Energy\nInstalled Capacity">
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>Initial_Installed_Renewable_Energy_Capacity[Run,Renewable_Age_Group]</eqn>
				<inflow>Renewable_Energy_Capacity_Construction</inflow>
				<inflow>Renewable_Energy_Capacity_Vintage_Aging_In</inflow>
				<outflow>Renewable_Energy_Capacity_Vintage_Aging_Out</outflow>
				<outflow>Solar_Energy_Capital_Damaged_due_to_STA</outflow>
				<conveyor exponential_leak="true" fifo="true">
					<len>Renewable_Energy_Capacity_Vintage_Duration</len>
				</conveyor>
				<units>gW</units>
			</stock>
			<flow name="Renewable Energy\nCapacity Construction">
				<doc>Data newely installed renewable capcity</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>IF(Renewable_Age_Group=1)THEN 
kW_to_GW *
Investments_in_Solar_and_Wind_Energy_Capacity[Run] /
(Installation_Cost_of_Solar_capacity[Run])
ELSE 0</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<flow name="Renewable Energy Capacity Vintage Aging Out">
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>0</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<flow name="Renewable Energy Capacity Vintage Aging In">
				<doc>changed the decay to work on the aging in gets me much closer to the MIND output
We might want to change back to decay later, as that would be more compatible with the continuous time concept used in FRIDA in general</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>Renewable_Energy_Capacity_Vintage_Aging_Out[Run,  Renewable_Age_Group-1] * (1-Renewable_Energy_Capacity_Decay_Fractions[Renewable_Age_Group])</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<aux name="Solar\nEnergy Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
Calibrate to time series of ren cap</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SUM(Solar_Energy_Installed_Capacity[Run,*])</eqn>
				<units>gW</units>
			</aux>
			<aux name="Renewable Energy Capacity Decay Fractions">
				<doc>${External Parameter}
from MIND</doc>
				<dimensions>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<element subscript="1">
					<eqn>0</eqn>
				</element>
				<element subscript="2">
					<eqn>0.1</eqn>
				</element>
				<element subscript="3">
					<eqn>0.111111111</eqn>
				</element>
				<element subscript="4">
					<eqn>0.125</eqn>
				</element>
				<element subscript="5">
					<eqn>0.285714286</eqn>
				</element>
				<element subscript="6">
					<eqn>0.7</eqn>
				</element>
				<element subscript="7">
					<eqn>1</eqn>
				</element>
				<units>Dimensionless</units>
			</aux>
			<aux name="Renewable Energy Capacity\nVintage Duration">
				<doc>${External Parameter}
from MIND</doc>
				<eqn>5</eqn>
				<units>year</units>
			</aux>
			<aux name="Installation Cost\nof Solar capacity">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(actual_renewable_energy_floor_costs+Renewable_Energy_Reducible_Installation_Cost_component)</eqn>
				<units>c$/kW</units>
			</aux>
			<aux name="Solar Energy\nLearning Rate">
				<doc>${Assumption,Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.139</eqn>
				<range min="0.05" max="0.4"/>
				<units>dmnl</units>
			</aux>
			<aux name="Renewable Energy\nFloor Costs">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>50.5813361738271</eqn>
				<range min="1" max="500"/>
				<units>c$/kW</units>
			</aux>
			<aux name="Initial Solar Energy\nInstallation Costs">
				<doc>${Internal Calibration Parameter}
Calibrate to the initial value of the time series on renewable reducible installation costs</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>4355.25617740702</eqn>
				<range min="100" max="100000"/>
				<units>c$/kW</units>
			</aux>
			<stock name="Cumulative Renewable Energy\nCapacity Construction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SUM(Initial_Installed_Renewable_Energy_Capacity[Run,*])</eqn>
				<inflow>accumulating_Renewable_Energy_Construction</inflow>
				<non_negative/>
				<units>gW</units>
			</stock>
			<flow name="accumulating Renewable Energy Construction">
				<doc>Data newely installed renewable capcity</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Renewable_Energy_Capacity_Construction[Run, 1]</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<aux name="Initial Installed\nRenewable Energy Capacity">
				<doc>${External Parameter}
Sum of this is initial capacity for calibration

With the time series of total renewable energy capcity we can calculate the entries of the array. As they are histroical construction depereciatted

from MIND</doc>
				<dimensions>
					<dim name="Run" marked_a2a="true"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<element subscript="1, 1">
					<eqn>0.5</eqn>
				</element>
				<element subscript="1, 2">
					<eqn>0.15</eqn>
				</element>
				<element subscript="1, 3">
					<eqn>0.06</eqn>
				</element>
				<element subscript="1, 4">
					<eqn>0.0225</eqn>
				</element>
				<element subscript="1, 5">
					<eqn>0.0125</eqn>
				</element>
				<element subscript="1, 6">
					<eqn>0</eqn>
				</element>
				<element subscript="1, 7">
					<eqn>0</eqn>
				</element>
				<units>gW</units>
			</aux>
			<aux name="gWh to TWh" access="input">
				<doc>${Assumption}
</doc>
				<eqn>0.001</eqn>
				<units>TWh/(gW*hours)</units>
			</aux>
			<aux name="learning rate parameter in\nrenewable energy sector">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-((LN(1-Solar_Energy_Learning_Rate))/LN(2))</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="stepping on toes parameter\nin renewable energy sector">
				<doc>${Assumption,Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.497651910391243</eqn>
				<range min="0.1" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Renewable Energy\nReducible Installation\nCost component">
				<doc>Price per energy unit </doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Initial_Solar_Energy_Installation_Costs * Effect_of_Learning_On_Cost_O_Solar_Energy
* Stepping_on_Toes_Punishment</eqn>
				<units>c$/kW</units>
			</aux>
			<aux name="Stepping on Toes Punishment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Cumulative_Renewable_Energy_Capacity_Construction/Perceived_cumulative_ren_energy_capacity_construction)^stepping_on_toes_parameter_in_renewable_energy_sector</eqn>
				<init_eqn>1</init_eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Perceived cumulative ren energy\ncapacity construction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>DELAY(Cumulative_Renewable_Energy_Capacity_Construction, time_to_perceive_changes_in_construction)</eqn>
				<isee:delay_aux/>
				<units>GW</units>
			</aux>
			<aux name="time to perceive\nchanges in construction">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>Year</units>
			</aux>
			<aux name="Solar Energy Output" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
Solar_Energy_Full_Load_Hours * 
Solar_Energy_Capacity * gWh_to_TWh
)</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Effect of Learning On Cost O Solar Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(SUM(Initial_Installed_Renewable_Energy_Capacity[Run,*])  /  Cumulative_Renewable_Energy_Capacity_Construction)^learning_rate_parameter_in_renewable_energy_sector</eqn>
				<units>dmnl</units>
			</aux>
			<flow name="Solar Energy\nCapital Damaged due to STA">
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>damage_rate_of_energy_capital_from_STA_1[Run]</eqn>
				<non_negative/>
				<leak/>
				<units>gW/Year</units>
			</flow>
			<aux name="Investments in\nSolar and Wind\nEnergy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="extra capacity needed for delta Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Converter_1) 
/Solar_Energy_Full_Load_Hours</eqn>
				<units>TW</units>
			</aux>
			<aux name="cost of extra capacity needed for delta Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Installation_Cost_of_Solar_capacity/kW_to_TW)*extra_capacity_needed_for_delta_Energy</eqn>
				<units>c$</units>
			</aux>
			<aux name="kW to TW" access="input">
				<eqn>1e-9</eqn>
				<units>TW/kW</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit\nnet of Tax and Subsidies" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Cost_of_Extra_Energy_Output_through_Capital_per_Unit
+
tax_burden_per_Unit</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="TWh to kWh" access="input">
				<eqn>1000000000</eqn>
				<units>kWh/TWh</units>
			</aux>
			<aux name="subsidy for newly installed solar and wind energy capacity" access="input">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="1980" max="1981"/>
					<yscale min="0" max="100"/>
					<ypts>0,0</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<aux name="start year" access="input">
				<eqn>2024</eqn>
				<units>Year</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>cost_of_extra_capacity_needed_for_delta_Energy/(Converter_1*TWh_to_kWh)</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="tax rate" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>tax_burden_per_Unit/Cost_of_Extra_Energy_Output_through_Capital_per_Unit</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="tax burden per Unit">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME&gt;=start_year THEN
subsidy_for_newly_installed_solar_and_wind_energy_capacity * Cost_of_Extra_Energy_Output_through_Capital_per_Unit
ELSE
0</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="actual renewable\nenergy floor costs">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Renewable_Energy_Floor_Costs+(reference_installation_cost*share_of_reference_cost_from_storage)</eqn>
				<units>c$/kW</units>
			</aux>
			<aux name="sensitivity of renewable floor costs to grid storage needs">
				<doc>${Internal Calibration Parameter}
These parameters are set so that the effect of having to build grid energy storage for renewable output share on floor costs follows a behaviour where costs increase (do not decrease as fast) if grid storage has to be built alongside solar and wind when they make up a large share of output. But if solar and wind is scaled further (including implied complementary storage) costs come down again. The eventual decrease of costs is motivated by the same general idea as overall learning by doing.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>5.23290023655671</eqn>
				<range min="2" max="10"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of\nhaving to build grid energy storage for\nrenewable output share\non floor costs">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(1, 
1 + sensitivity_of_renewable_floor_costs_to_grid_storage_needs[Run] * Solar_and_Wind_Output_Share_1
+
sensitivity_of_renewable_floor_costs_to_grid_storage_needs_non_linear_part[Run] * Solar_and_Wind_Output_Share_1^2)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of renewable floor costs to grid storage needs non linear part">
				<doc>${Internal Calibration Parameter}
These parameters are set so that the effect of having to build grid energy storage for renewable output share on floor costs follows a behaviour where costs increase (do not decrease as fast) if grid storage has to be built alongside solar and wind when they make up a large share of output. But if solar and wind is scaled further (including implied complementary storage) costs come down again. The eventual decrease of costs is motivated by the same general idea as overall learning by doing.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-5.19283338675795</eqn>
				<range min="-46" max="-3"/>
				<units>dmnl</units>
			</aux>
			<aux name="reference installation\ncost">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Installation_Cost_of_Solar_capacity, reference_formation_time, Initial_Solar_Energy_Installation_Costs+Renewable_Energy_Floor_Costs)</eqn>
				<isee:delay_aux/>
				<units>c$/kW</units>
			</aux>
			<aux name="reference formation time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>10</eqn>
				<range min="5" max="20"/>
				<units>years</units>
			</aux>
			<aux name="share of reference cost\nfrom storage">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(reference_share_of_cost_for_grid_storage*effect_of_having_to_build_grid_energy_storage_for_renewable_output_share_on_floor_costs)-reference_share_of_cost_for_grid_storage</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="reference share of cost\nfor grid storage">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.578983247290863</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="kW to GW" access="input">
				<doc>${Assumption,No Sensi}
</doc>
				<eqn>0.000001</eqn>
				<units>GW/kW</units>
			</aux>
			<aux name="damage rate of energy\ncapital from STA 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Converter 1" access="input">
				<units>TWh/year</units>
			</aux>
			<aux name="Solar and Wind Output Share 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
