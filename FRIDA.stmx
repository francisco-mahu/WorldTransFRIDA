			<aux name="Electricity demand for\nindustry and other 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Total Electricity demand" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 1 THEN 
(Electricity_demand_for_industry_and_other_1+Electricity_demand_for_industry_and_other_3+Electricity_demand_for_industry_and_other)
ELSE
1e4</eqn>
				<units>TWh/Year</units>
			</aux>
