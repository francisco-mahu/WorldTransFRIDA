	</model>
	<model name="Total_energy_supply_vs_demand">
		<variables>
			<aux name="Energy Balance" access="output">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Total_Energy_Output/Categorized_Energy_demand</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Cumulative Deviations of Energy Balance from 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Deviations_from_one_in_Energy_Balance</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="Deviations from one in Energy Balance">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((1-Energy_Balance)^2)/DT</eqn>
				<non_negative/>
				<units>dmnl/year</units>
			</flow>
			<stock name="Cumulative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Energy_Supply_Missmatch</inflow>
				<units>TWh</units>
			</stock>
			<flow name="Energy Supply\nMissmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Total_Energy_Output-Categorized_Energy_demand)</eqn>
				<units>TWh/Year</units>
			</flow>
			<aux name="Relative Energy\nSupply Missmatch 1" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_Supply_Missmatch/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Total demand for energy" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Total Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Direct use Other demand" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Categorized Energy demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Total_demand_for_energy-Direct_use_Other_demand+Direct_use_Biofuel_demand</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Direct use Biofuel demand" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
		</variables>
		<views>
