	</model>
	<model name="Wind_energy_1" run="true">
		<variables>
			<stock name="Wind Energy\nInstalled Capacity">
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>Initial_Installed_Renewable_Energy_Capacity[Run,Renewable_Age_Group]</eqn>
				<inflow>Renewable_Energy_Capacity_Construction</inflow>
				<inflow>Renewable_Energy_Capacity_Vintage_Aging_In</inflow>
				<outflow>Renewable_Energy_Capacity_Vintage_Aging_Out</outflow>
				<outflow>Wind_Energy_Capital_Damaged_due_to_STA</outflow>
				<conveyor exponential_leak="true" fifo="true">
					<len>Renewable_Energy_Capacity_Vintage_Duration</len>
				</conveyor>
				<units>gW</units>
			</stock>
			<flow name="Renewable Energy\nCapacity Construction">
				<doc>Data newely installed renewable capcity</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 0 THEN
(IF(Renewable_Age_Group=1)THEN 
kW_to_GW *
Investments_in_Solar_and_Wind_Energy_Capacity[Run] /
(Installation_Cost_of_Wind_capacity[Run])
ELSE 0)
ELSE
(IF(Renewable_Age_Group=1)THEN 
kW_to_GW *
Converter_1[Run] /
(Installation_Cost_of_Wind_capacity[Run])
ELSE 0)</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<flow name="Renewable Energy Capacity Vintage Aging Out">
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>0</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<flow name="Renewable Energy Capacity Vintage Aging In">
				<doc>changed the decay to work on the aging in gets me much closer to the MIND output
We might want to change back to decay later, as that would be more compatible with the continuous time concept used in FRIDA in general</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>Renewable_Energy_Capacity_Vintage_Aging_Out[Run,  Renewable_Age_Group-1] * (1-Renewable_Energy_Capacity_Decay_Fractions[Renewable_Age_Group])</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<aux name="Wind\nEnergy Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
Calibrate to time series of ren cap</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SUM(Wind_Energy_Installed_Capacity[Run,*])</eqn>
				<units>gW</units>
			</aux>
			<aux name="Renewable Energy Capacity Decay Fractions">
				<doc>${External Parameter}
from MIND</doc>
				<dimensions>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<element subscript="1">
					<eqn>0</eqn>
				</element>
				<element subscript="2">
					<eqn>0.1</eqn>
				</element>
				<element subscript="3">
					<eqn>0.111111111</eqn>
				</element>
				<element subscript="4">
					<eqn>0.125</eqn>
				</element>
				<element subscript="5">
					<eqn>0.285714286</eqn>
				</element>
				<element subscript="6">
					<eqn>0.7</eqn>
				</element>
				<element subscript="7">
					<eqn>1</eqn>
				</element>
				<units>Dimensionless</units>
			</aux>
			<aux name="Renewable Energy Capacity\nVintage Duration">
				<doc>${External Parameter}
from MIND</doc>
				<eqn>5</eqn>
				<units>year</units>
			</aux>
			<aux name="Installation Cost\nof Wind capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(actual_renewable_energy_floor_costs+Renewable_Energy_Reducible_Installation_Cost_component)</eqn>
				<units>c$/kW</units>
			</aux>
			<aux name="Wind Energy\nLearning Rate">
				<doc>${Assumption,Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.113320005451525</eqn>
				<range min="0.05" max="0.4"/>
				<units>dmnl</units>
			</aux>
			<aux name="Renewable Energy\nFloor Costs">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>12.1609429118296</eqn>
				<range min="1" max="500"/>
				<units>c$/kW</units>
			</aux>
			<aux name="Initial Wind Energy\nInstallation Costs">
				<doc>${Internal Calibration Parameter}
Calibrate to the initial value of the time series on renewable reducible installation costs</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>4539.5189445888</eqn>
				<range min="100" max="100000"/>
				<units>c$/kW</units>
			</aux>
			<stock name="Cumulative Renewable Energy\nCapacity Construction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SUM(Initial_Installed_Renewable_Energy_Capacity[Run,*])</eqn>
				<inflow>accumulating_Renewable_Energy_Construction</inflow>
				<non_negative/>
				<units>gW</units>
			</stock>
			<flow name="accumulating Renewable Energy Construction">
				<doc>Data newely installed renewable capcity</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Renewable_Energy_Capacity_Construction[Run, 1]</eqn>
				<non_negative/>
				<units>gW/Year</units>
			</flow>
			<aux name="Initial Installed\nRenewable Energy Capacity">
				<doc>${External Parameter}
Sum of this is initial capacity for calibration

With the time series of total renewable energy capcity we can calculate the entries of the array. As they are histroical construction depereciatted

from MIND</doc>
				<dimensions>
					<dim name="Run" marked_a2a="true"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<element subscript="1, 1">
					<eqn>0.5</eqn>
				</element>
				<element subscript="1, 2">
					<eqn>0.15</eqn>
				</element>
				<element subscript="1, 3">
					<eqn>0.06</eqn>
				</element>
				<element subscript="1, 4">
					<eqn>0.0225</eqn>
				</element>
				<element subscript="1, 5">
					<eqn>0.0125</eqn>
				</element>
				<element subscript="1, 6">
					<eqn>0</eqn>
				</element>
				<element subscript="1, 7">
					<eqn>0</eqn>
				</element>
				<units>gW</units>
			</aux>
			<aux name="gWh to TWh" access="input">
				<doc>${Assumption}
</doc>
				<eqn>0.001</eqn>
				<units>TWh/(gW*hours)</units>
			</aux>
			<aux name="kW to GW" access="input">
				<doc>${Assumption,No Sensi}
</doc>
				<eqn>0.000001</eqn>
				<units>GW/kW</units>
			</aux>
			<aux name="learning rate parameter in renewable energy sector">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-((LN(1-Wind_Energy_Learning_Rate))/LN(2))</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="stepping on toes parameter\nin renewable energy sector">
				<doc>${Assumption,Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.5</eqn>
				<range min="0.1" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Renewable Energy\nReducible Installation\nCost component">
				<doc>Price per energy unit </doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Initial_Wind_Energy_Installation_Costs * Effect_of_Learning_On_Cost_O_Wind_Energy
* Stepping_on_Toes_Punishment</eqn>
				<units>c$/kW</units>
			</aux>
			<aux name="Stepping on Toes Punishment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Cumulative_Renewable_Energy_Capacity_Construction/Perceived_cumulative_ren_energy_capacity_construction)^stepping_on_toes_parameter_in_renewable_energy_sector</eqn>
				<init_eqn>1</init_eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Perceived cumulative ren energy\ncapacity construction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>DELAY(Cumulative_Renewable_Energy_Capacity_Construction, time_to_perceive_changes_in_construction)</eqn>
				<isee:delay_aux/>
				<units>GW</units>
			</aux>
			<aux name="time to perceive\nchanges in construction">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>Year</units>
			</aux>
			<aux name="Effect of Learning On Cost O Wind Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(SUM(Initial_Installed_Renewable_Energy_Capacity[Run,*])  /  Cumulative_Renewable_Energy_Capacity_Construction)^learning_rate_parameter_in_renewable_energy_sector</eqn>
				<units>dmnl</units>
			</aux>
			<flow name="Wind Energy\nCapital Damaged due to STA">
				<dimensions>
					<dim name="Run"/>
					<dim name="Renewable_Age_Group"/>
				</dimensions>
				<eqn>damage_rate_of_energy_capital_from_STA[Run]</eqn>
				<non_negative/>
				<leak/>
				<units>gW/Year</units>
			</flow>
			<aux name="damage rate of energy\ncapital from STA" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Investments in\nSolar and Wind\nEnergy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="extra capacity needed for delta Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(deltaEnergy_for_costs) 
/Wind_Energy_Full_Load_Hours</eqn>
				<units>TW</units>
			</aux>
			<aux name="deltaEnergy for costs" access="input">
				<eqn>1</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="cost of extra capacity needed for delta Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Installation_Cost_of_Wind_capacity/kW_to_TW)*extra_capacity_needed_for_delta_Energy</eqn>
				<units>c$</units>
			</aux>
			<aux name="kW to TW" access="input">
				<eqn>1e-9</eqn>
				<units>TW/kW</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit\nnet of Tax and Subsidies" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Cost_of_Extra_Energy_Output_through_Capital_per_Unit
+
tax_burden_per_Unit</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="TWh to kWh" access="input">
				<eqn>1000000000</eqn>
				<units>kWh/TWh</units>
			</aux>
			<aux name="subsidy for newly installed solar and wind energy capacity" access="input">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="1980" max="1981"/>
					<yscale min="0" max="100"/>
					<ypts>0,0</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<aux name="start year" access="input">
				<eqn>2024</eqn>
				<units>Year</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>cost_of_extra_capacity_needed_for_delta_Energy/(deltaEnergy_for_costs*TWh_to_kWh)</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="tax rate" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>tax_burden_per_Unit/Cost_of_Extra_Energy_Output_through_Capital_per_Unit</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="tax burden per Unit">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME&gt;=start_year THEN
subsidy_for_newly_installed_solar_and_wind_energy_capacity * Cost_of_Extra_Energy_Output_through_Capital_per_Unit
ELSE
0</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="actual renewable\nenergy floor costs">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Renewable_Energy_Floor_Costs+(reference_installation_cost*share_of_reference_cost_from_storage)</eqn>
				<units>c$/kW</units>
			</aux>
			<aux name="sensitivity of renewable floor\ncosts to grid storage needs">
				<doc>${Internal Calibration Parameter}
These parameters are set so that the effect of having to build grid energy storage for renewable output share on floor costs follows a behaviour where costs increase (do not decrease as fast) if grid storage has to be built alongside solar and wind when they make up a large share of output. But if solar and wind is scaled further (including implied complementary storage) costs come down again. The eventual decrease of costs is motivated by the same general idea as overall learning by doing.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>4.98785416359998</eqn>
				<range min="2" max="10"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of\nhaving to build grid energy storage for\nrenewable output share\non floor costs">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(1, 
1 + sensitivity_of_renewable_floor_costs_to_grid_storage_needs[Run] * Solar_and_Wind_Energy_Output_Share
+
sensitivity_of_renewable_floor_costs_to_grid_storage_needs_non_linear_part[Run] * Solar_and_Wind_Energy_Output_Share^2)
{sensitivity_of_renewable_floor_costs_to_grid_storage_needs*LN(energy_supply.Solar_and_Wind_Output_Share + 1) + 1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of renewable floor\ncosts to grid storage\nneeds non linear part">
				<doc>${Internal Calibration Parameter}
These parameters are set so that the effect of having to build grid energy storage for renewable output share on floor costs follows a behaviour where costs increase (do not decrease as fast) if grid storage has to be built alongside solar and wind when they make up a large share of output. But if solar and wind is scaled further (including implied complementary storage) costs come down again. The eventual decrease of costs is motivated by the same general idea as overall learning by doing.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-5.35052116529329</eqn>
				<range min="-46" max="-3"/>
				<units>dmnl</units>
			</aux>
			<aux name="Wind Energy Output" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
Wind_Energy_Full_Load_Hours * 
Wind_Energy_Capacity * gWh_to_TWh
)</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="share of reference cost\nfrom storage">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(reference_share_of_cost_for_grid_storage*effect_of_having_to_build_grid_energy_storage_for_renewable_output_share_on_floor_costs)-reference_share_of_cost_for_grid_storage</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="reference share of cost\nfor grid storage">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.6</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="reference installation\ncost">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Installation_Cost_of_Wind_capacity, reference_formation_time, Initial_Wind_Energy_Installation_Costs+Renewable_Energy_Floor_Costs)</eqn>
				<isee:delay_aux/>
				<units>c$/kW</units>
			</aux>
			<aux name="reference formation time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>10</eqn>
				<range min="5" max="20"/>
				<units>years</units>
			</aux>
			<aux name="Wind Energy\nFull Load Hours">
				<doc>${External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_Energy_Full_Load_Hours_Onshore-Full_Load_Hours_loss</eqn>
				<range min="1650" max="1850"/>
				<units>hours/year</units>
			</aux>
			<aux name="Initial Wind Energy\nFull Load Hours">
				<doc>${External Parameter}
from MIND</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1838.69962936481</eqn>
				<range min="1650" max="1850"/>
				<units>hours/year</units>
			</aux>
			<aux name="Wind Energy\nFull Load Hours Onshore">
				<doc>${External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Initial_Wind_Energy_Full_Load_Hours*(1+ (Onshore_wind_speed_anomaly/Absolute_historical_wind_speed_1981_to_2011))^3</eqn>
				<format precision="0.01"/>
				<range min="1650" max="1850"/>
				<units>hours/year</units>
			</aux>
			<aux name="Onshore wind speed anomaly">
				<doc>Increment of wind speed obtained from: Monthly variation and correlation analysis of global temperature and wind resources under climate change (https://www.sciencedirect.com/science/article/pii/S0196890423003382#s0010) </doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>conversion_factor_between_surface_temperature_anomaly_and_wind_speed*Surface_Temperature_Anomaly</eqn>
				<units>m/s</units>
			</aux>
			<aux name="Absolute historical\nwind speed 1981 to 2011">
				<doc>${External Parameter}
https://link.springer.com/article/10.1007/s00382-017-3997-y/tables/1
Changes in terrestrial near-surface wind speed and their possible causes: an overview</doc>
				<eqn>3.5</eqn>
				<units>m/s</units>
			</aux>
			<aux name="conversion factor between surface\ntemperature anomaly\nand wind speed">
				<doc>${External Parameter}
Estimated from https://www.sciencedirect.com/science/article/pii/S0196890423003382#s0045

if  the global temperature has increased on average by 0.34 °C/10 a from 1989 to 2021, and the global average wind increased by 0.02 m/(s⋅10 a)
</doc>
				<eqn>0.058{0.001, 0.1}</eqn>
				<units>m/s/deg C</units>
			</aux>
			<aux name="Frequency of\nlow wind extremes">
				<doc>Regression line with data from: Prolonged wind droughts in a warming climate threaten global wind power security</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>frequency_slope*Surface_Temperature_Anomaly +frequency_intercept</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Full Load Hours loss">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Duration_of_low_wind_extremes+Frequency_of_low_wind_extremes)*Wind_Energy_Full_Load_Hours_Onshore</eqn>
				<units>hours/year</units>
			</aux>
			<aux name="Duration of\nlow wind extremes">
				<doc>Regression line with data from: Prolonged wind droughts in a warming climate threaten global wind power security</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>duration_slope*Surface_Temperature_Anomaly-duration_intercept</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="duration slope">
				<doc>${External Parameter}
</doc>
				<eqn>0.04</eqn>
				<units>1/deg C</units>
			</aux>
			<aux name="frequency slope">
				<doc>${External Parameter}
</doc>
				<eqn>-4.125677361767771e-34</eqn>
				<units>1/deg C</units>
			</aux>
			<aux name="duration intercept">
				<doc>${External Parameter}
</doc>
				<eqn>0.01</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="frequency intercept">
				<doc>${External Parameter}
</doc>
				<eqn>0.05</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Surface Temperature Anomaly" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>deg C</units>
			</aux>
			<aux name="Solar and Wind Energy\nOutput Share" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Switch to couple investments supply and demand in new energy" access="output" throughput="true" isee:autocreated="true">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<isee:loop_indicator color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<numeric_display color="white" background="white" font_size="12pt" border_width="thin" border_style="solid" isee:transparent="false" isee:show_divider="true" isee:show_bounding_box="true" label_side="left"/>
				<graph color="black" background="white" font_size="12pt" axis_color="#666666" grid_color="#C8C8C8" isee:graph_area_color="white" legend_position="bottom" isee:transparent="false" isee:hide_border="false" axis_title_font_style="normal" axis_title_font_weight="normal" axis_title_text_decoration="none" axis_title_text_align="center" axis_title_vertical_text_align="center" axis_title_font_color="black" axis_title_font_family="Arial" axis_title_font_size="12pt" axis_title_text_padding="2" axis_title_text_border_color="black" axis_title_text_border_width="thin" axis_title_text_border_style="none" axis_label_font_style="normal" axis_label_font_weight="normal" axis_label_text_decoration="none" axis_label_text_align="center" axis_label_vertical_text_align="center" axis_label_font_color="black" axis_label_font_family="Arial" axis_label_font_size="9pt" axis_label_text_padding="2" axis_label_text_border_color="black" axis_label_text_border_width="thin" axis_label_text_border_style="none">
					<isee:series_styles>
						<isee:series_style color="blue" thickness="1"/>
						<isee:series_style color="red" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="fuchsia" thickness="1" pen_style="dotted"/>
						<isee:series_style color="#008F44" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF7F00" thickness="1"/>
						<isee:series_style color="#7F00FF" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="#0CA0FF" thickness="1" pen_style="dotted"/>
						<isee:series_style color="lime" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF007F" thickness="1"/>
						<isee:series_style color="aqua" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="#F586FF" thickness="1" pen_style="dotted"/>
						<isee:series_style color="black" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#C8C8C8" thickness="1"/>
					</isee:series_styles>
				</graph>
				<table color="black" background="#E0E0E0" text_align="right" font_size="12pt" orientation="vertical" wrap_text="false" isee:auto_fit="true" isee:use_alternate_row_colors="false" isee:unlimited_table_length="false" blank_column_width="80" column_width="160" interval="1" report_balances="beginning" report_flows="instantaneous" header_font_style="normal" header_font_weight="normal" header_text_decoration="none" header_text_align="center" header_vertical_text_align="center" header_font_color="black" header_font_family="Arial" header_font_size="12pt" header_text_padding="2" header_text_border_color="black" header_text_border_width="thin" header_text_border_style="none"/>
				<button color="black" background="#E0E0E0" font_size="12pt" border_width="thin" border_style="solid" transparent="false" corner_radius="0" isee:flat="false" icon_side="top" isee:highlight_on_hover="false" isee:highlight_color="#959595"/>
				<isee:annotation color="black" background="#E0E0E0" font_size="12pt" border_width="thin" border_style="solid" transparent="false" corner_radius="0" isee:flat="false" icon_side="top" isee:highlight_on_hover="false" isee:highlight_color="#959595" popup_corner_radius="0" popup_background_color="#FFFECF"/>
				<slider color="#0075FF" background="#E0E0E0" font_size="12pt" num_ticks="3" label_side="top" wrap_title="true" vertical="false" isee:fancy_appearance="false" isee:show_hover_tip="when_deciding" input_expands="true" input_width="100"/>
				<isee:stacked_container color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt" padding="6 8" border_color="#999999" border_width="thin" border_style="solid" item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				<isee:dual_slider color="#66CC66" background="silver" font_size="12pt" num_ticks="3" label_side="top" wrap_title="true" isee:show_hover_tip="when_deciding" input_expands="true" input_width="100"/>
				<isee:sim_speed_slider color="black" background="white"/>
				<isee:time_slider color="#E95F74" background="silver"/>
				<isee:pie_input color="black" background="white" font_size="12pt" legend_position="bottom" isee:transparent="false"/>
				<knob color="#66CC66" background="#E0E0E0" font_size="12pt" label_side="bottom" wrap_title="true"/>
				<numeric_input color="black" background="#E0E0E0" font_size="12pt" label_side="left" wrap_title="true" input_expands="false" input_width="100"/>
				<isee:dropdown_input color="black" background="white" font_size="12pt" label_side="left" wrap_title="true" input_expands="false" input_width="100"/>
				<switch color="black" background="#E0E0E0" font_size="12pt" label_side="top" wrap_title="true" isee:appearance="switch" isee:on_color="green"/>
				<options color="black" background="white" appearance="radio-buttons" arrangement="vertical"/>
				<graphical_input color="black" background="#E0E0E0" font_size="12pt" isee:show_hover_tip="true"/>
				<group_input color="black" background="#E0E0E0" font_size="12pt"/>
				<lamp color="black" background="white" font_size="9pt"/>
				<gauge color="black" background="white" font_size="9pt" needle_color="#F09F72" bar_color="#EEEEEE" bar_progress_color="black" appearance="radial" num_major_ticks="11" num_minor_ticks="11" show_numeric_value="true"/>
				<isee:spatial_map color="black" background="white" font_size="12pt"/>
				<isee:animation_object color="black" background="white" font_size="12pt"/>
				<isee:navigation_widget color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt" padding="6 8" border_color="#999999" border_width="thin" border_style="solid" item_spacing="6" appearance="tabs" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				<isee:shape color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt" border_width="thin" border_style="solid" opacity="1" transparent_background="true" corner_radius="1"/>
				<isee:selector color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<isee:iframe color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt" border_width="thin" border_style="solid"/>
				<isee:financial_table color="black" background="#E0E0E0" text_align="right" font_size="12pt" hide_border="false" auto_fit="true" first_column_width="250" other_column_width="100" header_font_style="normal" header_font_weight="bold" header_text_decoration="none" header_text_align="center" header_vertical_text_align="center" header_font_color="black" header_font_family="Arial" header_font_size="14pt" header_text_padding="2" header_text_border_color="black" header_text_border_width="thin" header_text_border_style="none"/>
			</style>
			<view isee:show_pages="false" background="white" page_width="1024" page_height="784" isee:page_cols="2" isee:page_rows="3" isee:scroll_x="7.5" isee:scroll_y="311.25" zoom="160" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
				<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
					<stock color="blue" background="white" font_color="blue" font_size="11pt" label_side="top">
