			<aux name="expenditure on subsidies for investments in\ncoal energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Including Taxes Paid and Subsidies Received in Energy Conversion Capital" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run] +  tax_revenue_on_investments_in_coal_energy_conversion[Run] -
expenditure_on_subsidies_for_investments_in_coal_energy_conversion[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\ncoal energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nSolar\nenergy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in wind">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of margins on\ninvestment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_margins[Run]-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="average energy margins" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nwind\nenergy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.158464377889841</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in Solar">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.013519257868552</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Wind Investments Including\nTaxes Paid and Subsidies Received" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity[Run] +
tax_revenue_on_investments_in_wind_energy_capacity[Run] - expenditure_on_subsidies_for_investments_in_wind_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="relative margins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_energy_supply_margins[Run]/initial_perceived_marginal_energy_supply_cost[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="tax revenue on investments in\nwind energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nSolar\nEnergy Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Solar]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\nSolar energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 9" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 8" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Solar Investments Including\nTaxes Paid and Subsidies Received" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run] +  tax_revenue_on_investments_in_Solar_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_Solar_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nwind\nEnergy Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Wind]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Nuclear Investments Including\nTaxes Paid and\nSubsidies Received" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity[Run] +
tax_revenue_on_investments_in_nuclear_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_nuclear_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="time to perceive energy supply missmatch">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="Hydropower Investments Including\nTaxes Paid and\nSubsidies Received" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run] +
tax_revenue_on_investments_in_hydropower_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_hydropower_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in\nEnergy Conversion Capital" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Energy_Capital[Run] +
tax_revenue_on_investments_in_gas_energy_conversion_1[Run] -
expenditure_on_subsidies_for_investments_in_gas_energy_conversion[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="cost perception time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid and Subsidies Received in\nEnergy Conversion Capital" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital[Run] +
tax_revenue_on_investments_in_oil_energy_conversion[Run] -
expenditure_on_subsidies_for_investments_in_oil_energy_conversion[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\nnuclear energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\nhydropower energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\ngas energy conversion 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\noil energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nnuclear energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="average marginal\nnet cost of energy without historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>( Cost_of_Extra_Energy_Output_through_Capital_per_Unit* Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2* Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_1* Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]
+
Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8* Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run]
+
Cost_of_Extra_Energy_Output_through_Capital_per_Unit_9* Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4* Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6* Investments_in_Nuclear_Capacity[Run]
)
/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nhydropower energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="output" throughput="true">
				<eqn>2050</eqn>
				<units>Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\ngas energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="ELECTRICITY average marginal\nnet cost of energy with\nhistorical cost adjustment" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
adjusted_cost[Run,Coal_energy_conversion] * Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]
+ adjusted_cost[Run,Oil_energy_conversion] * Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]
+ adjusted_cost[Run,Gas_energy_conversion] * Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]
+ adjusted_cost[Run,Hydropower] * Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]
+ 
adjusted_cost[Run,Nuclear] * Investments_in_Nuclear_Capacity[Run]
+ adjusted_cost[Run,Solar]
*Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity
+ adjusted_cost[Run,Wind]
*Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity
)
/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="tax revenue on investments in\noil energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross\nInvestments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Oil_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="baseline energy investments" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>74600948348.1848</eqn>
				<range min="100000000000" max="1000000000000"/>
				<units>c$/Year</units>
			</aux>
			<aux name="pct of history">
				<eqn>(TIME-STARTTIME)/(2020-STARTTIME)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial relative supply missmatch">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0119480789089314</eqn>
				<range min="-0.5" max="0.5"/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment smoothing time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.5</eqn>
				<range min="0.25" max="0.75"/>
				<units>years</units>
			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>MAX(1e-12, cost_to_build_per_unit[Run,EnergySourceEle]*interpolated_historical_cost_adjustment[Run,EnergySourceEle])</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Gas Gross\nInvestments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Gas_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Coal_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Missmatch[Run]-Relative_Energy_Supply_Mismatch_Buffer[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost[Run,EnergySourceEle]*investment_priority_adjustment_from_stranded_capital_1)</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="raw adaptive\nchange in investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor[Run]*
Relative_Energy_Supply_Mismatch_with_Buffer[Run] +

adaptive_energy_investments_integrating_factor[Run] * Cumulative_Relative_Energy_Supply_Missmatch[Run] +

adaptive_energy_investments_differntiating_factor[Run] * Differentiating_Relative_Energy_Supply_Missmatch[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive change\nin investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy, gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Gross Energy Expenditure\ninvested in fossil energy, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 4" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="desired investment\nby source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]
-
(IF (EnergySourceEle = EnergySourceEle.Coal_energy_conversion
OR EnergySourceEle = EnergySourceEle.Oil_energy_conversion 
OR EnergySourceEle = EnergySourceEle.Gas_energy_conversion ) AND TIME &gt; Moratorium_on_fossil_energy_year THEN
Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost to build\nper unit">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>IF EnergySourceEle = EnergySourceEle.Coal_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit[Run]
ELSE IF EnergySourceEle = EnergySourceEle.Oil_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2[Run]
ELSE IF EnergySourceEle = EnergySourceEle.Gas_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_1[Run]
ELSE IF EnergySourceEle = EnergySourceEle.Solar THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8[Run]
ELSE IF EnergySourceEle = EnergySourceEle.Wind THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_9[Run]
ELSE IF EnergySourceEle = EnergySourceEle.Hydropower THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4[Run]
ELSE IF EnergySourceEle = EnergySourceEle.Nuclear THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6[Run]
ELSE NAN</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="priority spread">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>33.4346914588317</eqn>
				<range min="10" max="50"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{TREND(Relative_Energy_Supply_Mismatch_with_Buffer, 1, initial_differentiated_relative_energy_supply_missmatch)}
{IF TIME &lt; STARTTIME+1 THEN
initial_differentiated_relative_energy_supply_missmatch 
ELSE
(Relative_Energy_Supply_Mismatch_with_Buffer-HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-1))/1}
DERIVN(Relative_Energy_Supply_Mismatch_with_Buffer[Run], 1)</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-2.3319332319455</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in hydropower">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Energy Investment Allocated\nto Capacity Construction\nfor Electricity" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(baseline_energy_investments[Run]*adaptive_change_in_investments[Run], 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Investments in\nNuclear Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Nuclear]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 6" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="investment by\nsource">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>ALLOCATE(Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run], EnergySourceEle, desired_investment_by_source[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in nuclear energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction_for_Electricity[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments proportional factor">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-10.0862977296706</eqn>
				<range min="-50" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-4.15270007361085</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="perceived energy supply\nmargins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins[Run], cost_perception_time[Run], initial_perceived_marginal_energy_supply_cost[Run])</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nHydropower\nEnergy capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Hydropower]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="interpolated historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>SMTH1(INTERPOLATE(historical_cost_adjustment[Run,EnergySourceEle,*], pct_of_history), historical_cost_adjustment_smoothing_time[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="investment priority adjustment\nfrom stranded capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
		</variables>
