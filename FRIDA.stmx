	</model>
	<model name="Energy_demand_1" run="true">
		<variables>
			<aux name="CDD" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>CDD_historical+CDD_linear_coefficient*Surface_Temperature_Anomaly</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD_historical*EXP(HDD_exponential_coefficient*Surface_Temperature_Anomaly)</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="CDD linear coefficient">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>287.8469604</eqn>
				</element>
				<range min="230" max="330"/>
				<units>CDD/(deg C*p*Year)</units>
			</aux>
			<aux name="CDD historical">
				<doc>${Climate Impact Parameter,External Parameter}
Based on GCM output of the past</doc>
				<eqn>704.2162675</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD historical">
				<doc>${Climate Impact Parameter,External Parameter}
Based on GCM output of the past</doc>
				<eqn>1375.71022</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="HDD exponential coefficient">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-0.232561095</eqn>
				</element>
				<range min="-0.5" max="-0.01"/>
				<units>1/(deg C)</units>
			</aux>
			<aux name="CDD change to preindustrial">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>CDD-CDD_preindustrial</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="CDD preindustrial" access="output" isee:autocreated="true">
				<eqn>CDD_historical</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD preindustrial">
				<eqn>HDD_historical</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="HDD change to preindustrial">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD-HDD_preindustrial</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="Change in energy used for Heating due to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD_change_to_preindustrial*Energy_use_per_HDD</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Energy use per HDD">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.002</eqn>
				</element>
				<range min="0.0001" max="0.01"/>
				<units>GJ/(HDD)</units>
			</aux>
			<aux name="energy use per CDD">
				<doc>${Climate Impact Parameter,External Parameter}
	Calibrated To Rode	Calibrated To Clark
1980	0.000875	0.007
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.000875</eqn>
				</element>
				<range min="0.0004" max="0.01"/>
				<units>GJ/(CDD)</units>
			</aux>
			<aux name="Change in energy used for\ncooling due to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>energy_use_per_CDD*CDD_change_to_preindustrial</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Change in energy used for\ncooling due to climate change in MWh" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>UNIT_GJ_to_MWh*Change_in_energy_used_for_cooling_due_to_climate_change</eqn>
				<units>MWh/(Person*Year)</units>
			</aux>
			<aux name="Change in energy used for\nHeating due to climate change in MWh">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>UNIT_GJ_to_MWh*Change_in_energy_used_for_Heating_due_to_climate_change</eqn>
				<units>MWh/(Person*Year)</units>
			</aux>
			<aux name="total change in energy used for\nheating and cooling\ndue to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF (switch_energy_damage=0) AND TIME &gt; today THEN
(Change_in_energy_used_for_Heating_due_to_climate_change_in_MWh + Change_in_energy_used_for_cooling_due_to_climate_change_in_MWh
)*Population*Converter_2
ELSE
0</eqn>
				<units>MWh/year</units>
			</aux>
			<aux name="total change in energy used for\nheating and cooling\ndue to climate change in GJ">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Change_in_energy_used_for_Heating_due_to_climate_change + Change_in_energy_used_for_cooling_due_to_climate_change</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Surface Temperature Anomaly" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>deg C</units>
			</aux>
			<aux name="today" access="input">
				<eqn>2025</eqn>
				<units>year</units>
			</aux>
			<aux name="switch energy damage" access="input">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="UNIT GJ to MWh" access="input">
				<eqn>0.277778</eqn>
				<units>MWh/GJ</units>
			</aux>
			<aux name="effect of GDP on Liquid fuel demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>alpha_effect_of_GDP_on_Liquid_fuel_demand_for_Buildings*relative_global_real_GDP_in_2021^(beta_effect_of_GDP_on_Liquid_fuel_demand_for_Buildings)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="C effect of GDP on Solid fuel demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-7.82486185196511</eqn>
				<range min="-15" max="5"/>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity demand for\nTransport">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_Electricity_demand_for_Transportation*normal_electricity_demand_for_Transportation*effect_of_energy_prices_on_electricity_demand_for_Transportation</eqn>
				<units>MWh/year</units>
			</aux>
			<aux name="effect of GDP on\nSolid fuel demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>A_effect_of_GDP_on_Solid_fuel_demand_for_Transportation[Run]*relative_global_real_GDP_in_2021[Run]^3+B_effect_of_GDP_on_Solid_fuel_demand_for_Transportation[Run]*relative_global_real_GDP_in_2021[Run]^2+C_effect_of_GDP_on_Solid_fuel_demand_for_Transportation[Run]*relative_global_real_GDP_in_2021[Run]+D_effect_of_GDP_on_Solid_fuel_demand_for_Transportation[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal electricity demand\nfor Transportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>311248469.63826</eqn>
				<range min="100000000" max="500000000"/>
				<units>MWh/year</units>
			</aux>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>bc$/year</units>
			</aux>
			<aux name="relative global\nreal GDP in 2021">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Converter_1/INIT(Converter_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="per person energy demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF(switch_energy_demand_policy= 0 OR TIME &lt; Policy_Start_Year) THEN
demand_for_energy/Population
ELSE
per_person_use_of_energy_policy</eqn>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="effect\nof energy prices on electricity\ndemand for Transportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+((EXP(relative_change_in_energy_prices_in_electricity-1)-1)*sensitivity_of_effect_of_energy_prices_on_electricity_demand_for_Transportation)*Switch_for_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect\nof energy prices on\nelectricity demand for Transportation">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.00746363428908965</eqn>
				<range min="0.001" max="0.01"/>
				<units>dmnl</units>
			</aux>
			<aux name="beta effect of GDP on Liquid fuel demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0405127914073443</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="D effect of GDP on Solid fuel demand for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>7.75385094038353</eqn>
				<range min="-2" max="9"/>
				<units>dmnl</units>
			</aux>
			<aux name="alpha effect of GDP on Liquid fuel demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>4.64921819386079</eqn>
				<range min="0" max="5"/>
				<units>dmnl</units>
			</aux>
			<aux name="demand for energy" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
For Calibration&gt;
This is energy demand, so consumption data would be closest. However, real consumption data can never show a demand greater than supply.
https://ourworldindata.org/grapher/fossil-fuel-primary-energy?tab=chart&amp;country=~OWID_WRL</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Bioenergy_Waste_Heat_demand+Coal_demand+Liquid_fuel_demand+Gas_demand+Electricity_demand</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="per person use of energy policy" access="input">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2100"/>
					<yscale min="5.5" max="8.5"/>
					<ypts>7.4,7.4,7.4,7.4,7.4,7.4,7.4,7.4,7.4</ypts>
				</gf>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="Policy Start Year" access="input">
				<eqn>2024</eqn>
				<units>Year</units>
			</aux>
			<aux name="switch energy demand policy" access="input">
				<eqn>0</eqn>
				<format precision="1" scale_by="auto"/>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="aggregate per unit energy prices" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(ELECTRICITY_average_marginal_net_cost_of_energy_with_historical_cost_adjustment, time_for_competition_to_change_prices, initial_aggregate_per_unit_energy_prices_electricity)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="initial aggregate per\nunit energy prices electricity" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0806897872305275</eqn>
				<range min="0.01" max="0.5"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="reference change\nin energy prices electricity" access="output" isee:autocreated="true">
