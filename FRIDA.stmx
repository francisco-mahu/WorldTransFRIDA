	</model>
	<model name="Electricity_investments" run="true">
		<variables>
			<aux name="adaptive energy\ninvestments proportional factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-10.1655394023828</eqn>
				<range min="-50" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Investments in\nNuclear Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Nuclear]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in\nHydropower\nEnergy capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Hydropower]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="World GDP">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>&quot;Real_GDP_in_2021c$&quot;*&quot;UNIT_Bc$_to_c$&quot;</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested in Renewable Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_hydropower+
share_of_GDP_invested_in_solar_and_wind+
share_of_GDP_invested_in_bio_power</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in Fossil Energy and Fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_fuel_extraction+share_of_GDP_invested_in_fossil_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in Energy" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_Fossil_Energy_and_Fuel+share_of_GDP_invested_in_Renewable_Energy+share_of_GDP_invested_in_nuclear_power</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin Energy without fuel" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_Energy-share_of_GDP_invested_in_fossil_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in nuclear energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in hydropower">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Hydropower_Energy_capacity/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure invested in fuel extraction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin nuclear power">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin hydropower">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Hydropower_Energy_capacity/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin solar and wind">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Gross_Investments_in_Solar_Energy_Capacity+Gross_Investments_in_wind_Energy_Capacity)/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin fuel extraction" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="All Gross Energy Investments" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX((Baseline_of_investments[Run]*Share_of_Baseline_Investments[Run])*adaptive_change_in_investments*effect_of_margins_on_investment, 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Renewables" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_wind_Energy_Capacity+Gross_Investments_in_Hydropower_Energy_capacity+Gross_Investments_in_Biofuel_Capacity+Gross_Investments_in_Solar_Energy_Capacity</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments in Fossil Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital+Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-2.94139701240817</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-3.9095794010327</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{TREND(Relative_Energy_Supply_Mismatch_with_Buffer, 1, initial_differentiated_relative_energy_supply_missmatch)}
{IF TIME &lt; STARTTIME+1 THEN
initial_differentiated_relative_energy_supply_missmatch 
ELSE
(Relative_Energy_Supply_Mismatch_with_Buffer-HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-1))/1}
DERIVN(Relative_Energy_Supply_Mismatch_with_Buffer, 1)</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Share of Gross Energy Expenditure\ninvested in fuel\nextraction, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Gross Energy Expenditure\ninvested in fossil energy, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy, gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gross Investments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital+Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital+Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Fossil\nEnergy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Energy_Capital+Oil_Gross_Investments_in_Fossil_Energy_Capital+Gas_Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Fossil\nEnergy Capital oil and gas" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital+Gas_Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive change\nin investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investment_replacement{MAX(0, raw_adaptive_change_in_investments)}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor*
Relative_Energy_Supply_Mismatch_with_Buffer +

adaptive_energy_investments_integrating_factor * Cumulative_Relative_Energy_Supply_Missmatch +

adaptive_energy_investments_differntiating_factor * Differentiating_Relative_Energy_Supply_Missmatch</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment by\nsource">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>ALLOCATE(All_Gross_Energy_Investments[Run], EnergySource, desired_investment_by_source[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="cost to build\nper unit">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>IF EnergySource = EnergySource.Oil_fuel_extraction THEN 
cost_of_extra_energy_output_through_fuel_extraction_per_unit[Run]
ELSE IF EnergySource = EnergySource.Oil_energy_conversion THEN 
Cost_of_Extra_Energy_Output_through_Capital_per_Unit[Run]
ELSE IF EnergySource = EnergySource.Coal_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2[Run]
ELSE IF EnergySource = EnergySource.Gas_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_1[Run]
ELSE IF EnergySource = EnergySource.Bio THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8[Run]
ELSE IF EnergySource = EnergySource.Hydropower THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_9[Run]
ELSE IF EnergySource = EnergySource.Solar THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4[Run] 
ELSE IF EnergySource = EnergySource.Nuclear THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6[Run]
ELSE IF EnergySource = EnergySource.Coal_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_2[Run]
ELSE IF EnergySource = EnergySource.Gas_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_1[Run]
ELSE IF EnergySource = EnergySource.Wind THEN 
Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7[Run]
ELSE NAN</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>35.2002218346642</eqn>
				<range min="10" max="50"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="desired investment\nby source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>All_Gross_Energy_Investments[Run]
-
(IF (EnergySource = EnergySource.Coal_fuel_extraction 
OR EnergySource = EnergySource.Oil_fuel_extraction
OR EnergySource = EnergySource.Gas_fuel_extraction 
OR EnergySource = EnergySource.Coal_energy_conversion
OR EnergySource = EnergySource.Oil_energy_conversion 
OR EnergySource = EnergySource.Gas_energy_conversion ) AND TIME &gt; Moratorium_on_fossil_energy_year THEN
All_Gross_Energy_Investments[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost*investment_priority_adjustment_from_stranded_capital)</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="cost of extra energy output through fuel extraction per unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 4" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 6" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Coal Gross Investments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Coal_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Gross Investments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Coal_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross\nInvestments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Oil_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Gross\nInvestments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Gas_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Baseline Investments" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.117543982652961</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<stock name="cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="Acc Cum Rel En Sup Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer/time_to_perceive_energy_supply_missmatch</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="initial relative supply missmatch" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.035037846735034</eqn>
				<range min="-0.5" max="0.5"/>
				<units>dmnl</units>
			</aux>
