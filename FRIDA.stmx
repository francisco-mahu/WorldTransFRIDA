				<aux label_side="right" x="887.667" y="662" name="Wind Energy\nFull Load Hours"/>
				<stock x="555.71" y="431.253" width="51.4286" height="83.5714" name="Wind Energy\nInstalled Capacity"/>
				<flow x="458.14" y="479.553" name="Renewable Energy\nCapacity Construction">
					<pts>
						<pt x="360.57" y="479.553"/>
						<pt x="555.71" y="479.553"/>
					</pts>
				</flow>
				<flow x="650.139" y="433.503" name="Renewable Energy Capacity Vintage Aging Out">
					<pts>
						<pt x="607.139" y="433.503"/>
						<pt x="717.14" y="433.503"/>
