						<pt x="202" y="240"/>
						<pt x="125.5" y="240"/>
					</pts>
				</flow>
				<aux x="157.75" y="149.333" name="Relative Energy\nSupply Missmatch"/>
				<connector uid="2" angle="90">
					<from>Energy_Supply_Missmatch</from>
					<to>Relative_Energy_Supply_Missmatch</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="29.4545" y="264.792" name="UNIT zJ to TWh"/>
				<connector uid="4" angle="326.009">
					<from>UNIT_zJ_to_TWh</from>
					<to>Energy_Supply_Missmatch</to>
				</connector>
				<connector uid="5" angle="99.2754">
					<from>UNIT_zJ_to_TWh</from>
					<to>Relative_Energy_Supply_Missmatch</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="298.231" y="410.846" name="Gas demand for electricity generation"/>
				<aux background="#FFAAFF" x="226.538" y="320.769" name="total gas fuel demand"/>
				<connector uid="10" angle="131.853">
					<from>Gas_demand_for_electricity_generation</from>
					<to>total_gas_fuel_demand</to>
				</connector>
				<connector uid="11" angle="130.42">
					<from>total_gas_fuel_demand</from>
					<to>Energy_Supply_Missmatch</to>
				</connector>
				<connector uid="12" angle="55.3004">
					<from>total_gas_fuel_demand</from>
					<to>Energy_Balance</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="139.75" y="410.846" name="Gas demand FUEL"/>
				<connector uid="13" angle="43.4607">
					<from>Gas_demand_FUEL</from>
					<to>total_gas_fuel_demand</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="244.538" y="68" name="Primary Fossil Energy\nFUEL 1"/>
				<connector uid="14" angle="227.999">
					<from>Primary_Fossil_Energy_FUEL_1</from>
					<to>Relative_Energy_Supply_Missmatch</to>
				</connector>
				<connector uid="15" angle="242.355">
					<from>Primary_Fossil_Energy_FUEL_1</from>
					<to>Energy_Supply_Missmatch</to>
				</connector>
				<connector uid="16" angle="278.03">
					<from>Primary_Fossil_Energy_FUEL_1</from>
					<to>Energy_Balance</to>
				</connector>
			</view>
		</views>
	</model>
	<model name="Liquid_fuel_supply_vs_demand" run="true">
		<variables>
			<aux name="Energy Balance" access="output">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn> (Primary_Fossil_Energy_FUEL+bio_fuel_primary_energy)/(total_liquid_fuel_demand)</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Cumulative Deviations of Energy Balance from 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Deviations_from_one_in_Energy_Balance</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="Deviations from one in Energy Balance">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((1-Energy_Balance)^2)/DT</eqn>
				<non_negative/>
				<units>dmnl/year</units>
			</flow>
			<stock name="Cumulative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Energy_Supply_Missmatch</inflow>
				<units>TWh</units>
			</stock>
			<flow name="Energy Supply\nMissmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((Primary_Fossil_Energy_FUEL+bio_fuel_primary_energy)-(total_liquid_fuel_demand))*UNIT_zJ_to_TWh</eqn>
				<units>TWh/Year</units>
			</flow>
			<aux name="Relative Energy\nSupply Missmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Energy_Supply_Missmatch/UNIT_zJ_to_TWh)/(Primary_Fossil_Energy_FUEL+bio_fuel_primary_energy)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="UNIT zJ to TWh" access="input">
				<eqn>277777.7778</eqn>
				<units>TWh/zJ</units>
			</aux>
			<aux name="Oil demand for electricity generation" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy FUEL" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="total liquid fuel demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((Oil_demand_for_electricity_generation*Share_from_electricity_generation)+(Liquid_Fuel_demand_FUEL*Share_from_demand))*Overall_share</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="share of biofuel\nin total liquid fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>bio_fuel_primary_energy/(Primary_Fossil_Energy_FUEL[1]+bio_fuel_primary_energy)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share from electricity generation">
				<eqn>1</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Overall share">
				<eqn>1</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Share from demand">
				<eqn>1</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Liquid Fuel demand\nFUEL" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="bio fuel primary energy" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
		</variables>
