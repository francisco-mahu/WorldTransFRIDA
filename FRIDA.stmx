				<aux x="368.34" y="571.72" name="perceived energy supply\nmargins 2"/>
				<aux color="blue" background="#55AA00" x="489.86" y="999.61" name="adaptive energy\ninvestments\nproportional factor"/>
				<aux color="blue" background="#55AA00" label_side="bottom" x="231.515" y="320.72" name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment 2"/>
