				<aux background="#00AA00" x="393.67" y="669.55" name="cost perception time"/>
				<aux x="386.17" y="850.23" name="Relative Energy Supply\nMismatch Buffer"/>
				<aux x="826.5" y="1000.45" name="time to perceive energy\nsupply missmatch"/>
				<aux background="#FFAAFF" label_side="bottom" x="788.85" y="221.84" name="Coal Investments Allocated to Capacity Construction in Fossil\nFuel Extraction\nCapital for Direct use"/>
