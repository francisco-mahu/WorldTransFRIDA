				</connector>
				<aux font_style="italic" font_weight="bold" x="1198.66" y="905.8" name="Relative Energy\nSupply Missmatch"/>
				<connector uid="206" angle="329.688">
					<from>Relative_Energy_Supply_Missmatch</from>
					<to>Perceived_Energy_missmatch_in_fuel</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="1703.33" y="905.8" name="Relative Energy\nSupply Missmatch 2"/>
				<connector uid="207" angle="210.687">
					<from>Relative_Energy_Supply_Missmatch_2</from>
					<to>Perceived_Energy_missmatch_in_electricity</to>
				</connector>
				<connector uid="208" angle="336.571">
