				<aux color="black" font_color="black" x="870.16" y="693.917" name="Fossil Energy Capital\nOrders of Mag Scale"/>
				<aux color="black" font_color="black" label_side="bottom" x="351.512" y="946.118" name="carbon intensity in btu"/>
				<aux color="black" font_style="italic" font_weight="bold" font_color="black" x="338.669" y="882.118" name="Qbtu to zJ"/>
				<aux color="black" font_color="black" x="418.65" y="900.118" name="Carbon Intensity"/>
				<connector uid="4" angle="347.317">
					<from>Qbtu_to_zJ</from>
