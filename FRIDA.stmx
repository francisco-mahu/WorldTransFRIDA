					<to>Primary_Fossil_Energy_FUEL_by_type</to>
				</connector>
				<connector uid="195" angle="125.201">
					<from>time_to_perceive_changes_in_investment</from>
					<to>Perceived_Energy_missmatch_in_fuel</to>
				</connector>
				<connector uid="196" angle="78.4465">
					<from>Perceived_Energy_missmatch_in_fuel</from>
					<to>energy_carrier_missmatch</to>
				</connector>
				<connector uid="197" angle="88.3153">
					<from>Perceived_Energy_missmatch_in_electricity</from>
					<to>energy_carrier_missmatch</to>
				</connector>
				<aux background="#55AA00" x="1312.23" y="1017.96" name="initial energy supply missmatch in fuel"/>
				<aux background="#55AA00" x="1588.96" y="1017.96" name="initial energy supply\nmissmatch for electricity"/>
				<connector uid="198" angle="84.5132">
					<from>initial_energy_supply_missmatch_in_fuel</from>
					<to>Perceived_Energy_missmatch_in_fuel</to>
				</connector>
				<connector uid="199" angle="91.5432">
					<from>initial_energy_supply_missmatch_for_electricity</from>
					<to>Perceived_Energy_missmatch_in_electricity</to>
				</connector>
				<aux x="1294.23" y="565.857" name="Backstop allocation"/>
				<aux x="1067.17" y="738.5" name="Primary Fossil Energy FUEL 95%"/>
				<connector uid="200" angle="217.246">
					<from>Backstop_allocation</from>
					<to>&quot;Primary_Fossil_Energy_FUEL_95%&quot;</to>
				</connector>
				<connector uid="201" angle="21.9634">
					<from>&quot;Primary_Fossil_Energy_FUEL_95%&quot;</from>
					<to>Primary_Fossil_Energy_FUEL_by_type</to>
				</connector>
				<connector uid="202" angle="0">
					<from>&quot;Primary_Fossil_Energy_FUEL_95%&quot;</from>
