	</model>
	<model name="Liquid_fuel_investments" run="true">
		<variables>
			<aux name="adaptive energy\ninvestments proportional factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-10.339204324626</eqn>
				<range min="-50" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure invested in fuel extraction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="All Gross Energy Investments" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX((Baseline_of_investments[Run]*Share_of_baseline_investments[Run])*adaptive_change_in_investments*effect_of_margins_on_investment, 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments in Fossil Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital+Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-3.55087545090569</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-4.40741238358796</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{TREND(Relative_Energy_Supply_Mismatch_with_Buffer, 1, initial_differentiated_relative_energy_supply_missmatch)}
{IF TIME &lt; STARTTIME+1 THEN
initial_differentiated_relative_energy_supply_missmatch 
ELSE
(Relative_Energy_Supply_Mismatch_with_Buffer-HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-1))/1}
DERIVN(Relative_Energy_Supply_Mismatch_with_Buffer, 1)</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fuel extraction, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gross Investments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Fossil\nEnergy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive change\nin investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor*
Relative_Energy_Supply_Mismatch_with_Buffer +

adaptive_energy_investments_integrating_factor * Cumulative_Relative_Energy_Supply_Missmatch +

adaptive_energy_investments_differntiating_factor * Differentiating_Relative_Energy_Supply_Missmatch</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment by\nsource">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>ALLOCATE(All_Gross_Energy_Investments[Run], EnergySourceLiquid, desired_investment_by_source[Run,*],  priority_by_source[Run, *], priority_spread[Run], shape)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="cost to build\nper unit">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>IF EnergySourceLiquid = EnergySourceLiquid.Oil_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_2[Run]
ELSE IF EnergySourceLiquid = EnergySourceLiquid.Oil_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2[Run]
ELSE IF EnergySourceLiquid = EnergySourceLiquid.Bio THEN Converter_1[Run]
ELSE 
1e12</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>26.6651377416311</eqn>
				<range min="10" max="50"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="desired investment\nby source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>All_Gross_Energy_Investments[Run]
-
(IF ((EnergySourceLiquid = EnergySourceLiquid.Oil_fuel_extraction
OR EnergySourceLiquid = EnergySourceLiquid.Oil_energy_conversion) AND TIME &gt; Moratorium_on_fossil_energy_year ) 
THEN
All_Gross_Energy_Investments[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost*investment_priority_adjustment_from_stranded_capital_2[Run,EnergySourceLiquid])</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="cost of extra energy output through fuel extraction per unit 2" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Oil Gross\nInvestments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Oil_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross\nInvestments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Oil_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of baseline investments" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0136967008050896</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<stock name="cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="Acc Cum Rel En Sup Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer/time_to_perceive_energy_supply_missmatch</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="initial relative supply missmatch" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0392384244394393</eqn>
				<range min="-0.5" max="0.5"/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
					<dim name="Historical_5yr_time_steps"/>
				</dimensions>
				<element subscript="1, Oil_fuel_extraction, 1">
					<eqn>0.0960016494550079</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 2">
					<eqn>0.0749256575482665</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 3">
					<eqn>0.0945993765624872</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 4">
					<eqn>0.103797648557862</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 5">
					<eqn>0.0934491514699562</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 6">
					<eqn>0.133268822368641</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 7">
					<eqn>0.13354161989699</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 8">
					<eqn>0.122623063664336</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 9">
					<eqn>0.154711722805577</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 1">
					<eqn>0.0900475437555007</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 2">
					<eqn>0.0876638948194362</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 3">
					<eqn>0.102030590728086</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 4">
					<eqn>0.115806478831539</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 5">
					<eqn>0.0794824781786595</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 6">
					<eqn>0.14155366324684</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 7">
					<eqn>0.163053231856056</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 8">
					<eqn>0.121116491330703</eqn>
				</element>
				<element subscript="1, Oil_energy_conversion, 9">
					<eqn>0.140037254496382</eqn>
				</element>
				<element subscript="1, Bio, 1">
					<eqn>0.392926900390214</eqn>
				</element>
				<element subscript="1, Bio, 2">
					<eqn>0.44248068931048</eqn>
				</element>
				<element subscript="1, Bio, 3">
					<eqn>0.735183542942099</eqn>
				</element>
				<element subscript="1, Bio, 4">
					<eqn>0.77628373079638</eqn>
				</element>
				<element subscript="1, Bio, 5">
					<eqn>0.751692451074343</eqn>
				</element>
				<element subscript="1, Bio, 6">
					<eqn>0.470315470920013</eqn>
				</element>
				<element subscript="1, Bio, 7">
					<eqn>0.275691329756707</eqn>
				</element>
				<element subscript="1, Bio, 8">
					<eqn>0.350127763769876</eqn>
				</element>
				<element subscript="1, Bio, 9">
					<eqn>0.426326639224546</eqn>
				</element>
				<range min="0.05" max="4"/>
				<units>dmnl</units>
			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>MAX(1e-12, cost_to_build_per_unit[Run,EnergySourceLiquid]*interpolated_historical_cost_adjustment[Run,EnergySourceLiquid])</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="pct of history">
				<eqn>(TIME-STARTTIME)/(2020-STARTTIME)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="interpolated historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>SMTH1(INTERPOLATE(historical_cost_adjustment[Run,EnergySourceLiquid,*], pct_of_history), historical_cost_adjustment_smoothing_time[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment smoothing time" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.495675191017048</eqn>
				<range min="0.25" max="0.75"/>
				<units>years</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Missmatch-Relative_Energy_Supply_Mismatch_Buffer</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="Total Gross Investments in Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital + Gross_Investments_in_Fossil_Fuel_Extraction_Capital+Gross_Investments_in_Biofuel_Capacity</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="input">
				<eqn>2050</eqn>
				<units>Year</units>
			</aux>
			<aux name="average marginal\nnet cost of energy without historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
cost_of_extra_energy_output_through_fuel_extraction_per_unit_2 * Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2 * Oil_Gross_Investments_in_Fossil_Energy_Capital
)
/Total_Gross_Investments_in_Energy</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="average marginal\nnet cost of energy with historical cost adjustment" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>( adjusted_cost[Run,Oil_fuel_extraction] * Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital
+ 
adjusted_cost[Run,Oil_energy_conversion] * Oil_Gross_Investments_in_Fossil_Energy_Capital
)
/Total_Gross_Investments_in_Energy</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\noil extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\noil energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\noil extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\noil energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Net Investments in\nEnergy Conversion Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>expenditure_on_subsidies_for_investments_in_oil_energy_conversion + tax_revenue_on_investments_in_oil_energy_conversion + Oil_Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Net Investments in Fossil\nFuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>expenditure_on_subsidies_for_investments_in_oil_extraction + tax_revenue_on_investments_in_oil_extraction + Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="time to perceive energy supply missmatch">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="perceived energy supply\nmargins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins, cost_perception_time, initial_perceived_marginal_energy_supply_cost)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost perception time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="effect of margins on\ninvestment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_margins-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.132482536660036</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="average energy margins" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="relative margins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_energy_supply_margins/initial_perceived_marginal_energy_supply_cost</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.00811677609676807</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Baseline of investments" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>857228000000{ + RAMP(2.5e10)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="investment priority adjustment\nfrom stranded capital 2" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gross Investments in\nBiofuel Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Bio]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in bio energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Biofuel_Capacity/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nbio fuel energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\nbio fuel energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Net Investments in\nBiofuel Capacity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>expenditure_on_subsidies_for_investments_in_bio_fuel_energy_capacity + tax_revenue_on_investments_in_bio_fuel_energy_capacity + Gross_Investments_in_Biofuel_Capacity</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$*Years/kWh</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
