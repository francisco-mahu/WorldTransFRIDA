	</model>
	<model name="Energy_supply_vs_demand_1" run="true">
		<variables>
			<module name="Electricity supply vs\ndemand" isee:label="">
				<format scale_by="auto"/>
				<connect to="Electricity_investments.Relative_Energy_Supply_Missmatch" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Electricity_investments.Relative_Energy_Supply_Missmatch" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Fossil_energy_coal_1.Relative_Energy_Supply_Missmatch" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Fossil_energy_coal_1.Relative_Energy_Supply_Missmatch" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Fossil_energy_gas_1.Relative_Energy_Supply_Missmatch_2" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Fossil_energy_gas_1.Relative_Energy_Supply_Missmatch_2" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Fossil_energy_oil_1.Relative_Energy_Supply_Missmatch_2" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Fossil_energy_oil_1.Relative_Energy_Supply_Missmatch_2" from="Electricity_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Electricity_supply_vs_demand.Electricity_demand" from="Energy_demand_1.Electricity_demand"/>
				<connect2 to="Electricity_supply_vs_demand.Electricity_demand" from="Energy_demand_1.Electricity_demand"/>
				<connect to="Electricity_supply_vs_demand.Energy_output_electricity_1" from="Energy_supply_1.Energy_output_electricity"/>
				<connect2 to="Electricity_supply_vs_demand.Energy_output_electricity_1" from="Energy_supply_1.Energy_output_electricity"/>
			</module>
			<module name="Liquid fuel supply vs\ndemand" isee:label="">
				<format scale_by="auto"/>
				<connect to="Fossil_energy_oil_1.Relative_Energy_Supply_Missmatch" from="Liquid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Fossil_energy_oil_1.Relative_Energy_Supply_Missmatch" from="Liquid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Liquid_fuel_investments.Relative_Energy_Supply_Missmatch_1" from="Liquid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Liquid_fuel_investments.Relative_Energy_Supply_Missmatch_1" from="Liquid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Liquid_fuel_supply_vs_demand.bio_fuel_primary_energy" from="Bio_fuel_energy_1.bio_fuel_primary_energy"/>
				<connect2 to="Liquid_fuel_supply_vs_demand.bio_fuel_primary_energy" from="Bio_fuel_energy_1.bio_fuel_primary_energy"/>
				<connect to="Liquid_fuel_supply_vs_demand.Liquid_Fuel_demand_FUEL" from="Energy_demand_1.Liquid_Fuel_demand_FUEL"/>
				<connect2 to="Liquid_fuel_supply_vs_demand.Liquid_Fuel_demand_FUEL" from="Energy_demand_1.Liquid_Fuel_demand_FUEL"/>
				<connect to="Liquid_fuel_supply_vs_demand.Oil_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Liquid_fuel_demand_for_electricity_generation"/>
				<connect2 to="Liquid_fuel_supply_vs_demand.Oil_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Liquid_fuel_demand_for_electricity_generation"/>
				<connect to="Liquid_fuel_supply_vs_demand.Primary_Fossil_Energy_FUEL" from="Fossil_energy_oil_1.Primary_Fossil_Energy_FUEL"/>
				<connect2 to="Liquid_fuel_supply_vs_demand.Primary_Fossil_Energy_FUEL" from="Fossil_energy_oil_1.Primary_Fossil_Energy_FUEL"/>
				<connect to="Liquid_fuel_supply_vs_demand.UNIT_zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
				<connect2 to="Liquid_fuel_supply_vs_demand.UNIT_zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
			</module>
			<module name="Gas supply vs\ndemand" isee:label="">
				<format scale_by="auto"/>
				<connect to="Fossil_energy_gas_1.Relative_Energy_Supply_Missmatch" from="Gas_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Fossil_energy_gas_1.Relative_Energy_Supply_Missmatch" from="Gas_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Gas_extraction_investments.Relative_Energy_Supply_Missmatch_3" from="Gas_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Gas_extraction_investments.Relative_Energy_Supply_Missmatch_3" from="Gas_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Gas_supply_vs_demand.Gas_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Gas_demand_for_electricity_generation"/>
				<connect2 to="Gas_supply_vs_demand.Gas_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Gas_demand_for_electricity_generation"/>
				<connect to="Gas_supply_vs_demand.Gas_demand_FUEL" from="Energy_demand_1.Gas_demand_FUEL"/>
				<connect2 to="Gas_supply_vs_demand.Gas_demand_FUEL" from="Energy_demand_1.Gas_demand_FUEL"/>
				<connect to="Gas_supply_vs_demand.Primary_Fossil_Energy_FUEL_1" from="Fossil_energy_gas_1.Primary_Fossil_Energy_FUEL"/>
				<connect2 to="Gas_supply_vs_demand.Primary_Fossil_Energy_FUEL_1" from="Fossil_energy_gas_1.Primary_Fossil_Energy_FUEL"/>
				<connect to="Gas_supply_vs_demand.UNIT_zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
				<connect2 to="Gas_supply_vs_demand.UNIT_zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
			</module>
			<module name="Solid fuel supply vs\ndemand" isee:label="">
				<format scale_by="auto"/>
				<connect to="Coal_extraction_investments.Relative_Energy_Supply_Missmatch_2" from="Solid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Coal_extraction_investments.Relative_Energy_Supply_Missmatch_2" from="Solid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Fossil_energy_coal_1.Relative_Energy_Supply_Missmatch_2" from="Solid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect2 to="Fossil_energy_coal_1.Relative_Energy_Supply_Missmatch_2" from="Solid_fuel_supply_vs_demand.Relative_Energy_Supply_Missmatch"/>
				<connect to="Solid_fuel_supply_vs_demand.Coal_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Coal_demand_for_electricity_generation"/>
				<connect2 to="Solid_fuel_supply_vs_demand.Coal_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Coal_demand_for_electricity_generation"/>
				<connect to="Solid_fuel_supply_vs_demand.Coal_demand_FUEL" from="Energy_demand_1.Coal_demand_FUEL"/>
				<connect2 to="Solid_fuel_supply_vs_demand.Coal_demand_FUEL" from="Energy_demand_1.Coal_demand_FUEL"/>
				<connect to="Solid_fuel_supply_vs_demand.Primary_Fossil_Energy_FUEL_3" from="Energy_supply_vs_demand_1.Primary_Fossil_Energy_FUEL_3"/>
				<connect2 to="Solid_fuel_supply_vs_demand.Primary_Fossil_Energy_FUEL_3" from="Primary_Fossil_Energy_FUEL_3"/>
				<connect to="Solid_fuel_supply_vs_demand.UNIT_zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
				<connect2 to="Solid_fuel_supply_vs_demand.UNIT_zJ_to_TWh" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
			</module>
			<aux name="Aggregate Supply">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity+(Primary_Fossil_Energy_FUEL_4+(Primary_Fossil_Energy_FUEL+bio_fuel_primary_energy)+Primary_Fossil_Energy_FUEL_3)/UNIT_TWh_to_zJ</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Aggregate Demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Coal_demand_FUEL+Liquid_Fuel_demand_FUEL+Gas_demand_FUEL+Coal_demand_for_electricity_generation+Liquid_fuel_demand_for_electricity_generation+Gas_demand_for_electricity_generation)/UNIT_TWh_to_zJ+Electricity_demand</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy Balance" access="output">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Aggregate_Supply/Aggregate_Demand</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Cumulative Deviations of Energy Balance from 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Deviations_from_one_in_Energy_Balance</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="Deviations from one in Energy Balance">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((1-Energy_Balance)^2)/DT</eqn>
				<non_negative/>
				<units>dmnl/year</units>
			</flow>
			<stock name="Cumulative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Energy_Supply_Missmatch</inflow>
				<units>TWh</units>
			</stock>
			<flow name="Energy Supply\nMissmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Aggregate_Supply-Aggregate_Demand)</eqn>
				<units>TWh/Year</units>
			</flow>
			<aux name="Relative Energy\nSupply Missmatch 1" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_Supply_Missmatch/Aggregate_Supply</eqn>
				<units>dmnl</units>
			</aux>
			<module name="Electricity generation fuel demand" isee:label="">
				<format scale_by="auto"/>
				<connect to="Energy_supply_vs_demand_1.Coal_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Coal_demand_for_electricity_generation"/>
				<connect2 to="Coal_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Coal_demand_for_electricity_generation"/>
				<connect to="Solid_fuel_supply_vs_demand.Coal_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Coal_demand_for_electricity_generation"/>
				<connect2 to="Solid_fuel_supply_vs_demand.Coal_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Coal_demand_for_electricity_generation"/>
				<connect to="Energy_supply_vs_demand_1.Gas_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Gas_demand_for_electricity_generation"/>
				<connect2 to="Gas_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Gas_demand_for_electricity_generation"/>
				<connect to="Gas_supply_vs_demand.Gas_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Gas_demand_for_electricity_generation"/>
				<connect2 to="Gas_supply_vs_demand.Gas_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Gas_demand_for_electricity_generation"/>
				<connect to="Energy_supply_vs_demand_1.Liquid_fuel_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Liquid_fuel_demand_for_electricity_generation"/>
				<connect2 to="Liquid_fuel_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Liquid_fuel_demand_for_electricity_generation"/>
				<connect to="Liquid_fuel_supply_vs_demand.Oil_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Liquid_fuel_demand_for_electricity_generation"/>
				<connect2 to="Liquid_fuel_supply_vs_demand.Oil_demand_for_electricity_generation" from="Electricity_generation_fuel_demand.Liquid_fuel_demand_for_electricity_generation"/>
				<connect to="Electricity_generation_fuel_demand.Clean_electricity" from="Energy_supply_1.Clean_electricity"/>
				<connect2 to="Electricity_generation_fuel_demand.Clean_electricity" from="Energy_supply_1.Clean_electricity"/>
				<connect to="Electricity_generation_fuel_demand.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy" from="Fossil_energy_coal_1.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy"/>
				<connect2 to="Electricity_generation_fuel_demand.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy" from="Fossil_energy_coal_1.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy"/>
				<connect to="Electricity_generation_fuel_demand.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_1" from="Fossil_energy_oil_1.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy"/>
				<connect2 to="Electricity_generation_fuel_demand.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_1" from="Fossil_energy_oil_1.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy"/>
				<connect to="Electricity_generation_fuel_demand.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_2" from="Fossil_energy_gas_1.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy"/>
				<connect2 to="Electricity_generation_fuel_demand.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy_2" from="Fossil_energy_gas_1.conversion_efficiency_of_fossil_fuels_to_secondary_fossil_energy"/>
				<connect to="Electricity_generation_fuel_demand.Converter_1" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
				<connect2 to="Electricity_generation_fuel_demand.Converter_1" from="Energy_Units_1.UNIT_zJ_to_TWh"/>
				<connect to="Electricity_generation_fuel_demand.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit" from="Fossil_energy_coal_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect2 to="Electricity_generation_fuel_demand.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit" from="Fossil_energy_coal_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect to="Electricity_generation_fuel_demand.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit_1" from="Fossil_energy_oil_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect2 to="Electricity_generation_fuel_demand.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit_1" from="Fossil_energy_oil_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect to="Electricity_generation_fuel_demand.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit_2" from="Fossil_energy_gas_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect2 to="Electricity_generation_fuel_demand.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit_2" from="Fossil_energy_gas_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect to="Electricity_generation_fuel_demand.cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit" from="Fossil_energy_coal_1.cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit"/>
				<connect2 to="Electricity_generation_fuel_demand.cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit" from="Fossil_energy_coal_1.cost_net_of_taxes_of_extra_energy_output_through_fuel_extraction_per_unit"/>
