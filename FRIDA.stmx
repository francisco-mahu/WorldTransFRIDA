				</flow>
				<aux background="#55AA00" x="951.19" y="1060.78" name="initial relative supply missmatch 3"/>
				<aux x="407.19" y="1008.86" name="Relative Energy Supply Mismatch with Buffer 3"/>
				<aux x="303.5" y="928.56" name="Relative Energy Supply Mismatch Buffer 3"/>
				<connector uid="17" angle="322.241">
					<from>Relative_Energy_Supply_Mismatch_Buffer_3</from>
					<to>Relative_Energy_Supply_Mismatch_with_Buffer_3</to>
				</connector>
				<connector uid="18" angle="10.9095">
					<from>Relative_Energy_Supply_Mismatch_with_Buffer_3</from>
					<to>Acc_Cum_Rel_En_Sup_Missmatch_3</to>
				</connector>
				<connector uid="19" angle="185.711">
					<from>Relative_Energy_Supply_Mismatch_with_Buffer_3</from>
					<to>Acc_cumulative_squared_relative_energy_supply_missmatch_3</to>
				</connector>
				<connector uid="20" angle="359.762">
					<from>Relative_Energy_Supply_Mismatch_with_Buffer_3</from>
					<to>Differentiating_Relative_Energy_Supply_Missmatch_3</to>
				</connector>
				<aux x="998.52" y="366.48" name="GAS average marginal\nnet cost of energy without\nhistorical cost adjustment"/>
				<aux x="743.83" y="1078.78" name="time to perceive energy supply missmatch 3"/>
				<connector uid="21" angle="33.0687">
					<from>time_to_perceive_energy_supply_missmatch_3</from>
					<to>Acc_Cum_Rel_En_Sup_Missmatch_3</to>
				</connector>
				<connector uid="22" angle="267.321">
					<from>Relative_Energy_Supply_Missmatch_3</from>
					<to>Relative_Energy_Supply_Mismatch_with_Buffer_3</to>
				</connector>
				<connector uid="23" angle="22.8126">
					<from>Relative_Energy_Supply_Mismatch_with_Buffer_3</from>
					<to>raw_adaptive_change_in_investments_3</to>
				</connector>
				<aux x="258.18" y="524.387" name="perceived energy supply\nmargins 3"/>
				<aux x="286.51" y="595.217" name="cost perception time 3"/>
				<connector uid="24" angle="111.8">
					<from>cost_perception_time_3</from>
					<to>perceived_energy_supply_margins_3</to>
				</connector>
				<aux x="304.51" y="287.497" name="effect of margins on\ninvestment 3"/>
				<aux background="#55AA00" label_side="bottom" x="120.73" y="287.497" name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment 3"/>
				<connector uid="25" angle="0">
					<from>sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment_3</from>
					<to>effect_of_margins_on_investment_3</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="197.18" y="622.217" name="average energy margins 3"/>
				<connector uid="26" angle="58.0552">
					<from>average_energy_margins_3</from>
					<to>perceived_energy_supply_margins_3</to>
				</connector>
				<aux x="295.67" y="376.607" name="relative margins 3"/>
				<connector uid="27" angle="75.7651">
					<from>perceived_energy_supply_margins_3</from>
					<to>relative_margins_3</to>
				</connector>
				<connector uid="28" angle="84.3346">
					<from>relative_margins_3</from>
					<to>effect_of_margins_on_investment_3</to>
				</connector>
				<aux background="#55AA00" x="354.92" y="441.947" name="initial perceived marginal energy supply cost 3"/>
				<connector uid="29" angle="132.202">
					<from>initial_perceived_marginal_energy_supply_cost_3</from>
					<to>relative_margins_3</to>
				</connector>
				<connector uid="30" angle="220.435">
					<from>initial_perceived_marginal_energy_supply_cost_3</from>
					<to>perceived_energy_supply_margins_3</to>
				</connector>
				<text_box uid="31" x="800.49" y="1137.63" width="145.928" height="58.6666">integrating control, responds to continuing deviations</text_box>
				<aux x="570.04" y="613.923" name="Baseline of investments 2"/>
				<connector uid="32" angle="37.4847">
					<from>Baseline_of_investments_2</from>
					<to>Energy_Investment_Allocated_to_Capacity_Construction_for_Gas</to>
				</connector>
				<connector uid="33" angle="331.195">
					<from>Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</from>
					<to>GAS_average_marginal_net_cost_of_energy_without_historical_cost_adjustment</to>
				</connector>
				<connector uid="34" angle="7.17788">
					<from>Energy_Investment_Allocated_to_Capacity_Construction_for_Gas</from>
					<to>GAS_average_marginal_net_cost_of_energy_without_historical_cost_adjustment</to>
				</connector>
				<connector uid="35" angle="160.064">
					<from>cost_of_extra_energy_output_through_fuel_extraction_per_unit_1</from>
					<to>GAS_average_marginal_net_cost_of_energy_without_historical_cost_adjustment</to>
				</connector>
				<connector uid="36" angle="93.0752">
					<from>investment_by_source_3</from>
					<to>Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="426" y="376.607" name="Switch for energy prices"/>
				<connector uid="37" angle="184.228">
					<from>Switch_for_energy_prices</from>
					<to>relative_margins_3</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="621.944" y="434.67" name="Moratorium on fossil energy year"/>
				<connector uid="38" angle="0">
					<from>Moratorium_on_fossil_energy_year</from>
					<to>desired_investment_by_source_3</to>
				</connector>
			</view>
		</views>
	</model>
	<model name="Liquid_fuel_investments">
		<variables>
			<aux name="cost of extra energy output through fuel extraction per unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="Oil Gross\nInvestments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source_1[Run,Oil_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nBiofuel Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source_1[Run,Bio]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 7" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\noil extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nbio fuel energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\noil extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\nbio fuel energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid\nand Subsidies Received in Fossil\nFuel Extraction Capital" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital[Run] +
tax_revenue_on_investments_in_oil_extraction[Run] -
expenditure_on_subsidies_for_investments_in_oil_extraction[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Biofuel Investments Including\nTaxes Paid and\nSubsidies Received" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity[Run] +
tax_revenue_on_investments_in_bio_fuel_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_bio_fuel_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive energy\ninvestments proportional factor 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-25.5629860825783</eqn>
				<range min="-50" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Energy Investment Allocated\nto Capacity Construction\nfor Liquid fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(Baseline_of_investments_for_Liquid_fuel*adaptive_change_in_investments_1, 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Relative Energy Supply Missmatch 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-0.856128480111106</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-7.2944852786431</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{TREND(Relative_Energy_Supply_Mismatch_with_Buffer, 1, initial_differentiated_relative_energy_supply_missmatch)}
{IF TIME &lt; STARTTIME+1 THEN
initial_differentiated_relative_energy_supply_missmatch 
ELSE
(Relative_Energy_Supply_Mismatch_with_Buffer-HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-1))/1}
DERIVN(Relative_Energy_Supply_Mismatch_with_Buffer_1, 1)</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="adaptive change\nin investments 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor_1*
Relative_Energy_Supply_Mismatch_with_Buffer_1 +

adaptive_energy_investments_integrating_factor_1 * Cumulative_Relative_Energy_Supply_Missmatch_1 +

adaptive_energy_investments_differntiating_factor_1 * Differentiating_Relative_Energy_Supply_Missmatch_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment by\nsource 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>ALLOCATE(Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel[Run], EnergySourceLiquid, desired_investment_by_source_1[Run,*],  priority_by_source_1[Run, *], priority_spread_1[Run], shape_1)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="desired investment\nby source 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel[Run]
-
(IF ((EnergySourceLiquid = EnergySourceLiquid.Oil_fuel_extraction) AND TIME &gt; Moratorium_on_fossil_energy_year ) 
THEN
Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<stock name="cumulative squared relative\nenergy supply missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch_1</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch_1</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch_1</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="Acc Cum Rel En Sup Missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer_1/time_to_perceive_energy_supply_missmatch_1</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer_1^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="initial relative supply missmatch 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0219711399882975</eqn>
				<range min="-0.5" max="0.5"/>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Missmatch_1-Relative_Energy_Supply_Mismatch_Buffer_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer 1">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="average marginal\nnet cost of energy without historical cost adjustment 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
cost_of_extra_energy_output_through_fuel_extraction_per_unit_2* Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7 * Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity
)
/Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="time to perceive energy supply missmatch 1">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="perceived energy supply\nmargins 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins_1, cost_perception_time_1, initial_perceived_marginal_energy_supply_cost_1)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost perception time 1">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="effect of margins on\ninvestment 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1+(EXP(relative_margins_1-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0897030727641846</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="average energy margins 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="relative margins 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(perceived_energy_supply_margins_1/initial_perceived_marginal_energy_supply_cost_1)*Switch_for_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0104350216586014</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="LIQUID average marginal\nnet cost of energy with\nhistorical cost adjustment" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>( adjusted_cost_1[Run,Oil_fuel_extraction]* Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital
+ 
adjusted_cost_1[Run,Bio]*Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity
)
/Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="priority spread 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>3.70170968639451</eqn>
				<range min="0" max="50"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape 1">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>3 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="adjusted cost 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>MAX(1e-12, cost_to_build_per_unit_1[Run,EnergySourceLiquid]*interpolated_historical_cost_adjustment_1[Run,EnergySourceLiquid])</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost to build\nper unit 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>IF EnergySourceLiquid = EnergySourceLiquid.Oil_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_2[Run]
ELSE IF EnergySourceLiquid = EnergySourceLiquid.Bio THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7[Run]
ELSE 
1e12</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority by source 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost_1)</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="historical cost adjustment\nfor Liquid fuel">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
					<dim name="Historical_5yr_time_steps"/>
				</dimensions>
				<element subscript="1, Oil_fuel_extraction, 1">
					<eqn>0.091625792471999</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 2">
					<eqn>0.0748588834372767</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 3">
					<eqn>0.0559886693248627</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 4">
					<eqn>0.0684516748211433</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 5">
					<eqn>0.0969066234563973</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 6">
					<eqn>0.171397341068043</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 7">
					<eqn>0.281453980496424</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 8">
					<eqn>0.187909900850773</eqn>
				</element>
				<element subscript="1, Oil_fuel_extraction, 9">
					<eqn>0.242241985500276</eqn>
				</element>
				<element subscript="1, Bio, 1">
					<eqn>0.566745338421564</eqn>
				</element>
				<element subscript="1, Bio, 2">
					<eqn>0.256945834057692</eqn>
				</element>
				<element subscript="1, Bio, 3">
					<eqn>0.511447351144369</eqn>
				</element>
				<element subscript="1, Bio, 4">
					<eqn>0.989007809078141</eqn>
				</element>
				<element subscript="1, Bio, 5">
					<eqn>0.683342928802947</eqn>
				</element>
				<element subscript="1, Bio, 6">
					<eqn>0.919906040597533</eqn>
				</element>
				<element subscript="1, Bio, 7">
					<eqn>0.999519219073254</eqn>
				</element>
				<element subscript="1, Bio, 8">
					<eqn>1.24390562200904</eqn>
				</element>
				<element subscript="1, Bio, 9">
					<eqn>0.994574251697501</eqn>
				</element>
				<range min="0.05" max="4"/>
				<units>dmnl</units>
			</aux>
			<aux name="pct of history 1">
				<eqn>(TIME-STARTTIME)/(2020-STARTTIME)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="interpolated historical cost adjustment 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceLiquid"/>
				</dimensions>
				<eqn>SMTH1(INTERPOLATE(historical_cost_adjustment_for_Liquid_fuel[Run,EnergySourceLiquid,*], pct_of_history_1), historical_cost_adjustment_smoothing_time_1[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment smoothing time 1">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.428528840218145</eqn>
				<range min="0.25" max="0.75"/>
				<units>years</units>
			</aux>
			<aux name="Baseline of investments\nfor Liquid fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>36076285050.2046</eqn>
				<range min="10000000000" max="200000000000"/>
				<units>c$/Year</units>
			</aux>
			<aux name="Switch for energy prices" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="input">
				<eqn>2150</eqn>
				<units>Year</units>
			</aux>
		</variables>
