				<aux font_style="italic" font_weight="bold" x="482.86" y="1092.06" name="Fossil Fuel Extraction\nProductivity 1"/>
				<connector uid="132" angle="317.086">
					<from>Fossil_Fuel_Extraction_Productivity_1</from>
					<to>Cost_of_Extra_Energy_Output_through_fuel_extraction</to>
