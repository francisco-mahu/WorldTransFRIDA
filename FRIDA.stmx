			<aux name="beta effect of GDP on\nBioenergy Waste Heat demand for Buildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0979167834288976</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="alpha effect of GDP on\nBioenergy Waste Heat demand\nfor Buildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>2.06866552496081</eqn>
				<range min="0" max="5"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nBioenergy Waste Heat demand\nfor Buildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>alpha_effect_of_GDP_on_Bioenergy_Waste_Heat_demand_for_Buildings[Run]*relative_global_real_GDP_in_2021[Run]^(beta_effect_of_GDP_on_Bioenergy_Waste_Heat_demand_for_Buildings[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="COAL average marginal\nnet cost of energy without\nhistorical cost adjustment" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="LIQUID average marginal\nnet cost of energy with\nhistorical cost adjustment 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="GAS average marginal\nnet cost of energy without\nhistorical cost adjustment" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="ELECTRICITY average marginal\nnet cost of energy with\nhistorical cost adjustment" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="UNIT TWh to zJ 1" access="input">
				<eqn>0.00000359999999971</eqn>
				<units>zJ/TWh</units>
			</aux>
			<aux name="UNIT TWh to MWh" access="input">
				<eqn>1000000</eqn>
				<units>MWh/TWh</units>
			</aux>
			<aux name="aggregate per unit energy prices 4" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(OTHER_average_marginal_net_cost_of_energy_without_historical_cost_adjustment_1, time_for_competition_to_change_prices_4, initial_aggregate_per_unit_energy_prices_Liquid_1)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="initial aggregate per\nunit energy prices Liquid 1" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.108389795311703</eqn>
				<range min="0.05" max="0.2"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="reference change\nin energy prices Other" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.00510195238484184</eqn>
				<range min="0.001" max="0.012"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="time for competition\nto change prices 4">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>7</eqn>
				<range min="5" max="10"/>
				<units>year</units>
			</aux>
			<aux name="initial reference aggregate\nper unit energy prices Other" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0404324364193422</eqn>
				<range min="0" max="0.2"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="average energy margins OTHER" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>aggregate_per_unit_energy_prices_4-OTHER_average_marginal_net_cost_of_energy_without_historical_cost_adjustment_1</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="change\nin energy prices 4">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(reference_aggregate_per_unit_energy_prices_4-aggregate_per_unit_energy_prices_4)*Switch_for_energy_prices</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="reference aggregate\nper unit energy prices 4">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(aggregate_per_unit_energy_prices_4, reference_formation_time_5, initial_reference_aggregate_per_unit_energy_prices_Other)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="reference formation time 5">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>5</eqn>
				<range min="3" max="10"/>
				<units>years</units>
			</aux>
			<aux name="relative change in\nenergy prices\nBioenergy and Waste 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(change_in_energy_prices_4/reference_change_in_energy_prices_Other)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="OTHER average marginal\nnet cost of energy without\nhistorical cost adjustment 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
