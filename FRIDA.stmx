	</model>
	<model name="Electricity_investments">
		<variables>
			<aux name="adaptive energy\ninvestments proportional factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
The larger the P factor is, the stronger the controller reacts to differences between the set point value and the actual value (0 relative supply demand missmatch).
Negative values of P causes compensation of differences, positive values would cause amplification of differences.</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-10.0862977296706</eqn>
				<range min="-50" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="Investments in\nNuclear Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Nuclear]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nHydropower\nEnergy capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Hydropower]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in nuclear energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in hydropower">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Energy Investment Allocated to Capacity Construction" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(Baseline_investment_to_Electricity*adaptive_change_in_investments[Run], 1)</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="adaptive energy\ninvestments integrating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-2.3319332319455</eqn>
				<range min="-7" max="0"/>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive energy\ninvestments differntiating factor" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-4.15270007361085</eqn>
				<range min="-15" max="0"/>
				<units>Year</units>
			</aux>
			<aux name="Differentiating Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME &gt; STARTTIME+time_to_perceive_energy_supply_missmatch THEN
(Relative_Energy_Supply_Mismatch_with_Buffer - HISTORY(Relative_Energy_Supply_Mismatch_with_Buffer, TIME-time_to_perceive_energy_supply_missmatch))/time_to_perceive_energy_supply_missmatch
ELSE
0</eqn>
				<units>Per Year</units>
			</aux>
			<aux name="Share of Gross Energy Expenditure\ninvested in fuel\nextraction, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Gross Energy Expenditure\ninvested in fossil energy, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fuel extraction, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fuel extraction, gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy, gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="adaptive change\nin investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, raw_adaptive_change_in_investments[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="raw adaptive\nchange in investments">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+
adaptive_energy_investments_proportional_factor[Run]*
Relative_Energy_Supply_Mismatch_with_Buffer[Run] +

adaptive_energy_investments_integrating_factor[Run] * Cumulative_Relative_Energy_Supply_Missmatch[Run] +

adaptive_energy_investments_differntiating_factor[Run] * Differentiating_Relative_Energy_Supply_Missmatch[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="investment by\nsource">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>ALLOCATE(Energy_Investment_Allocated_to_Capacity_Construction[Run], EnergySource, desired_investment_by_source[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="cost to build\nper unit">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 0 THEN
(IF EnergySource = EnergySource.Coal_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit[Run]
ELSE IF EnergySource = EnergySource.Coal_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit[Run]
ELSE IF EnergySource = EnergySource.Oil_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_2[Run]
ELSE IF EnergySource = EnergySource.Oil_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2[Run]
ELSE IF EnergySource = EnergySource.Gas_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_1[Run]
ELSE IF EnergySource = EnergySource.Gas_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_1[Run]
ELSE IF EnergySource = EnergySource.Solar THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8[Run]
ELSE IF EnergySource = EnergySource.Wind THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_9[Run]
ELSE IF EnergySource = EnergySource.Hydropower THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4[Run] 
ELSE IF EnergySource = EnergySource.Nuclear THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6[Run]
ELSE IF EnergySource = EnergySource.Bio THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7[Run]
ELSE NAN)
ELSE
cost_to_build_per_unit_1</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>33.4346914588317</eqn>
				<range min="10" max="50"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="desired investment\nby source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>Energy_Investment_Allocated_to_Capacity_Construction[Run]
-
(IF (EnergySource = EnergySource.Coal_fuel_extraction 
OR EnergySource = EnergySource.Oil_fuel_extraction
OR EnergySource = EnergySource.Gas_fuel_extraction 
OR EnergySource = EnergySource.Coal_energy_conversion
OR EnergySource = EnergySource.Oil_energy_conversion 
OR EnergySource = EnergySource.Gas_energy_conversion ) AND TIME &gt; Moratorium_on_fossil_energy_year THEN
Energy_Investment_Allocated_to_Capacity_Construction[Run]
ELSE 
0)</eqn>
				<units>c$/year</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost[Run,EnergySource]*investment_priority_adjustment_from_stranded_capital[Run,EnergySource])</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="cost of extra energy output through fuel extraction per unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost of extra energy output through fuel extraction per unit 1" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="cost of extra energy output through fuel extraction per unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/year)</units>
			</aux>
			<aux name="Cost of Extra Energy Output through Capital per Unit 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 4" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 6" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in Fossil\nFuel Extraction\nCapital for Electricity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Coal_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Coal_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross\nInvestments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Oil_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross\nInvestments in Fossil\nFuel Extraction Capital for Electricity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Oil_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Gross\nInvestments in\nFossil Energy Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Gas_energy_conversion]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Gross\nInvestments in Fossil\nFuel Extraction Capital for Electricity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Gas_fuel_extraction]</eqn>
				<units>c$/Year</units>
			</aux>
			<stock name="cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Acc_cumulative_squared_relative_energy_supply_missmatch</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<stock name="Cumulative Relative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_relative_supply_missmatch[Run]</eqn>
				<inflow>Acc_Cum_Rel_En_Sup_Missmatch</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="Acc Cum Rel En Sup Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer[Run]/time_to_perceive_energy_supply_missmatch[Run]</eqn>
				<units>Per Year</units>
			</flow>
			<flow name="Acc cumulative squared relative\nenergy supply missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Mismatch_with_Buffer[Run]^2/DT</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="initial relative supply missmatch" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0119480789089314</eqn>
				<range min="-0.5" max="0.5"/>
