	</model>
	<model name="Effect_of_energy_prices_on_Transportation_demand">
		<variables>
			<aux name="effect\nof energy prices on\nTransportation demand" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(Transportation_specific_relative_energy_changes-1)-1)*sensitivity_of_effect_of_energy_prices_on_energy_demand_of_Transportation*Switch_to_energy_prices_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect\nof energy prices on\nenergy demand of Transportation">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.124405662201714</eqn>
				<range min="0.001" max="0.2"/>
				<units>dmnl</units>
			</aux>
			<aux name="Transportation specific\nrelative energy changes">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(relative_change_in_energy_prices_for_Fossil_Coal*Share_of_Transportation_energy_demand_for_fossil_coal+relative_change_in_energy_prices_for_Liquid_Fuel_1*Share_of_Transportation_energy_demand_for_liquid_fuel+relative_change_in_energy_prices_for_Fossil_Gas*Share_of_Transportation_energy_demand_for_fossil_gas+relative_change_in_energy_prices_in_electricity_2*Share_of_Transportation_energy_demand_for_electricity,Time_for_delay, initial_relative_energy_change)</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="Time for delay">
				<eqn>1</eqn>
				<units>Year</units>
			</aux>
			<aux name="initial relative energy change">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for fossil coal" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for liquid fuel" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for fossil gas" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Transportation\nenergy demand for electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative change\nin energy prices\nin electricity 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative change in\nenergy prices for Fossil Gas" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative change in\nenergy prices for Liquid Fuel 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative change in\nenergy prices for Fossil Coal" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Switch to energy prices 1" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
		</variables>
