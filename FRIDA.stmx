				<text_box uid="4" x="501.2" y="1242.51" width="260" height="58">This is a PID controler
https://en.wikipedia.org/wiki/Proportional%E2%80%93integral%E2%80%93derivative_controller</text_box>
				<text_box uid="5" x="501.2" y="1200.31" width="260" height="29.6667">PID factors. Negative values dampen deviations, positive values amplify</text_box>
				<text_box uid="6" x="338.31" y="1130.76" width="131.667" height="15">Proportional control</text_box>
				<text_box uid="7" x="530.28" y="1137.69" width="145.928" height="16.875">differentiating control, smoothes </text_box>
				<aux x="742.94" y="749.143" name="adaptive change\nin investments 3"/>
