			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Electricity 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
