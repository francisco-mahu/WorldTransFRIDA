				<stacked_container uid="406" x="6570.42" y="4889.42" width="616.25" height="840.007">
					<graph width="616.25" height="840.007" type="time_series" isee:points_only="true" show_grid="false" isee:tick_type="none" include_units_in_legend="false" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="5" num_y_labels="3" isee:fill_intensity="0.1" to="2023" isee:allow_zero_axis="true" left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true"/>
				</stacked_container>
				<stacked_container uid="407" x="7234.79" y="4886.93" width="622.5" height="844.987">
					<graph width="622.5" height="844.987" type="time_series" isee:points_only="true" show_grid="false" isee:tick_type="none" include_units_in_legend="false" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="5" num_y_labels="3" isee:fill_intensity="0.1" to="2023" isee:allow_zero_axis="true" left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true"/>
				</stacked_container>
				<text_box font_size="72pt" uid="408" x="7238.48" y="4721.02" width="615.127" height="156.333">Adjusted Marginal Costs</text_box>
				<text_box font_size="72pt" uid="409" x="6577.96" y="4717.27" width="601.167" height="163.83">Historical Marginal Cost Adjustment</text_box>
				<stacked_container uid="410" x="5113.05" y="4374.08" width="571.25" height="396.25">
					<graph width="571.25" height="396.25" comparative="true" type="time_series" isee:points_only="true" show_grid="false" isee:tick_type="none" include_units_in_legend="false" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="5" num_y_labels="3" isee:fill_intensity="0.1" to="1990" isee:allow_zero_axis="true" left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true"/>
				</stacked_container>
				<stacked_container uid="411" x="3931.8" y="4370.33" width="571.25" height="396.25">
					<graph width="571.25" height="396.25" comparative="true" type="time_series" isee:points_only="true" show_grid="false" isee:tick_type="none" include_units_in_legend="false" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="5" num_y_labels="3" isee:fill_intensity="0.1" to="1990" isee:allow_zero_axis="true" left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true"/>
				</stacked_container>
				<stacked_container uid="412" x="2721.59" y="4374.08" width="571.25" height="396.25">
					<graph width="571.25" height="396.25" comparative="true" type="time_series" isee:points_only="true" show_grid="false" isee:tick_type="none" include_units_in_legend="false" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="5" num_y_labels="3" isee:fill_intensity="0.1" to="1990" isee:allow_zero_axis="true" left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true"/>
				</stacked_container>
				<isee:custom_shape>
					<pts>
						<pt x="1605" y="3011"/>
						<pt x="1705" y="3011"/>
						<pt x="1705" y="3111"/>
						<pt x="1605" y="3111"/>
					</pts>
				</isee:custom_shape>
				<text_box font_size="36pt" uid="413" x="821.023" y="5007.9" width="246.25" height="79.25">Electricity Mix</text_box>
				<module x="577.35" y="117.333" name="Energy Investments 1"/>
				<connector uid="414" isee:thickness="2" angle="295" isee:autocreated="true">
					<from>Energy_Investments_1</from>
					<to>Energy_demand_1</to>
				</connector>
				<connector uid="415" isee:thickness="2" angle="130.221" isee:autocreated="true">
					<from>Energy_demand_1</from>
					<to>Energy_Investments_1</to>
				</connector>
				<connector uid="416" color="#E6E6E6" font_color="#E6E6E6" isee:thickness="2" angle="128.576" isee:autocreated="true">
					<from>Energy_Units_1</from>
					<to>Energy_Investments_1</to>
				</connector>
				<module x="577.35" y="226.333" name="Energy Supply 1"/>
				<connector uid="417" isee:thickness="2" angle="295" isee:autocreated="true">
					<from>Energy_Investments_1</from>
					<to>Energy_Supply_1</to>
				</connector>
				<connector uid="418" color="#E6E6E6" font_color="#E6E6E6" isee:thickness="2" angle="186.009" isee:autocreated="true">
					<from>Energy_Units_1</from>
					<to>Energy_Supply_1</to>
				</connector>
				<connector uid="419" isee:thickness="2" angle="115" isee:autocreated="true">
					<from>Energy_Supply_1</from>
					<to>Energy_Investments_1</to>
				</connector>
				<module x="577.35" y="305.333" name="Supply vs demand balance 1"/>
				<connector uid="420" isee:thickness="2" angle="48.1085" isee:autocreated="true">
					<from>Supply_vs_demand_balance_1</from>
					<to>Energy_Investments_1</to>
				</connector>
				<connector uid="421" isee:thickness="2" angle="115" isee:autocreated="true">
					<from>Energy_demand_1</from>
					<to>Supply_vs_demand_balance_1</to>
				</connector>
				<connector uid="422" isee:thickness="2" angle="295" isee:autocreated="true">
					<from>Energy_Supply_1</from>
					<to>Supply_vs_demand_balance_1</to>
				</connector>
				<connector uid="423" isee:thickness="2" angle="115" isee:autocreated="true">
					<from>Supply_vs_demand_balance_1</from>
					<to>Energy_Supply_1</to>
				</connector>
			</view>
		</views>
	</model>
	<model name="Energy_demand_1" run="true">
		<variables>
			<aux name="CDD" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>CDD_historical+CDD_linear_coefficient*Surface_Temperature_Anomaly</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD_historical*EXP(HDD_exponential_coefficient*Surface_Temperature_Anomaly)</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="CDD linear coefficient">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>287.8469604</eqn>
				</element>
				<range min="230" max="330"/>
				<units>CDD/(deg C*p*Year)</units>
			</aux>
			<aux name="CDD historical">
				<doc>${Climate Impact Parameter,External Parameter}
Based on GCM output of the past</doc>
				<eqn>704.2162675</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD historical">
				<doc>${Climate Impact Parameter,External Parameter}
Based on GCM output of the past</doc>
				<eqn>1375.71022</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="HDD exponential coefficient">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-0.232561095</eqn>
				</element>
				<range min="-0.5" max="-0.01"/>
				<units>1/(deg C)</units>
			</aux>
			<aux name="CDD change to preindustrial">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>CDD-CDD_preindustrial</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="CDD preindustrial" access="output" isee:autocreated="true">
				<eqn>CDD_historical</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD preindustrial">
				<eqn>HDD_historical</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="HDD change to preindustrial">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD-HDD_preindustrial</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="Change in energy used for Heating due to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD_change_to_preindustrial*Energy_use_per_HDD</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Energy use per HDD">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.002</eqn>
				</element>
				<range min="0.0001" max="0.01"/>
				<units>GJ/(HDD)</units>
			</aux>
			<aux name="energy use per CDD">
				<doc>${Climate Impact Parameter,External Parameter}
	Calibrated To Rode	Calibrated To Clark
1980	0.000875	0.007
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.000875</eqn>
				</element>
				<range min="0.0004" max="0.01"/>
				<units>GJ/(CDD)</units>
			</aux>
			<aux name="Change in energy used for\ncooling due to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>energy_use_per_CDD*CDD_change_to_preindustrial</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Change in energy used for\ncooling due to climate change in MWh" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>UNIT_GJ_to_MWh*Change_in_energy_used_for_cooling_due_to_climate_change</eqn>
				<units>MWh/(Person*Year)</units>
			</aux>
			<aux name="Change in energy used for\nHeating due to climate change in MWh">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>UNIT_GJ_to_MWh*Change_in_energy_used_for_Heating_due_to_climate_change</eqn>
				<units>MWh/(Person*Year)</units>
			</aux>
			<aux name="total change in energy used for\nheating and cooling\ndue to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF (switch_energy_damage=0) AND TIME &gt; today THEN
(Change_in_energy_used_for_Heating_due_to_climate_change_in_MWh + Change_in_energy_used_for_cooling_due_to_climate_change_in_MWh
)*Population*Converter_2
ELSE
0</eqn>
				<units>MWh/year</units>
			</aux>
			<aux name="total change in energy used for\nheating and cooling\ndue to climate change in GJ">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Change_in_energy_used_for_Heating_due_to_climate_change + Change_in_energy_used_for_cooling_due_to_climate_change</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Surface Temperature Anomaly" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>deg C</units>
			</aux>
			<aux name="today" access="input">
				<eqn>2025</eqn>
				<units>year</units>
			</aux>
			<aux name="switch energy damage" access="input">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="UNIT GJ to MWh" access="input">
				<eqn>0.277778</eqn>
				<units>MWh/GJ</units>
			</aux>
			<aux name="effect of GDP on\nenergy demand for Buildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_Buildings_energy_demand_alpha*relative_global_real_GDP_in_2021^(effect_of_GDP_on_Buildings_energy_demand_beta)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="C effect of GDP on\nTransport energy demand alpha">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>-8.58649714347555</eqn>
				<range min="-15" max="5"/>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity demand for\nTransport">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_energy_demand_for_Transport_2*normal_electricity_demand_for_Transportation*effect_of_energy_prices_on_demand_for_Transport</eqn>
				<units>MWh/year</units>
			</aux>
			<aux name="effect of GDP on\nenergy demand\nfor Transport">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>A_effect_of_GDP_on_Transport_energy_demand_alpha_3*relative_global_real_GDP_in_2021^3+B_effect_of_GDP_on_Transport_energy_demand_alpha_4*relative_global_real_GDP_in_2021^2+C_effect_of_GDP_on_Transport_energy_demand_alpha*relative_global_real_GDP_in_2021+D_effect_of_GDP_on_Transport_energy_demand_beta</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal electricity demand\nfor Transportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>308861705.666306</eqn>
				<range min="100000000" max="500000000"/>
				<units>MWh/year</units>
			</aux>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>bc$/year</units>
			</aux>
			<aux name="relative global\nreal GDP in 2021">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Converter_1/INIT(Converter_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="energy demand for\nTransport per person">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_demand_for_Transport/(Population*Converter_2)</eqn>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="per person energy demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF(switch_energy_demand_policy= 0 OR TIME &lt; Policy_Start_Year) THEN
(energy_demand_for_Buildings_per_person+energy_demand_for_Transport_per_person+energy_demand_for_Industry_and_Other_per_person)
ELSE
per_person_use_of_energy_policy</eqn>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="effect\nof energy prices on demand for Transport">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+((EXP(relative_change_in_energy_prices-1)-1)*sensitivity_of_effect_of_energy_prices_on_energy_demand_for_Transport)*Switch_for_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect\nof energy prices on\nenergy demand for Transport">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.00746007699520094</eqn>
				<range min="0.001" max="0.01"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nBuildings energy\ndemand beta">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.198048521302911</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="D effect of GDP on\nTransport energy demand beta">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>7.47570533249383</eqn>
				<range min="-2" max="9"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nBuildings energy\ndemand alpha">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.69770988166549</eqn>
				<range min="0" max="5"/>
				<units>dmnl</units>
			</aux>
			<aux name="demand for energy" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
For Calibration&gt;
This is energy demand, so consumption data would be closest. However, real consumption data can never show a demand greater than supply.
https://ourworldindata.org/grapher/fossil-fuel-primary-energy?tab=chart&amp;country=~OWID_WRL</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Population*per_person_energy_demand</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Population" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp</units>
			</aux>
			<aux name="per person use of energy policy" access="input">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2100"/>
					<yscale min="5.5" max="8.5"/>
					<ypts>7.4,7.4,7.4,7.4,7.4,7.4,7.4,7.4,7.4</ypts>
				</gf>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="Policy Start Year" access="input">
				<eqn>2024</eqn>
				<units>Year</units>
			</aux>
			<aux name="switch energy demand policy" access="input">
				<eqn>0</eqn>
				<format precision="1" scale_by="auto"/>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="average marginal\nnet cost of energy with historical cost adjustment" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="aggregate per unit energy prices" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_marginal_net_cost_of_energy_with_historical_cost_adjustment, time_for_competition_to_change_prices, initial_aggregate_per_unit_energy_prices_electricity)</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="initial aggregate per\nunit energy prices electricity" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0947753612584115</eqn>
				<range min="0.01" max="0.5"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="reference change\nin energy prices electricity" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.00248297005074329</eqn>
				<range min="0.001" max="0.012"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="time for competition\nto change prices">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>7</eqn>
				<range min="5" max="10"/>
				<units>year</units>
			</aux>
