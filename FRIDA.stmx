			</module>
			<aux name="Secondary Fossil Energy Output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_12+Secondary_Fossil_Energy_Output_9+Secondary_Fossil_Energy_Output_1+Secondary_Fossil_Energy_Output_13+Secondary_Fossil_Energy_Output_11+Secondary_Fossil_Energy_Output_10</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Coal Secondary Energy output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_1+Secondary_Fossil_Energy_Output_13</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Gas Secondary Energy output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_12+Secondary_Fossil_Energy_Output_11</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Oil Secondary Energy output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_9+Secondary_Fossil_Energy_Output_10</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Primary Fossil Fuel Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_5+Primary_Fossil_Energy_FUEL_6+Primary_Fossil_Energy_FUEL+Primary_Fossil_Energy_FUEL_for_Electricity_5+Primary_Fossil_Energy_FUEL_for_Electricity_3+Primary_Fossil_Energy_FUEL_for_Electricity_4</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Oil Primary Fossil Fuel Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL+Primary_Fossil_Energy_FUEL_for_Electricity_3</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Gas Primary Fossil\nFuel Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_5+Primary_Fossil_Energy_FUEL_for_Electricity_4</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Coal Primary Fossil\nFuel Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_6+Primary_Fossil_Energy_FUEL_for_Electricity_5</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="conversion efficiency of fossil fuels to secondary fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output/(Primary_Fossil_Fuel_Energy*UNIT_zJ_to_TWh_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="UNIT zJ to TWh 1" access="input">
				<eqn>277777.7778</eqn>
				<units>TWh/zJ</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 9" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 10" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 11" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
