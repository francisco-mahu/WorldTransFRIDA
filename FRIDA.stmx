				<connect2 to="Other_energy.start_year" from="Government_Regulations.start_year"/>
				<connect to="Other_energy.tax_rate_on_newly_installed_other_energy_production_capacity" from="Government_Regulations.tax_rate_on_newly_installed_other_energy_production_capacity"/>
				<connect2 to="Other_energy.tax_rate_on_newly_installed_other_energy_production_capacity" from="Government_Regulations.tax_rate_on_newly_installed_other_energy_production_capacity"/>
				<connect to="Other_energy.TWh_to_kWh" from="Energy_Units_1.UNIT_TWh_to_kWh"/>
				<connect2 to="Other_energy.TWh_to_kWh" from="Energy_Units_1.UNIT_TWh_to_kWh"/>
			</module>
			<aux name="Other Energy Output" access="output" throughput="true" isee:autocreated="true">
