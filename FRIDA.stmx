				<connector uid="895" angle="197.404">
					<from>UNIT_TWh_to_zJ_1</from>
					<to>Direct_use_Biofuel_demand_in_zJ</to>
				</connector>
				<connector uid="896" angle="231.156">
					<from>Switch_to_couple_investments_supply_and_demand_in_new_energy</from>
					<to>Direct_use_Biofuel_demand_in_zJ</to>
				</connector>
				<connector uid="897" angle="343.262">
					<from>Total_demand_for_energy</from>
					<to>Biofuel_Share</to>
				</connector>
				<connector uid="898" angle="180.176">
					<from>Biofuel_1</from>
					<to>Direct_use_Biofuel_demand</to>
				</connector>
				<connector uid="900" angle="158.794">
					<from>Biofuel_2</from>
					<to>Direct_use_Biofuel_demand</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="1794" y="287.76" name="Biofuel"/>
				<connector uid="899" angle="202.868">
					<from>Biofuel</from>
					<to>Direct_use_Biofuel_demand</to>
				</connector>
				<connector uid="778" angle="179.949">
					<from>Transportation_energy_demand_1</from>
					<to>Biofuel</to>
				</connector>
				<aux label_side="bottom" x="1794" y="359.127" name="Share of Transportation\nenergy demand for biofuel"/>
				<connector uid="742" angle="183.663">
					<from>total_energy_demand_for_Industry_and_Other_1</from>
					<to>Share_of_Transportation_energy_demand_for_biofuel</to>
				</connector>
				<connector uid="741" angle="270">
					<from>Biofuel</from>
					<to>Share_of_Transportation_energy_demand_for_biofuel</to>
				</connector>
				<aux background="#FFAAFF" x="2147.44" y="644.111" name="Share of Oil demand for\nIndustry and Other"/>
				<connector uid="901" angle="90">
