	<model name="Renewable_energy_1" run="true">
		<variables>
			<aux name="Renewable Energy\nOutput" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
0.0000000036 is gwh2zj

Calibrate to energy provision from renewable sources</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_Energy_Output_1+
Wind_Energy_Output+
+Hydropower_Energy_Output
+bio_fuel_secondary_energy_output</eqn>
				<units>TWh/Years</units>
			</aux>
			<module name="Hydropower energy 1" isee:label="">
				<format scale_by="auto"/>
				<connect to="Electricity_investments.Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4" from="Hydropower_energy_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect2 to="Electricity_investments.Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4" from="Hydropower_energy_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect to="Renewable_energy_1.Converter_1" from="Hydropower_energy_1.Hydropower_Energy_Capacity"/>
				<connect2 to="Converter_1" from="Hydropower_energy_1.Hydropower_Energy_Capacity"/>
				<connect to="Renewable_energy_1.Hydropower_Energy_Output" from="Hydropower_energy_1.Hydropower_Energy_Output"/>
				<connect2 to="Hydropower_Energy_Output" from="Hydropower_energy_1.Hydropower_Energy_Output"/>
				<connect to="Hydropower_energy_1.damage_rate_of_energy_capital_from_STA" from="Damages_1.damage_rate_of_energy_capital_from_STA"/>
				<connect2 to="Hydropower_energy_1.damage_rate_of_energy_capital_from_STA" from="Damages_1.damage_rate_of_energy_capital_from_STA"/>
				<connect to="Hydropower_energy_1.deltaEnergy_for_costs" from="Energy_supply_1.deltaEnergy_for_costs"/>
				<connect2 to="Hydropower_energy_1.deltaEnergy_for_costs" from="Energy_supply_1.deltaEnergy_for_costs"/>
				<connect to="Hydropower_energy_1.effect_of_STA_on_hydropower_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_hydropower_energy_capacity_efficiency"/>
				<connect2 to="Hydropower_energy_1.effect_of_STA_on_hydropower_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_hydropower_energy_capacity_efficiency"/>
				<connect to="Hydropower_energy_1.GW_to_TW" from="Energy_Units_1.UNIT_GW_to_TW"/>
				<connect2 to="Hydropower_energy_1.GW_to_TW" from="Energy_Units_1.UNIT_GW_to_TW"/>
				<connect to="Hydropower_energy_1.Investments_in_Hydropower_Energy_Capcity" from="Electricity_investments.Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity"/>
				<connect2 to="Hydropower_energy_1.Investments_in_Hydropower_Energy_Capcity" from="Electricity_investments.Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity"/>
				<connect to="Hydropower_energy_1.kW_to_GW" from="Energy_Units_1.UNIT_kW_to_GW"/>
				<connect2 to="Hydropower_energy_1.kW_to_GW" from="Energy_Units_1.UNIT_kW_to_GW"/>
				<connect to="Hydropower_energy_1.kW_to_TW" from="Energy_Units_1.UNIT_kW_to_TW"/>
				<connect2 to="Hydropower_energy_1.kW_to_TW" from="Energy_Units_1.UNIT_kW_to_TW"/>
				<connect to="Hydropower_energy_1.start_year" from="Government_Regulations.start_year"/>
				<connect2 to="Hydropower_energy_1.start_year" from="Government_Regulations.start_year"/>
				<connect to="Hydropower_energy_1.tax_for_newly_installed_hydropower_capacity" from="Government_Regulations.tax_rate_on_newly_installed_hydropower_capacity"/>
				<connect2 to="Hydropower_energy_1.tax_for_newly_installed_hydropower_capacity" from="Government_Regulations.tax_rate_on_newly_installed_hydropower_capacity"/>
				<connect to="Hydropower_energy_1.TWh_to_kWh" from="Energy_Units_1.UNIT_TWh_to_kWh"/>
				<connect2 to="Hydropower_energy_1.TWh_to_kWh" from="Energy_Units_1.UNIT_TWh_to_kWh"/>
			</module>
			<aux name="Hydropower Energy Output" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<module name="Bio fuel energy 1" isee:label="">
				<format scale_by="auto"/>
