			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MAX(1e-12, cost_to_build_per_unit[Run,EnergySource]*interpolated_historical_cost_adjustment[Run,EnergySource])</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="pct of history">
				<eqn>(TIME-STARTTIME)/(2020-STARTTIME)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="interpolated historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>SMTH1(INTERPOLATE(historical_cost_adjustment[Run,EnergySource,*], pct_of_history), historical_cost_adjustment_smoothing_time[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment smoothing time" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.5</eqn>
				<range min="0.25" max="0.75"/>
				<units>years</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF Switch_to_couple_investments_supply_and_demand_in_new_energy = 0 THEN
Relative_Energy_Supply_Missmatch-Relative_Energy_Supply_Mismatch_Buffer
ELSE
Relative_Energy_Supply_Missmatch_1-Relative_Energy_Supply_Mismatch_Buffer</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="input">
				<eqn>2050</eqn>
				<units>Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nBiofuel Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Bio]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in bio energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 7" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="average marginal\nnet cost of energy without historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
cost_of_extra_energy_output_through_fuel_extraction_per_unit[Run] * Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run] 
+  cost_of_extra_energy_output_through_fuel_extraction_per_unit_2[Run] * Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run]
+ cost_of_extra_energy_output_through_fuel_extraction_per_unit_1[Run] * Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit[Run] * Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2[Run] * Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_1[Run] * Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]
+
Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8[Run] * Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run]
+
Cost_of_Extra_Energy_Output_through_Capital_per_Unit_9[Run] * Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4[Run] * Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7[Run] * Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity[Run]
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6[Run] * Investments_in_Nuclear_Capacity[Run]
)
/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="ELECTRICITY average marginal\nnet cost of energy with\nhistorical cost adjustment" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
adjusted_cost[Run,Coal_fuel_extraction] * Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run] 
+  adjusted_cost[Run,Oil_fuel_extraction] * Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run]
+ adjusted_cost[Run,Gas_fuel_extraction] * Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run]
+ adjusted_cost[Run,Coal_energy_conversion] * Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]
+ adjusted_cost[Run,Oil_energy_conversion] * Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]
+ adjusted_cost[Run,Gas_energy_conversion] * Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]
+ adjusted_cost[Run,Hydropower] * Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]
+ adjusted_cost[Run,Bio] * Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity[Run]
+ adjusted_cost[Run,Nuclear] * Investments_in_Nuclear_Capacity[Run]
+ adjusted_cost[Run,Solar]
*Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity
+ adjusted_cost[Run,Wind]
*Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity
)
/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\noil extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
