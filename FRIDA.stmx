	<model name="Efficiency_reduction_in_power_plants_1">
		<variables>
			<aux name="effect of STA on river cooled thermal power\nenergy capacity efficiency" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF (switch_energy_damage = 0) AND TIME &gt; today THEN
previous_effect_of_STA_on_thermal_power_energy_capacity_efficiency
ELSE
1+ (effect_of_STA_on_river_cooled_thermal_powerplant_energy_capacity_efficiency_slope[selected_energy_supply_damages_case]*Surface_Temperature_Anomaly+effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency_quadratic[selected_energy_supply_damages_case]*Surface_Temperature_Anomaly^2)/100</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of STA on river cooled thermal powerplant\nenergy capacity\nefficiency slope">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="EnergySupplyThermoDamage"/>
				</dimensions>
				<element subscript="1">
