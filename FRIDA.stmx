				<aux background="#55AA00" x="305.357" y="1583.11" name="adaptive energy\ninvestments proportional factor"/>
				<aux x="1421.89" y="237.673" name="Share of Energy Gross Expenditure invested in fuel extraction"/>
				<aux x="1684.38" y="229.816" name="Share of Energy Gross Expenditure\ninvested in fossil energy"/>
				<aux x="955.174" y="856.59" name="All Gross Energy Investments"/>
				<aux x="311.79" y="1376.56" name="Relative Energy Supply Missmatch"/>
				<aux background="#55AA00" x="765.791" y="1590.2" name="adaptive energy\ninvestments integrating factor"/>
				<aux background="#55AA00" x="501.416" y="1583.95" name="adaptive energy\ninvestments differntiating factor"/>
				<aux x="507.441" y="1514.87" name="Differentiating Relative Energy Supply Missmatch"/>
				<text_box uid="1" x="399.374" y="1747.68" width="260" height="58">This is a PID controler
https://en.wikipedia.org/wiki/Proportional%E2%80%93integral%E2%80%93derivative_controller</text_box>
				<text_box uid="2" x="399.374" y="1705.48" width="260" height="29.6667">PID factors. Negative values dampen deviations, positive values amplify</text_box>
				<text_box uid="3" x="236.481" y="1635.93" width="131.667" height="15">Proportional control</text_box>
				<text_box uid="4" x="428.452" y="1642.86" width="145.928" height="16.875">differentiating control, smoothes </text_box>
