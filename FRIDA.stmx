			<aux name="Simulation End">
				<doc>${No Sensi}
This is what determines when the model stops calculating</doc>
				<eqn>2150</eqn>
				<format precision="1"/>
				<range min="2023" max="2200"/>
				<units>years</units>
			</aux>
			<isee:placeholder name="Dashboard Right Placeholder">
				<dimensions>
					<dim name="Run"/>
