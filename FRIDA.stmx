				<aux font_style="italic" font_weight="bold" x="3455" y="987.807" name="Other Energy Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital 1"/>
				<aux font_style="italic" font_weight="bold" x="3448.75" y="1064.38" name="Investments Allocated to Capacity Construction in\nOther Capacity"/>
				<connector uid="62" angle="187.001">
					<from>Other_Energy_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital_1</from>
