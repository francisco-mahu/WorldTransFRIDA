				</connector>
				<connector uid="5" angle="44.3319">
					<from>carbon_intensity_in_btu</from>
					<to>Carbon_Intensity</to>
				</connector>
				<aux x="910.04" y="899.411" name="Cost of Extra delta Energy\nOutput through Capital"/>
				<aux x="691.71" y="910.002" name="Extra FUEL needed\nfor Extra delta Energy"/>
				<aux x="678.83" y="978.47" name="Carbon needed for one extra Energy"/>
				<connector uid="6" angle="259.35">
					<from>Extra_FUEL_needed_for_Extra_delta_Energy</from>
					<to>Carbon_needed_for_one_extra_Energy</to>
				</connector>
