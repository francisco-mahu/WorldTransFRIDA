					<from>Fossil_Fuel_Extraction_Capital</from>
					<to>desired_Fossil_Fuel_Extraction_Capital_Damaged_due_to_STA</to>
				</connector>
				<connector uid="28" angle="328.396">
					<from>Policy_Start_Year</from>
					<to>desired_Decomisioning_of_fossil_fuel_extraction_capital</to>
				</connector>
				<connector uid="29" angle="7.77516">
					<from>rate_of_decommissioning_fossil_fuel_extraction_capital</from>
