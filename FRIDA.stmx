					<to>Share_of_Oil_demand_for_Industry_and_Other</to>
				</connector>
				<aux background="#FFAAFF" x="2142.09" y="170.43" name="Share of Oil demand for\nTransportation"/>
				<connector uid="902" angle="81.9066">
					<from>Fossil_oil</from>
					<to>Share_of_Oil_demand_for_Transportation</to>
				</connector>
				<connector uid="904" angle="26.3052">
					<from>Direct_use_Oil_demand</from>
					<to>Share_of_Oil_demand_for_Transportation</to>
				</connector>
				<connector uid="905" angle="4.98807">
					<from>Direct_use_Oil_demand</from>
					<to>Share_of_Oil_demand_for_Industry_and_Other</to>
				</connector>
				<aux background="#FFAAFF" x="2174.48" y="1067.38" name="Share of Oil demand for\nBuildings"/>
				<connector uid="906" angle="90.2729">
					<from>Fossil_oil_2</from>
					<to>Share_of_Oil_demand_for_Buildings</to>
				</connector>
				<connector uid="907" angle="344.984">
					<from>Direct_use_Oil_demand</from>
					<to>Share_of_Oil_demand_for_Buildings</to>
				</connector>
				<aux background="white" x="1279.77" y="680.393" name="Direct use Other demand in zJ 1"/>
				<aux background="white" x="1279.77" y="827.381" name="Other Share"/>
				<aux background="#FFAAFF" x="1279.77" y="744.936" name="Direct use Other demand"/>
				<connector uid="908" angle="90">
					<from>Direct_use_Other_demand</from>
					<to>Direct_use_Other_demand_in_zJ_1</to>
				</connector>
				<connector uid="909" angle="270">
					<from>Direct_use_Other_demand</from>
					<to>Other_Share</to>
				</connector>
				<connector uid="910" angle="200.485">
					<from>Other</from>
					<to>Direct_use_Other_demand</to>
				</connector>
				<connector uid="911" angle="179.097">
					<from>Other_1</from>
					<to>Direct_use_Other_demand</to>
				</connector>
				<connector uid="912" angle="156.342">
					<from>Other_2</from>
					<to>Direct_use_Other_demand</to>
				</connector>
				<connector uid="913" angle="340.443">
					<from>Switch_to_couple_investments_supply_and_demand_in_new_energy</from>
					<to>Direct_use_Other_demand_in_zJ_1</to>
				</connector>
				<connector uid="914" angle="351.684">
					<from>UNIT_TWh_to_zJ_1</from>
					<to>Direct_use_Other_demand_in_zJ_1</to>
				</connector>
				<connector uid="915" angle="353.111">
					<from>Total_demand_for_energy</from>
					<to>Other_Share</to>
				</connector>
				<connector uid="917" angle="176.934">
					<from>Direct_use_Other_demand</from>
					<to>Total_demand_for_energy</to>
				</connector>
				<alias background="white" font_style="italic" uid="685" x="3464.88" y="776.296" width="18" height="18">
					<of>Total_demand_for_energy</of>
				</alias>
			</view>
		</views>
	</model>
	<model name="Buildings_energy_demand_1">
		<variables>
			<aux name="Desired Electrification SHARE for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_electrification_share_for_Buildings*normal_electrification_share_for_Buildings*effect_of_energy_prices_on_electrification_share_for_Buildings</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal electrification\nshare for Buildings" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.121332111499911</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of energy prices on electrification\nshare for Buildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_change_in_energy_prices_in_electricity_1-1)-1)*sensitivity_of_effect_of_energy_prices_on_electrification_share_for_Buildings*Switch_to_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect\nof energy prices on electrification\nshare for Buildings" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.16825546220087</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity demand for\nBuildings" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Electrification_SHARE_for_Buildings[Run]*total_energy_demand_for_Buildings[Run]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Non Electricity demand for\nBuildings" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-Desired_Electrification_SHARE_for_Buildings)*total_energy_demand_for_Buildings</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="effect of GDP on\nenergy demand for\nBuildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_energy_demand_for_Buildings_alpha*(relative_global_real_GDP_in_2022)^(effect_of_GDP_on_energy_demand_for_Buildings_beta)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal per sector\nenergy demand\nfor Buildings" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>16058.1204493281</eqn>
				<range min="10000" max="25000"/>
				<units>TWh/year</units>
			</aux>
			<aux name="effect of GDP on energy\ndemand for Buildings alpha" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.31225797585093</eqn>
				<range min="0" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="total energy demand for\nBuildings" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(normal_per_sector_energy_demand_for_Buildings+(total_heating_and_cooling_energy_demand/UNIT_TWh_to_MWh))*effect_of_GDP_on_energy_demand_for_Buildings*effect_of_energy_prices_on_Buildings_demand</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="effect of GDP on energy\ndemand for Buildings beta" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.29255031272461</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification share\nfor Buildings">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_electrification_share_for_Buildings_alpha*(relative_global_real_GDP_in_2022)^(effect_of_GDP_on_electrification_share_for_Buildings_beta)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification\nshare for Buildings alpha" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.46924252598871</eqn>
				<range min="0" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification\nshare for Buildings beta" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.445522527607885</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="relative global real GDP in 2022" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>dmnl</units>
			</aux>
			<aux name="relative change\nin energy prices\nin electricity 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CDD" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>CDD_historical+CDD_linear_coefficient*Surface_Temperature_Anomaly</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD_historical*EXP(HDD_exponential_coefficient*Surface_Temperature_Anomaly)</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="CDD linear coefficient">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>287.8469604</eqn>
				</element>
				<range min="230" max="330"/>
				<units>CDD/(deg C*p*Year)</units>
			</aux>
			<aux name="CDD historical">
				<doc>${Climate Impact Parameter,External Parameter}
Based on GCM output of the past</doc>
				<eqn>704.2162675</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD historical">
				<doc>${Climate Impact Parameter,External Parameter}
Based on GCM output of the past</doc>
				<eqn>1375.71022</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="HDD exponential coefficient">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-0.232561095</eqn>
				</element>
				<range min="-0.5" max="-0.01"/>
				<units>1/(deg C)</units>
			</aux>
			<aux name="CDD change to preindustrial">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>CDD-CDD_preindustrial</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="CDD preindustrial" access="output" isee:autocreated="true">
				<eqn>CDD_historical</eqn>
				<units>CDD/p/year</units>
			</aux>
			<aux name="HDD preindustrial">
				<eqn>HDD_historical</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="HDD change to preindustrial">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD-HDD_preindustrial</eqn>
				<units>HDD/p/year</units>
			</aux>
			<aux name="Change in energy used for Heating due to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>HDD_change_to_preindustrial*Energy_use_per_HDD</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Energy use per HDD">
				<doc>${Climate Impact Parameter,External Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.002</eqn>
				</element>
				<range min="0.0001" max="0.01"/>
				<units>GJ/(HDD)</units>
			</aux>
			<aux name="energy use per CDD">
				<doc>${Climate Impact Parameter,External Parameter}
	Calibrated To Rode	Calibrated To Clark
1980	0.000875	0.007
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.000875</eqn>
				</element>
				<range min="0.0004" max="0.01"/>
				<units>GJ/(CDD)</units>
			</aux>
			<aux name="Change in energy used for\ncooling due to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>energy_use_per_CDD*CDD_change_to_preindustrial</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Change in energy used for\ncooling due to climate change in MWh" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>UNIT_GJ_to_MWh*Change_in_energy_used_for_cooling_due_to_climate_change</eqn>
				<units>MWh/(Person*Year)</units>
			</aux>
			<aux name="Change in energy used for\nHeating due to climate change in MWh">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>UNIT_GJ_to_MWh*Change_in_energy_used_for_Heating_due_to_climate_change</eqn>
				<units>MWh/(Person*Year)</units>
			</aux>
			<aux name="total change in energy used for\nheating and cooling\ndue to climate change">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Change_in_energy_used_for_Heating_due_to_climate_change_in_MWh + Change_in_energy_used_for_cooling_due_to_climate_change_in_MWh</eqn>
				<units>MWh/(Person*Year)</units>
			</aux>
			<aux name="total change in energy used for\nheating and cooling\ndue to climate change in GJ">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Change_in_energy_used_for_Heating_due_to_climate_change + Change_in_energy_used_for_cooling_due_to_climate_change</eqn>
				<units>GJ/(Person*Year)</units>
			</aux>
			<aux name="Surface Temperature Anomaly" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>deg C</units>
			</aux>
			<aux name="today" access="input">
				<eqn>2025</eqn>
				<units>year</units>
			</aux>
			<aux name="switch energy damage" access="input">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="UNIT GJ to MWh" access="input">
				<eqn>0.277778</eqn>
				<units>MWh/GJ</units>
			</aux>
			<aux name="total heating and\ncooling energy demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF (switch_energy_damage=0) AND TIME &gt; today THEN
(((HDD*Energy_use_per_HDD+CDD*energy_use_per_CDD)*UNIT_GJ_to_MWh)-total_change_in_energy_used_for_heating_and_cooling_due_to_climate_change)*Population*UNIT_p_per_mp
ELSE
(((HDD*Energy_use_per_HDD+CDD*energy_use_per_CDD)*UNIT_GJ_to_MWh)*Population*UNIT_p_per_mp)</eqn>
				<units>MWh/year</units>
			</aux>
			<aux name="Population" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp</units>
			</aux>
			<aux name="UNIT p per mp" access="input">
				<eqn>1000000</eqn>
				<units>p/Mp</units>
			</aux>
			<aux name="Switch to energy prices" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="non electricity demand allocator per energy carrier">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>ALLOCATE(Non_Electricity_demand_for_Buildings[Run], NonEleEnergyCarriers, desired_energy_demand_by_carrier[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>110.126454057936</eqn>
				<range min="1" max="1000"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost)</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="suitability cost adjustment" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<element subscript="1, Coal">
					<eqn>5.60887325895738</eqn>
				</element>
				<element subscript="1, Oil">
					<eqn>17.3923416069801</eqn>
				</element>
				<element subscript="1, Gas">
					<eqn>15.2184125959162</eqn>
				</element>
				<element subscript="1, Other">
					<eqn>63.2911747691084</eqn>
				</element>
				<range min="1e-12" max="400"/>
				<units>dmnl</units>
			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>cost_to_build_per_unit*(1/suitability_cost_adjustment)</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Coal" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Coal]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Liquid fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Biofuel+Oil</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Gas" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Gas]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="cost to build per unit" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="desired energy demand\nby carrier">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>Non_Electricity_demand_for_Buildings[Run]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Oil" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Oil]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="share of biofuel\nin other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.6</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Biofuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_biofuel_in_other*Other</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="effect\nof energy prices on\nBuildings demand" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="UNIT TWh to MWh" access="input">
				<eqn>1000000</eqn>
				<units>MWh/TWh</units>
			</aux>
			<aux name="Other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Other]</eqn>
				<units>TWh/Year</units>
			</aux>
