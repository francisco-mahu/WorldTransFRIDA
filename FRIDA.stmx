	</model>
	<model name="Global_Investments">
		<variables>
			<aux name="World GDP">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>&quot;Real_GDP_in_2021c$&quot;[Run]*&quot;UNIT_Bc$_to_c$&quot;</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested in Renewable Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_hydropower[Run]+
share_of_GDP_invested_in_solar_and_wind[Run]+
share_of_GDP_invested_in_bio_power[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in Fossil Energy and Fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_fuel_extraction[Run]+share_of_GDP_invested_in_fossil_energy[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in Energy" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_Fossil_Energy_and_Fuel[Run]+share_of_GDP_invested_in_Renewable_Energy[Run]+share_of_GDP_invested_in_nuclear_power[Run]
+share_of_GDP_invested_in_Other_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin Energy without fuel" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_Energy[Run]-share_of_GDP_invested_in_fossil_energy[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure invested in fuel extraction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital[Run]/Total_Energy_Investment_Allocated_to_Capacity_Construction</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin nuclear power">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]/Total_Energy_Investment_Allocated_to_Capacity_Construction</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin hydropower">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin solar and wind">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run]+Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity[Run])/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin fuel extraction">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Investments Allocated to Capacity\nConstruction in Renewables">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity[Run]+Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]+Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity[Run]+Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments in Fossil Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital[Run]+Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Fossil\nFuel Extraction Capital">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital[Run]+Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital[Run]+Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Fossil\nEnergy Capital">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]+Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]+Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Fossil\nEnergy Capital oil and gas" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]+Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested\nin bio power">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Real GDP in 2021c$" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>bc$/year</units>
			</aux>
			<aux name="UNIT Bc$ to c$" access="input">
				<eqn>1000000000</eqn>
				<units>c$/bc$</units>
			</aux>
			<aux name="Energy Investments with\nTaxes and Subsidies" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital + Coal_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Energy_Conversion_Capital + Oil_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital + Oil_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Energy_Conversion_Capital + Gas_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital + Gas_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Energy_Conversion_Capital + Solar_Investments_Including_Taxes_Paid_and_Subsidies_Received + Wind_Investments_Including_Taxes_Paid_and_Subsidies_Received + Hydropower_Investments_Including_Taxes_Paid_and_Subsidies_Received + Biofuel_Investments_Including_Taxes_Paid_and_Subsidies_Received + Nuclear_Investments_Including_Taxes_Paid_and_Subsidies_Received+Other_Energy_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital_1</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Energy Investment Allocated to Capacity Construction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments in Nuclear Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Hydropower Energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Solar Energy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in wind Energy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Biofuel Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross Investments in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Gross Investments in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross Investments in Fossil Energy Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in Fossil Energy Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Gross Investments in Fossil Energy Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Including Taxes Paid and Subsidies Received in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Including Taxes Paid and Subsidies Received in Energy Conversion Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid and Subsidies Received in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid and Subsidies Received in Energy Conversion Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in Energy Conversion Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Solar Investments Including Taxes Paid and Subsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Wind Investments Including Taxes Paid and Subsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Hydropower Investments Including Taxes Paid and Subsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Biofuel Investments Including Taxes Paid and Subsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Nuclear Investments Including Taxes Paid and Subsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Other Energy Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nOther Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested\nin Other energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Other_Capacity/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Energy Investment Allocated\nto Capacity Construction\nfor Coal" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Energy Investment Allocated\nto Capacity Construction\nfor Liquid fuel" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
