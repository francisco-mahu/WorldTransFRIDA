			<module name="Nuclear energy 1" isee:label="">
				<format scale_by="auto"/>
				<connect to="Electricity_investments.Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6" from="Nuclear_energy_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect2 to="Electricity_investments.Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6" from="Nuclear_energy_1.Cost_net_of_taxes_of_Extra_Energy_Output_through_Capital_per_Unit"/>
				<connect to="Energy_supply_1.Nuclear_Energy_Capacity" from="Nuclear_energy_1.Nuclear_Energy_Capacity"/>
				<connect2 to="Nuclear_Energy_Capacity" from="Nuclear_energy_1.Nuclear_Energy_Capacity"/>
				<connect to="Energy_supply_1.Nuclear_Energy_Output" from="Nuclear_energy_1.Nuclear_Energy_Output"/>
				<connect2 to="Nuclear_Energy_Output" from="Nuclear_energy_1.Nuclear_Energy_Output"/>
				<connect to="Nuclear_energy_1.damage_rate_of_energy_capital_from_STA" from="Damages_1.damage_rate_of_energy_capital_from_STA"/>
				<connect2 to="Nuclear_energy_1.damage_rate_of_energy_capital_from_STA" from="Damages_1.damage_rate_of_energy_capital_from_STA"/>
				<connect to="Nuclear_energy_1.deltaEnergy_for_costs" from="Energy_supply_1.deltaEnergy_for_costs"/>
				<connect2 to="Nuclear_energy_1.deltaEnergy_for_costs" from="deltaEnergy_for_costs"/>
				<connect to="Nuclear_energy_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect2 to="Nuclear_energy_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect to="Nuclear_energy_1.Investments_in_Nuclear_Capacity" from="Electricity_investments.Investments_in_Nuclear_Capacity"/>
				<connect2 to="Nuclear_energy_1.Investments_in_Nuclear_Capacity" from="Electricity_investments.Investments_in_Nuclear_Capacity"/>
				<connect to="Nuclear_energy_1.kW_to_GW" from="Energy_Units_1.UNIT_kW_to_GW"/>
				<connect2 to="Nuclear_energy_1.kW_to_GW" from="Energy_Units_1.UNIT_kW_to_GW"/>
				<connect to="Nuclear_energy_1.start_year" from="Government_Regulations.start_year"/>
				<connect2 to="Nuclear_energy_1.start_year" from="Government_Regulations.start_year"/>
				<connect to="Nuclear_energy_1.tax_for_newly_installed_nuclear" from="Government_Regulations.tax_rate_on_newly_installed_nuclear_energy_capacity"/>
				<connect2 to="Nuclear_energy_1.tax_for_newly_installed_nuclear" from="Government_Regulations.tax_rate_on_newly_installed_nuclear_energy_capacity"/>
				<connect to="Nuclear_energy_1.TWh_to_kWh" from="Energy_Units_1.UNIT_TWh_to_kWh"/>
				<connect2 to="Nuclear_energy_1.TWh_to_kWh" from="Energy_Units_1.UNIT_TWh_to_kWh"/>
				<connect to="Nuclear_energy_1.UNIT_GW_to_TW" from="Energy_Units_1.UNIT_GW_to_TW"/>
				<connect2 to="Nuclear_energy_1.UNIT_GW_to_TW" from="Energy_Units_1.UNIT_GW_to_TW"/>
				<connect to="Nuclear_energy_1.UNIT_kW_to_TW" from="Energy_Units_1.UNIT_kW_to_TW"/>
				<connect2 to="Nuclear_energy_1.UNIT_kW_to_TW" from="Energy_Units_1.UNIT_kW_to_TW"/>
			</module>
			<aux name="Nuclear Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<stock name="Nuclear Energy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>GW</units>
			</stock>
			<aux name="Total Energy Output" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
This is total energy production of both fossil and renewable</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity+Energy_output_gas+Energy_output_liquid+Energy_output_solid</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Renewable Energy\nOutput" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Years</units>
			</aux>
			<aux name="Solar and Wind\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_and_Solar_Energy_Output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Renewable Energy\nOutput Share" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Renewable_Energy_Output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Hydropower\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Hydropower_Energy_Output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Hydropower Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Secondary Fossil Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="average\nconversion efficiency of fossil\nfuels to secondary\nfossil energy" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Primary Fossil Energy (FUEL)" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 1" access="output" throughput="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Secondary Fossil Energy Output 3" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Fossil Energy\nOutput Share, coal">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_1/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil Energy Output\nShare, oil">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_2/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil Energy Output\nShare, gas">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_3/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="deltaEnergy for costs">
				<doc>${Assumption,No Sensi}
Arbitrary unit of energy used to calculate the differentials of cost to produce it</doc>
				<eqn>1</eqn>
				<units>TWh/Year</units>
			</aux>
			<module name="Efficiency reduction in\npower plants 1" isee:label="">
				<format scale_by="auto"/>
				<connect to="Hydropower_energy_1.effect_of_STA_on_hydropower_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_hydropower_energy_capacity_efficiency"/>
				<connect2 to="Hydropower_energy_1.effect_of_STA_on_hydropower_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_hydropower_energy_capacity_efficiency"/>
				<connect to="Fossil_energy_coal_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect2 to="Fossil_energy_coal_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect to="Fossil_energy_gas_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect2 to="Fossil_energy_gas_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect to="Fossil_energy_oil_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect2 to="Fossil_energy_oil_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect to="Nuclear_energy_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect2 to="Nuclear_energy_1.effect_of_STA_on_thermal_power_energy_capacity_efficiency" from="Efficiency_reduction_in_power_plants_1.effect_of_STA_on_river_cooled_thermal_power_energy_capacity_efficiency"/>
				<connect to="Efficiency_reduction_in_power_plants_1.selected_energy_supply_hydroelectric_damages_case" from="Climate_Units.selected_energy_supply_hydroelectric_damages_case"/>
				<connect2 to="Efficiency_reduction_in_power_plants_1.selected_energy_supply_hydroelectric_damages_case" from="Climate_Units.selected_energy_supply_hydroelectric_damages_case"/>
				<connect to="Efficiency_reduction_in_power_plants_1.selected_energy_supply_damages_case" from="Climate_Units.selected_energy_supply_thermoelectric_damages_case"/>
				<connect2 to="Efficiency_reduction_in_power_plants_1.selected_energy_supply_damages_case" from="Climate_Units.selected_energy_supply_thermoelectric_damages_case"/>
				<connect to="Efficiency_reduction_in_power_plants_1.Surface_Temperature_Anomaly" from="Energy_Balance_Model.Surface_Temperature_Anomaly"/>
				<connect2 to="Efficiency_reduction_in_power_plants_1.Surface_Temperature_Anomaly" from="Energy_Balance_Model.Surface_Temperature_Anomaly"/>
				<connect to="Efficiency_reduction_in_power_plants_1.switch_energy_damage" from="Climate.switch_energy_damage"/>
				<connect2 to="Efficiency_reduction_in_power_plants_1.switch_energy_damage" from="Climate.switch_energy_damage"/>
				<connect to="Efficiency_reduction_in_power_plants_1.today" from="Climate.climate_impact_stoptime"/>
				<connect2 to="Efficiency_reduction_in_power_plants_1.today" from="Climate.climate_impact_stoptime"/>
			</module>
			<aux name="Bio Energy\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>bio_fuel_secondary_energy_output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="bio fuel secondary energy output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Wind and Solar Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Solar Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Wind Energy Output" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Solar Energy\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Energy_Output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Wind Energy\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_Energy_Output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Population" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp</units>
			</aux>
			<aux name="per person energy output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Total_Energy_Output/Population</eqn>
				<units>MWh/(p*year)</units>
			</aux>
			<aux name="Clean energy Output share" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Nuclear_Energy_Output_Share+Renewable_Energy_Output_Share</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_electricity/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Solid fuel\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_solid/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Liquid fuel\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_liquid/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gas fuel\nOutput Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_output_gas/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Energy output electricity" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Clean_electricity+Secondary_Fossil_Energy_Output_1+Secondary_Fossil_Energy_Output_2+Secondary_Fossil_Energy_Output_3</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output solid" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_for_Fuel/UNIT_TWh_to_zJ</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output liquid" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Primary_Fossil_Energy_FUEL_for_Fuel_1+bio_fuel_primary_energy_1)/UNIT_TWh_to_zJ</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Energy output gas" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_for_Fuel_2/UNIT_TWh_to_zJ</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Renewable energy output 1" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Energy_Output+Wind_Energy_Output+bio_fuel_primary_energy_1/UNIT_TWh_to_zJ+Hydropower_Energy_Output</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Coal share in electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_1/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Oil share in electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_2/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gas share in electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output_3/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Solar energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Solar_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Wind energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Wind_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Nuclear Energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Nuclear_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Hydropower Energy share\nin electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Hydropower_Energy_Output/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Clean electricity" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Nuclear_Energy_Output+Hydropower_Energy_Output+Wind_Energy_Output+Solar_Energy_Output</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="share of electricity\nproduction from renewables">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Clean_electricity-Nuclear_Energy_Output)/Energy_output_electricity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="bio fuel primary energy 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="UNIT TWh to zJ" access="input">
				<eqn>0.00000359999999971</eqn>
				<units>zJ/TWh</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Fuel" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Fuel 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL for Fuel 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
