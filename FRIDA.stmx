	<model name="Stranded_Capital">
		<variables>
			<aux name="investment priority adjustment\nfrom stranded capital" access="output">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>MAX(0, 1-relative_stranded_capital[Run,EnergySourceEle]*sensitivity_of_cost_adjustment_to_relative_stranded_capital[Run])</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Fossil Energy Capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<stock name="Fossil Energy Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<stock name="Fossil Energy Capital 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>c$</units>
			</stock>
			<aux name="relative stranded capital">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySourceEle"/>
				</dimensions>
				<eqn>SMTH1((IF EnergySourceEle = EnergySourceEle.Coal_energy_conversion  THEN
stranded_capital[Run]/Fossil_Energy_Capital[Run]
ELSE IF EnergySourceEle = EnergySourceEle.Oil_energy_conversion  THEN
stranded_capital_2[Run]/Fossil_Energy_Capital_2[Run]
ELSE IF EnergySourceEle  = EnergySourceEle.Gas_energy_conversion  THEN
stranded_capital_1[Run]/Fossil_Energy_Capital_1[Run]
ELSE
0)*time_to_consider_stranded_capital[Run], time_to_consider_stranded_capital[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="time to consider\nstranded capital">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>3</eqn>
				<range min="2" max="5"/>
				<units>year</units>
			</aux>
			<aux name="stranded capital 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="stranded capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="sensitivity of cost\nadjustment to relative stranded capital">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>99.307746077223</eqn>
				<range min="50" max="150"/>
				<units>dmnl</units>
			</aux>
			<aux name="stranded capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
		</variables>
