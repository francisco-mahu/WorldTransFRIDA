			<aux name="Nuclear Energy Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Nuclear_Energy_Output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Fossil Energy Output Share">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Secondary_Fossil_Energy_Output/Total_Energy_Output</eqn>
				<units>dmnl</units>
			</aux>
