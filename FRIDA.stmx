			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>MAX(1e-12, cost_to_build_per_unit*interpolated_historical_cost_adjustment[Run,EnergySource])</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="pct of history">
				<eqn>(TIME-STARTTIME)/(2020-STARTTIME)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="interpolated historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>SMTH1(INTERPOLATE(historical_cost_adjustment[Run,EnergySource,*], pct_of_history), historical_cost_adjustment_smoothing_time[Run])</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="historical cost adjustment smoothing time" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.527820351727681</eqn>
				<range min="0.25" max="0.75"/>
				<units>years</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch with Buffer">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Relative_Energy_Supply_Missmatch-Relative_Energy_Supply_Mismatch_Buffer</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Relative Energy Supply Mismatch Buffer">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.01</eqn>
				<range min="0" max="0.05"/>
				<units>dmnl</units>
			</aux>
			<aux name="Total Gross Investments in Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital + Gross_Investments_in_Fossil_Fuel_Extraction_Capital + Gross_Investments_in_Renewables+Investments_in_Nuclear_Capacity</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Moratorium on fossil energy year" access="input">
				<eqn>2050</eqn>
				<units>Year</units>
			</aux>
			<aux name="Gross Investments in\nBiofuel Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Bio]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in bio energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Biofuel_Capacity/All_Gross_Energy_Investments</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin bio power">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Biofuel_Capacity/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Cost of Extra Energy Output\nthrough Capital per Unit 7" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="average marginal\nnet cost of energy without historical cost adjustment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
cost_of_extra_energy_output_through_fuel_extraction_per_unit * Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital 
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit * Coal_Gross_Investments_in_Fossil_Energy_Capital
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_2 * Oil_Gross_Investments_in_Fossil_Energy_Capital
+
cost_of_extra_energy_output_through_fuel_extraction_per_unit_2 * Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital
+
cost_of_extra_energy_output_through_fuel_extraction_per_unit_1 * Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_1 * Gas_Gross_Investments_in_Fossil_Energy_Capital
+
Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8 * Gross_Investments_in_Solar_Energy_Capacity
+
Cost_of_Extra_Energy_Output_through_Capital_per_Unit_9 * Gross_Investments_in_wind_Energy_Capacity
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_4 * Gross_Investments_in_Hydropower_Energy_capacity
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_7 * Gross_Investments_in_Biofuel_Capacity
+ Cost_of_Extra_Energy_Output_through_Capital_per_Unit_6 * Investments_in_Nuclear_Capacity
)
/Total_Gross_Investments_in_Energy</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="average marginal\nnet cost of energy with historical cost adjustment" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(
adjusted_cost[Run,Coal_fuel_extraction] * Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital 
+ adjusted_cost[Run,Coal_energy_conversion] * Coal_Gross_Investments_in_Fossil_Energy_Capital
+
adjusted_cost[Run,Oil_fuel_extraction] * Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital
+
adjusted_cost[Run,Solar]*Gross_Investments_in_Solar_Energy_Capacity
+
adjusted_cost[Run,Wind]*Gross_Investments_in_wind_Energy_Capacity
+
adjusted_cost[Run,Oil_energy_conversion] * Oil_Gross_Investments_in_Fossil_Energy_Capital
+ adjusted_cost[Run,Gas_energy_conversion] * Gas_Gross_Investments_in_Fossil_Energy_Capital
+ adjusted_cost[Run,Hydropower] * Gross_Investments_in_Hydropower_Energy_capacity
+ adjusted_cost[Run,Bio] * Gross_Investments_in_Biofuel_Capacity
+ adjusted_cost[Run,Nuclear] * Investments_in_Nuclear_Capacity
)
/Total_Gross_Investments_in_Energy</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\ncoal extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\ncoal extraction" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Net Investments in Fossil\nFuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Gross_Investments_in_Fossil_Fuel_Extraction_Capital + expenditure_on_subsidies_for_investments_in_coal_extraction + tax_revenue_on_investments_in_coal_extraction</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\ncoal energy conversion" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
