				<aux x="1445.45" y="996.24" name="time to perceive\nchanges in investment"/>
				<aux x="1294.23" y="646.928" name="Primary Fossil\nEnergy FUEL by type"/>
				<aux x="1368.95" y="887.8" name="Perceived Energy missmatch in fuel"/>
				<aux x="1518.24" y="894.29" name="Perceived Energy missmatch in electricity"/>
				<connector uid="193" angle="54.4748">
