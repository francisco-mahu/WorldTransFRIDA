	</model>
	<model name="Transportation_energy_demand_1">
		<variables>
			<aux name="Desired Electrification SHARE for\nTransportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_electrification_share_for_fordustry_and_Other*normal_electrification_share_for_fordustry_and_Other*effect_of_energy_prices_on_electrification_share_for_Transportation</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal electrification\nshare for fordustry\nand Other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0057675125402271</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of energy prices on electrification\nshare for Transportation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_change_in_energy_prices_in_electricity_1-1)-1)*sensitivity_of_effect_of_energy_prices_on_electrification_share_for_Transportation*Switch_to_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect\nof energy prices on electrification\nshare for Transportation" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.902630121625908</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Electricity demand for\nTransportation" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Desired_Electrification_SHARE_for_Transportation[Run]*total_energy_demand_for_Transportation)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Non Electricity demand for\nTransportation" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((1-Desired_Electrification_SHARE_for_Transportation)*total_energy_demand_for_Transportation)</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="effect of GDP on\nelectrification share for\nfordustry and Other">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>effect_of_GDP_on_electrification_share_for_fordustry_and_Other_alpha*(relative_global_real_GDP_in_2022)^(effect_of_GDP_on_electrification_share_for_fordustry_and_Other_beta)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification\nshare for fordustry and Other alpha" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.65516482690388</eqn>
				<range min="0" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of GDP on\nelectrification\nshare for fordustry and Other beta" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.0214852353906317</eqn>
				<range min="0" max="2"/>
				<units>dmnl</units>
			</aux>
			<aux name="relative global real GDP in 2022" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>dmnl</units>
			</aux>
			<aux name="relative change\nin energy prices\nin electricity 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Total yearly demand 1" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="Switch to energy prices" access="output" throughput="true">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="non electricity demand allocator per energy carrier">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>ALLOCATE(Non_Electricity_demand_for_Transportation[Run], NonEleEnergyCarriers, desired_energy_demand_by_carrier[Run,*],  priority_by_source[Run,*], priority_spread[Run], shape)</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="priority spread" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>217.22271682568</eqn>
				<range min="1" max="1000"/>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="shape">
				<doc>${Internal Calibration Parameter,No Sensi}
</doc>
				<eqn>1 {1 or 2 or 3}</eqn>
				<format precision="1"/>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="priority by source">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>MIN(1e6,1/adjusted_cost)</eqn>
				<units>kWh/(c$*Years)</units>
			</aux>
			<aux name="suitability cost adjustment" access="output" isee:autocreated="true">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<element subscript="1, Coal">
					<eqn>1.04871875928957</eqn>
				</element>
				<element subscript="1, Oil">
					<eqn>215.276417364739</eqn>
				</element>
				<element subscript="1, Gas">
					<eqn>68.5298600051959</eqn>
				</element>
				<element subscript="1, Other">
					<eqn>191.971001998509</eqn>
				</element>
				<range min="1e-12" max="400"/>
				<units>dmnl</units>
			</aux>
			<aux name="adjusted cost">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>cost_to_build_per_unit*(1/suitability_cost_adjustment)</eqn>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="Coal" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Coal]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Gas" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Gas]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="cost to build per unit" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<units>c$*Years/kWh</units>
			</aux>
			<aux name="desired energy demand\nby carrier">
				<dimensions>
					<dim name="Run"/>
					<dim name="NonEleEnergyCarriers"/>
				</dimensions>
				<eqn>Non_Electricity_demand_for_Transportation[Run]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Oil" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Oil]</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="total energy demand for\nTransportation" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Total_yearly_demand_1</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>non_electricity_demand_allocator_per_energy_carrier[Run,Other]</eqn>
				<units>TWh/Year</units>
			</aux>
			<aux name="share of biofuel\nin other" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.9</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Biofuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Other*share_of_biofuel_in_other</eqn>
				<units>TWh/year</units>
			</aux>
			<aux name="Liquid fuel" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Biofuel+Oil</eqn>
				<units>TWh/year</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
