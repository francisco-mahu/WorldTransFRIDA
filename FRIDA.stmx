				<connect to="Other_energy.Investments_Allocated_to_Capacity_Construction_in_Other_Capacity" from="Other_Energy_investments.Investments_Allocated_to_Capacity_Construction_in_Other_Capacity"/>
				<connect2 to="Other_energy.Investments_Allocated_to_Capacity_Construction_in_Other_Capacity" from="Other_Energy_investments.Investments_Allocated_to_Capacity_Construction_in_Other_Capacity"/>
				<connect to="Other_energy.kW_to_TW" from="Energy_Units_1.UNIT_kW_to_TW"/>
