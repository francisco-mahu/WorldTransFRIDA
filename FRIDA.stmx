				</connector>
				<aux x="205.833" y="709.583" name="average energy margins LIQUID"/>
				<connector uid="61" angle="63.6025">
					<from>average_energy_margins_LIQUID</from>
					<to>perceived_energy_supply_margins_1</to>
				</connector>
				<aux background="white" x="618.476" y="391.603" name="Baseline of investments\nfor Liquid fuel"/>
				<connector uid="63" angle="350.007">
					<from>Baseline_of_investments_for_Liquid_fuel</from>
					<to>Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="435.227" y="964.727" name="Converter 1"/>
				<connector uid="64" angle="286.471">
					<from>Converter_1</from>
					<to>Relative_Energy_Supply_Mismatch_with_Buffer_1</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="514.03" y="884.091" name="Switch to couple investments supply and demand in new energy"/>
				<connector uid="65" angle="263.001">
					<from>Switch_to_couple_investments_supply_and_demand_in_new_energy</from>
					<to>Relative_Energy_Supply_Mismatch_with_Buffer_1</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="1572.03" y="928.48" name="cost of extra energy output through fuel extraction per unit 3"/>
				<aux font_style="italic" font_weight="bold" x="1572.03" y="1018.68" name="Cost of Extra Energy Output\nthrough Capital per Unit 8"/>
				<aux x="1233.17" y="910.48" name="cost to build\nper unit 2"/>
				<connector uid="66" angle="177.757">
					<from>cost_of_extra_energy_output_through_fuel_extraction_per_unit_3</from>
					<to>cost_to_build_per_unit_2</to>
				</connector>
				<connector uid="67" angle="162.291">
					<from>Cost_of_Extra_Energy_Output_through_Capital_per_Unit_8</from>
					<to>cost_to_build_per_unit_2</to>
				</connector>
				<connector uid="69" angle="90.342">
					<from>cost_to_build_per_unit_2</from>
					<to>cost_to_build_per_unit_1</to>
				</connector>
				<aux font_style="italic" font_weight="bold" x="1437" y="641.98" name="Switch to couple investments supply and demand in new energy 2"/>
				<connector uid="70" angle="209.919">
					<from>Switch_to_couple_investments_supply_and_demand_in_new_energy_2</from>
					<to>cost_to_build_per_unit_1</to>
				</connector>
				<aux x="1199.17" y="315.694" name="Liquid fuel Gross\nInvestments in Fossil\nFuel Extraction Capital for Direct Use"/>
				<connector uid="71" angle="328.117">
					<from>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use</from>
					<to>Liquid_fuel_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use</to>
				</connector>
				<connector uid="72" angle="208.684">
					<from>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity_for_Direct_Use</from>
					<to>Liquid_fuel_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use</to>
				</connector>
				<connector uid="73" angle="0">
					<from>Insuitability_factors_for_Liquid_fuel_for_direct_use</from>
					<to>adjusted_cost_1</to>
				</connector>
				<connector uid="74" angle="149.296">
					<from>time_to_perceive_energy_supply_missmatch_1</from>
					<to>Differentiating_Relative_Energy_Supply_Missmatch_1</to>
				</connector>
			</view>
		</views>
	</model>
	<model name="Global_Investments">
		<variables>
			<aux name="World GDP">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>&quot;Real_GDP_in_2021c$&quot;[Run]*&quot;UNIT_Bc$_to_c$&quot;</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested in Renewable Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_hydropower[Run]+
share_of_GDP_invested_in_solar_and_wind[Run]+
share_of_GDP_invested_in_bio_power[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in Fossil Energy and Fuel">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_fuel_extraction[Run]+share_of_GDP_invested_in_fossil_energy[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in Energy" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_Fossil_Energy_and_Fuel[Run]+share_of_GDP_invested_in_Renewable_Energy[Run]+share_of_GDP_invested_in_nuclear_power[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin Energy without fuel" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>share_of_GDP_invested_in_Energy[Run]-share_of_GDP_invested_in_fossil_energy[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure invested in fuel extraction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital[Run]/Total_Energy_Investment_Allocated_to_Capacity_Construction</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin nuclear power">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]/Total_Energy_Investment_Allocated_to_Capacity_Construction</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin hydropower">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin solar and wind">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run]+Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity[Run])/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested in fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="share of GDP invested\nin fuel extraction" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital[Run]/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Investments Allocated to Capacity\nConstruction in Renewables" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_wind_Energy_Capacity+Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity+Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity+Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments in Fossil Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital[Run]+Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital+Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital+Gas_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Fossil\nEnergy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital+Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Energy_Capital_1+Gas_Gross_Investments_in_Fossil_Energy_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Fossil\nEnergy Capital oil and gas" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital[Run]+Gas_Gross_Investments_in_Fossil_Energy_Capital[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested\nin bio power">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity/World_GDP[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Real GDP in 2021c$" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>bc$/year</units>
			</aux>
			<aux name="UNIT Bc$ to c$" access="input">
				<eqn>1000000000</eqn>
				<units>c$/bc$</units>
			</aux>
			<aux name="Energy Investments with\nTaxes and Subsidies" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Total_Coal_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital+Coal_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Energy_Conversion_Capital+Total_Oil_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital+Oil_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Energy_Conversion_Capital+Total_Gas_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital+Gas_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Energy_Conversion_Capital+Solar_Investments_Including_Taxes_Paid_and_Subsidies_Received+Wind_Investments_Including_Taxes_Paid_and_Subsidies_Received+Total_Biofuel_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital+Hydropower_Investments_Including_Taxes_Paid_and_Subsidies_Received+Nuclear_Investments_Including_Taxes_Paid_and_Subsidies_Received</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments in Nuclear Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Hydropower Energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in Solar Energy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in wind Energy Capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nBiofuel Capacity 2" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross Investments in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Gross Investments in Fossil Fuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross Investments in Fossil Energy Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Converter_1+Coal_Investments_Allocated_to_Capacity_Construction_in_Fossil_Fuel_Extraction_Capital_for_Direct_use</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Total Energy Investment Allocated\nto Capacity Construction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_Investment_Allocated_to_Capacity_Construction+Energy_Investment_Allocated_to_Capacity_Construction_for_Coal+Energy_Investment_Allocated_to_Capacity_Construction_for_Liquid_fuel+Energy_Investment_Allocated_to_Capacity_Construction_for_Gas</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>c$/Year</units>
			</aux>
			<aux name="Nuclear Investments Including\nTaxes Paid and\nSubsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Biofuel Investments Including\nTaxes Paid and\nSubsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Hydropower Investments Including\nTaxes Paid and\nSubsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Wind Investments Including\nTaxes Paid and Subsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Solar Investments Including\nTaxes Paid and Subsidies Received" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in\nEnergy Conversion Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid and Subsidies Received in\nEnergy Conversion Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid\nand Subsidies Received in Fossil\nFuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Including Taxes Paid and Subsidies Received in Energy Conversion Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid\nand Subsidies Received in Fossil\nFuel Extraction Capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Biofuel Investments Including\nTaxes Paid and\nSubsidies Received 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Total Coal Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Coal_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital_1+Coal_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Total Oil Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital_1+Oil_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Total Gas Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital_for_Direct_Use+Gas_Investments_Including_Taxes_Paid_and_Subsidies_Received_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital for Direct Use" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Total Biofuel Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Biofuel_Investments_Including_Taxes_Paid_and_Subsidies_Received+Biofuel_Investments_Including_Taxes_Paid_and_Subsidies_Received_1</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in Fossil\nFuel Extraction\nCapital for Direct use" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Allocated to Capacity Construction in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital+Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Gross\nInvestments in Fossil\nFuel Extraction Capital for Electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Coal Investments Allocated to Capacity Construction in\nFossil Energy Capital 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Gross\nInvestments in Fossil\nFuel Extraction Capital for Electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Allocated to Capacity Construction in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity+Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital</eqn>
				<units>c$/Year</units>
