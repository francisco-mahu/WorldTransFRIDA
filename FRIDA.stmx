	<model name="Global_energy_investments">
		<variables>
			<aux name="Converter 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<units>bc$/year</units>
			</aux>
			<aux name="Total Gross Investments in Energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital + Gross_Investments_in_Fossil_Fuel_Extraction_Capital + Gross_Investments_in_Renewables+Investments_in_Nuclear_Capacity_1</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="World GDP">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Converter_1*&quot;UNIT_Bc$_to_c$&quot;</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Fossil\nEnergy Capital oil and gas" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital_oil_and_gas_2+Gross_Investments_in_Fossil_Energy_Capital_6+Gross_Investments_in_Fossil_Energy_Capital_7</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Fossil\nFuel Extraction Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital_5+Gross_Investments_in_Fossil_Fuel_Extraction_Capital_6+Gross_Investments_in_Fossil_Fuel_Extraction_Capital_7+Gross_Investments_in_Fossil_Fuel_Extraction_Capital_8</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Fossil\nEnergy Capital" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital_5+Gross_Investments_in_Fossil_Energy_Capital_6+Gross_Investments_in_Fossil_Energy_Capital_7+Gross_Investments_in_Fossil_Energy_Capital_8</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gross Investments in Renewables" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Renewables_2</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested\nin fuel extraction" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Baseline of investments" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>857228043839.82{ + RAMP(2.5e10)</eqn>
				<range min="857220000000" max="857230000000"/>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested\nin fossil energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Energy_Capital/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of GDP invested in energy">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Total_Gross_Investments_in_Energy/World_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Gas Gross Investments in Fossil Fuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital_7+Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_2</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="share of GDP invested\nin Energy without fuel" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Share_of_GDP_invested_in_energy-share_of_GDP_invested_in_fossil_energy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Oil Gross Investments in Fossil Fuel Extraction Capital">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gross_Investments_in_Fossil_Fuel_Extraction_Capital_6+Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_2</eqn>
