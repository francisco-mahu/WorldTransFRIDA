				<text_box uid="1" x="290.583" y="1468.01" width="260" height="58">This is a PID controler
https://en.wikipedia.org/wiki/Proportional%E2%80%93integral%E2%80%93derivative_controller</text_box>
				<text_box uid="2" x="319.661" y="1363.19" width="145.928" height="16.875">differentiating control, smoothes </text_box>
				<text_box uid="3" x="290.583" y="1425.81" width="260" height="29.6667">PID factors. Negative values dampen deviations, positive values amplify</text_box>
				<text_box uid="4" x="589.87" y="1363.13" width="145.928" height="58.6666">integrating control, responds to continuing deviations</text_box>
				<text_box uid="5" x="127.69" y="1356.26" width="131.667" height="15">Proportional control</text_box>
				<flow x="632.655" y="1239.53" name="Acc Cum Rel En Sup Missmatch">
