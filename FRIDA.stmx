	<model name="Damages_for_energy" run="true">
		<variables>
			<aux name="damage rate of energy\ncapital from STA" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF (switch_energy_damage = 0) AND TIME &gt; today THEN
PREVIOUS(SELF, 0)
ELSE
(Slope_of_Capital_Damage_Function*(Surface_Temperature_Anomaly_1*UNIT_deg_C_to_dmnl)^Exponent_of_Capital_Damage_Function)</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Slope of Capital Damage Function">
				<doc>${Climate Impact Parameter,Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.00005096093</eqn>
				</element>
				<range min="0" max="8"/>
				<units>1/year</units>
			</aux>
			<aux name="Exponent of Capital Damage Function">
				<doc>${Climate Impact Parameter,Internal Calibration Parameter}
absolute guess</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>2</eqn>
				</element>
				<range min="1" max="3"/>
				<units>dmnl</units>
			</aux>
			<aux name="today" access="input">
				<eqn>2025</eqn>
				<units>year</units>
			</aux>
			<aux name="switch energy damage" access="input">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Surface Temperature Anomaly 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>deg C</units>
			</aux>
			<aux name="UNIT deg C to dmnl" access="input">
				<eqn>1</eqn>
				<units>1/(deg C)</units>
			</aux>
		</variables>
		<views>
