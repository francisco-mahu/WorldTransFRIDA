				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="cost to build\nper unit 1">
				<dimensions>
					<dim name="Run"/>
					<dim name="EnergySource"/>
				</dimensions>
				<eqn>IF EnergySource = EnergySource.Coal_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_3[Run]
ELSE IF EnergySource = EnergySource.Coal_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_10[Run]
ELSE IF EnergySource = EnergySource.Oil_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_5[Run]
ELSE IF EnergySource = EnergySource.Oil_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_12[Run]
ELSE IF EnergySource = EnergySource.Gas_fuel_extraction THEN cost_of_extra_energy_output_through_fuel_extraction_per_unit_4[Run]
ELSE IF EnergySource = EnergySource.Gas_energy_conversion THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_11[Run]
ELSE IF EnergySource = EnergySource.Solar THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_16[Run]
ELSE IF EnergySource = EnergySource.Wind THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_17[Run]
ELSE IF EnergySource = EnergySource.Hydropower THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_13[Run] 
ELSE IF EnergySource = EnergySource.Nuclear THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_14[Run]
ELSE IF EnergySource = EnergySource.Bio THEN Cost_of_Extra_Energy_Output_through_Capital_per_Unit_15[Run]
ELSE NAN</eqn>
				<units>c$*Years/kWh</units>
			</aux>
