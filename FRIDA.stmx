	</model>
	<model name="Effect_of_energy_prices_on_Industry_and_Other_demand">
		<variables>
			<aux name="effect\nof energy prices on\nIndustry and Other demand" access="output">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(Industry_and_Other_specific_relative_energy_changes-1)-1)*sensitivity_of_effect_of_energy_prices_on_energy_demand_of_Industry_and_Other*Switch_to_energy_prices</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect\nof energy prices on\nenergy demand of Industry and Other">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.124405662201714</eqn>
				<range min="0.001" max="0.2"/>
				<units>dmnl</units>
			</aux>
			<aux name="relative change\nin energy prices\nin electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative change in\nenergy prices Solid" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative change in\nenergy prices for Liquid Fuel" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative change in\nenergy prices for Fossil Gas" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for fossil coal" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for liquid fuel" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for fossil gas" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Share of Industry and Other\nenergy demand for electricity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Industry and Other specific relative energy changes">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(relative_change_in_energy_prices_Solid*Share_of_Industry_and_Other_energy_demand_for_fossil_coal+relative_change_in_energy_prices_for_Liquid_Fuel*Share_of_Industry_and_Other_energy_demand_for_liquid_fuel+relative_change_in_energy_prices_for_Fossil_Gas*Share_of_Industry_and_Other_energy_demand_for_fossil_gas+relative_change_in_energy_prices_in_electricity*Share_of_Industry_and_Other_energy_demand_for_electricity,Time_for_delay, initial_relative_energy_change)</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="Time for delay">
				<eqn>1</eqn>
				<units>Year</units>
			</aux>
			<aux name="initial relative energy change">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Switch to energy prices" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
		</variables>
