				<aux color="black" font_color="black" x="1743.67" y="812.767" name="zJ to TWh"/>
				<text_box uid="20" x="538.82" y="866.767" width="260" height="41.125">Fossil Fuel Extraction Productivity is the inverse of the price of fossil fuel extraction</text_box>
