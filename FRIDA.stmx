	<model name="Energy_Units_1">
		<variables>
			<aux name="UNIT zJ to TWh" access="output">
				<doc>${Assumption,Unit}
</doc>
				<eqn>277777.7778</eqn>
				<units>TWh/zJ</units>
			</aux>
			<aux name="UNIT Qbtu to zJ" access="output">
				<doc>${Unit}
btu: British Thermal Unit 
https://en.wikipedia.org/wiki/British_thermal_unit</doc>
				<eqn>0.001055056</eqn>
				<units>zJ/Qbtu</units>
			</aux>
			<aux name="UNIT TWh to kWh" access="output">
				<doc>${Unit}
</doc>
				<eqn>1000000000</eqn>
				<units>kWh/TWh</units>
			</aux>
			<aux name="UNIT kW to TW" access="output">
				<doc>${Unit}
</doc>
				<eqn>1e-9</eqn>
				<units>TW/kW</units>
			</aux>
			<aux name="UNIT GW to TW" access="output">
				<doc>${Unit}
</doc>
				<eqn>0.001</eqn>
				<units>TW/GW</units>
			</aux>
			<aux name="UNIT gWh to TWh" access="output">
				<doc>${Unit}
</doc>
				<eqn>0.001</eqn>
				<units>TWh/(gW*hours)</units>
			</aux>
			<aux name="UNIT Bc$ to c$" access="output" isee:autocreated="true">
				<doc>${Unit}
</doc>
				<eqn>1000000000</eqn>
				<units>c$/bc$</units>
			</aux>
			<aux name="UNIT GJ to MWh" access="output" isee:autocreated="true">
				<doc>${Unit}
</doc>
				<eqn>0.277778</eqn>
				<units>MWh/GJ</units>
			</aux>
			<aux name="UNIT kW to GW" access="output" isee:autocreated="true">
				<doc>${Assumption,Unit}
</doc>
				<eqn>0.000001</eqn>
				<units>GW/kW</units>
			</aux>
			<aux name="UNIT deg C to dmnl" access="output" isee:autocreated="true">
				<doc>${Unit}
</doc>
				<eqn>1</eqn>
				<units>1/(deg C)</units>
			</aux>
			<aux name="UNIT MWh to TWh" access="output">
				<eqn>0.000001</eqn>
				<units>TWh/(MW*hours)</units>
			</aux>
		</variables>
