				<aux color="blue" background="#55AA00" x="337.857" y="1578.11" name="adaptive energy\ninvestments proportional factor"/>
				<aux x="987.674" y="851.59" name="All Gross Energy Investments"/>
				<aux x="344.29" y="1371.56" name="Relative Energy Supply Missmatch"/>
				<aux color="blue" background="#55AA00" x="798.291" y="1585.2" name="adaptive energy\ninvestments integrating factor"/>
				<aux color="blue" background="#55AA00" x="533.916" y="1578.95" name="adaptive energy\ninvestments differntiating factor"/>
				<aux x="539.941" y="1509.87" name="Differentiating Relative Energy Supply Missmatch"/>
				<text_box uid="1" x="431.874" y="1742.68" width="260" height="58">This is a PID controler
https://en.wikipedia.org/wiki/Proportional%E2%80%93integral%E2%80%93derivative_controller</text_box>
				<text_box uid="2" x="431.874" y="1700.48" width="260" height="29.6667">PID factors. Negative values dampen deviations, positive values amplify</text_box>
				<text_box uid="3" x="268.981" y="1630.93" width="131.667" height="15">Proportional control</text_box>
				<text_box uid="4" x="460.952" y="1637.86" width="145.928" height="16.875">differentiating control, smoothes </text_box>
				<text_box uid="5" x="731.161" y="1637.8" width="145.928" height="58.6666">integrating control, responds to continuing deviations</text_box>
				<aux x="1219.86" y="617.28" name="Share of Gross Energy Expenditure\ninvested in fuel\nextraction, coal"/>
