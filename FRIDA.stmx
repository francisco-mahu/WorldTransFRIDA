				<connect2 to="effect_of_GDP_on_energy_demand_for_Industry_and_Other_alpha" from="Industry_and_Other_energy_demand_1.effect_of_GDP_on_energy_demand_for_Industry_and_Other_alpha"/>
				<connect to="Energy_demand_1.effect_of_GDP_on_energy_demand_for_Industry_and_Other_beta" from="Industry_and_Other_energy_demand_1.effect_of_GDP_on_energy_demand_for_Industry_and_Other_beta"/>
