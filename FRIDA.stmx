	<model name="Gas_supply_vs_demand" run="true">
		<variables>
			<aux name="Energy Balance" access="output">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Primary_Fossil_Energy_FUEL_1/(Gas_demand_FUEL)</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Cumulative Deviations of Energy Balance from 1">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Deviations_from_one_in_Energy_Balance</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="Deviations from one in Energy Balance">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>((1-Energy_Balance)^2)/DT</eqn>
				<non_negative/>
				<units>dmnl/year</units>
			</flow>
			<stock name="Cumulative Energy Supply Missmatch">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Energy_Supply_Missmatch</inflow>
				<units>TWh</units>
			</stock>
			<flow name="Energy Supply\nMissmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Primary_Fossil_Energy_FUEL_1-(Gas_demand_FUEL))*UNIT_zJ_to_TWh</eqn>
				<units>TWh/Year</units>
			</flow>
			<aux name="Relative Energy\nSupply Missmatch" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Energy_Supply_Missmatch/UNIT_zJ_to_TWh)/Primary_Fossil_Energy_FUEL_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="UNIT zJ to TWh" access="input">
				<eqn>277777.7778</eqn>
				<units>TWh/zJ</units>
			</aux>
			<aux name="Primary Fossil Energy\nFUEL 1" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
			<aux name="Gas demand FUEL" access="output" throughput="true" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>zJ/Year</units>
			</aux>
		</variables>
