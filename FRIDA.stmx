			<aux name="Oil Investments Including Taxes Paid and Subsidies Received in\nEnergy Conversion Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Energy_Capital[Run] +
tax_revenue_on_investments_in_oil_energy_conversion[Run] -
expenditure_on_subsidies_for_investments_in_oil_energy_conversion[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Oil Investments Including Taxes Paid\nand Subsidies Received in Fossil\nFuel Extraction Capital for Electricity" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Oil_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run] +
tax_revenue_on_investments_in_oil_extraction[Run] -
expenditure_on_subsidies_for_investments_in_oil_extraction[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in\nEnergy Conversion Capital" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Energy_Capital[Run] +
tax_revenue_on_investments_in_gas_energy_conversion_1[Run] -
expenditure_on_subsidies_for_investments_in_gas_energy_conversion[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Gas Investments Including Taxes Paid and Subsidies Received in Fossil\nFuel Extraction Capital for Electricity" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Gas_Gross_Investments_in_Fossil_Fuel_Extraction_Capital_for_Electricity[Run] +
tax_revenue_on_investments_in_gas_extraction[Run] -
expenditure_on_subsidies_for_investments_in_gas_extraction[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Hydropower Investments Including\nTaxes Paid and\nSubsidies Received" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Hydropower_Energy_capacity[Run] +
tax_revenue_on_investments_in_hydropower_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_hydropower_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Biofuel Investments Including\nTaxes Paid and\nSubsidies Received for Electricity" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Biofuel_Capacity[Run] +
tax_revenue_on_investments_in_bio_fuel_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_bio_fuel_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Nuclear Investments Including\nTaxes Paid and\nSubsidies Received" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_in_Nuclear_Capacity[Run] +
tax_revenue_on_investments_in_nuclear_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_nuclear_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="time to perceive energy supply missmatch">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.25" max="5"/>
				<units>year</units>
			</aux>
			<aux name="perceived energy supply\nmargins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(average_energy_margins_of_Electricity[Run], cost_perception_time[Run], initial_perceived_marginal_energy_supply_cost[Run])</eqn>
				<isee:delay_aux/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="cost perception time">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<range min="0.5" max="2"/>
				<units>year</units>
			</aux>
			<aux name="effect of margins on\ninvestment">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+(EXP(relative_margins[Run]-1) - 1)*sensitivity_of_effect_of_perceived_marginal_energy_supply_cost_on_investment[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of effect of perceived marginal\nenergy supply cost\non investment">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.158464377889841</eqn>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="average energy margins of Electricity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1</eqn>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="relative margins">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_energy_supply_margins[Run]/initial_perceived_marginal_energy_supply_cost[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="initial perceived marginal energy supply cost">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.013519257868552</eqn>
				<range min="0.001" max="0.05"/>
				<units>c$/(kWh/Years)</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nSolar\nEnergy Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>investment_by_source[Run,Solar]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Share of Energy Gross Expenditure\ninvested in Solar">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run]/Energy_Investment_Allocated_to_Capacity_Construction[Run]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="expenditure on subsidies for investments in\nSolar\nenergy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="tax revenue on investments in\nSolar energy capacity" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Solar Investments Including\nTaxes Paid and Subsidies Received" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Investments_Allocated_to_Capacity_Construction_in_Solar_Energy_Capacity[Run] +  tax_revenue_on_investments_in_Solar_energy_capacity[Run] -
expenditure_on_subsidies_for_investments_in_Solar_energy_capacity[Run]</eqn>
				<units>c$/Year</units>
			</aux>
			<aux name="Investments Allocated to Capacity Construction in\nwind\nEnergy Capacity" access="output" isee:autocreated="true">
				<doc>${Calibrated Output}
</doc>
				<dimensions>
